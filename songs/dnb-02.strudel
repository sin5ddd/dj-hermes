// @title dnb-02
// @genre drum and bass
// @details darker amen (kit lpf 2500, mid 800) @ 174
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dk*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(2500)
// sub
$: note("0 3 0 <0 -1>").scale("C2:minor").s("square").lpf(120).gain(0.42)
  .attack(0.01).decay(0.5).release(0.4)
// mid
$: note("0 3 0 <0 -1>").scale("C2:minor").s("sawtooth").lpf(800).gain(0.36)
  .attack(0.01).decay(0.4).release(0.3)
