// @title brass-bells
// @by strudel-rs
// @details agogo stall bells, tine EP, kalimba @ 96
setcpm(96/4)
// drums
$: s("bd:cn ~ ~ ~, perc:ah ~ perc:al perc:ah, perc:cw ~ perc:sk ~").gain(0.38)
// bass
$: note("0 ~ ~ 4").scale("C4:dorian").s("bs:ht").gain(0.3)
// keys
$: note("0 ~ 4 ~").scale("C4:dorian").s("ep:tb").gain(0.18).cut(1)
  .room(0.28).orbit(1)
// lead
$: note("~ 6 4 2  ~ 0 <2 4> ~").scale("C4:dorian").s("plk:kl").gain(0.2).cut(1)
