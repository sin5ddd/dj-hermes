// @title chill-pop-05
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd]*2, hh*8, <~ ~ ~ [bd sd bd sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Bb2:lydian A2:phrygian G2:dorian F2:major>")
  .s("sine").lpf(250).gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Bb4:lydian A4:phrygian G4:dorian F4:major>")
  .s("plk:ps").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Bb4:lydian A4:phrygian G4:dorian F4:major>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<Bb5:lydian A5:phrygian G5:dorian F5:major>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<Bb3:lydian A3:phrygian G3:dorian F3:major>")
  .s("triangle").lpf(1400).gain(0.24).room(0.25).orbit(2)
// pad
$: note("[0,4]").scale("<Bb3:lydian A3:phrygian G3:dorian F3:major>")
  .s("sawtooth").lpf(1100).gain(0.14)
  .attack(0.08).release(0.3)
