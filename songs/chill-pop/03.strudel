// @title chill-pop-03
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:pp]*2, hh*8, <~ ~ ~ [bd sd:pp bd sd:pp]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Ab4:lydian G4:phrygian F4:dorian Eb4:major>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Ab4:lydian G4:phrygian F4:dorian Eb4:major>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Ab4:lydian G4:phrygian F4:dorian Eb4:major>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<Ab5:lydian G5:phrygian F5:dorian Eb5:major>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<Ab4:lydian G4:phrygian F4:dorian Eb4:major>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<Ab2:lydian G2:phrygian F2:dorian Eb2:major>")
  .s("pf:cl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<Ab4:lydian G4:phrygian F4:dorian Eb4:major>")
  .s("vc:ya").gain(0.12).cut(1)
