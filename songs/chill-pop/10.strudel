// @title chill-pop-10
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd:dc sd:br bd:dc sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<E5:lydian Eb5:phrygian C#5:dorian B4:major>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<E5:lydian Eb5:phrygian C#5:dorian B4:major>")
  .s("ld:ny").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<E5:lydian Eb5:phrygian C#5:dorian B4:major>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<E6:lydian Eb6:phrygian C#6:dorian B5:major>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<E5:lydian Eb5:phrygian C#5:dorian B4:major>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<E5:lydian Eb5:phrygian C#5:dorian B4:major>")
  .s("pf:ff").gain(0.14).room(0.3).orbit(2)
