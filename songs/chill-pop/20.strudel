// @title chill-pop-20
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd:dc sd:br bd:dc sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<B4:major Ab5:mixolydian C#5:mixolydian F#5:mixolydian>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<B4:major Ab5:mixolydian C#5:mixolydian F#5:mixolydian>")
  .s("plk:gm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<B4:major Ab5:mixolydian C#5:mixolydian F#5:mixolydian>")
  .s("ep:rh").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<B5:major Ab6:mixolydian C#6:mixolydian F#6:mixolydian>")
  .s("plk:kt").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<B4:major Ab5:mixolydian C#5:mixolydian F#5:mixolydian>")
  .s("plk:ep").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<B2:major Ab3:mixolydian C#3:mixolydian F#3:mixolydian>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<B4:major Ab5:mixolydian C#5:mixolydian F#5:mixolydian>")
  .s("vc:pa").gain(0.12).cut(1)
