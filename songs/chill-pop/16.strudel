// @title chill-pop-16
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:dc sd bd:dc sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<G4:major E5:mixolydian A4:mixolydian D5:mixolydian>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<G4:major E5:mixolydian A4:mixolydian D5:mixolydian>")
  .s("ld:ny").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<G4:major E5:mixolydian A4:mixolydian D5:mixolydian>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<G5:major E6:mixolydian A5:mixolydian D6:mixolydian>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<G4:major E5:mixolydian A4:mixolydian D5:mixolydian>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<G2:major E3:mixolydian A2:mixolydian D3:mixolydian>")
  .s("pf:iv").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<G4:major E5:mixolydian A4:mixolydian D5:mixolydian>")
  .s("vc:na").gain(0.12).cut(1)
