// @title chill-pop-28
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:pp]*2, hh*8, <~ ~ ~ [bd sd:pp bd sd:pp]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<B4:dorian E5:mixolydian A4:major F#5:minor>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<B4:dorian E5:mixolydian A4:major F#5:minor>")
  .s("ld:ny").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<B4:dorian E5:mixolydian A4:major F#5:minor>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<B5:dorian E6:mixolydian A5:major F#6:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<B4:dorian E5:mixolydian A4:major F#5:minor>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<B4:dorian E5:mixolydian A4:major F#5:minor>")
  .s("pf:cl").cut(1).gain(0.14).room(0.3).orbit(2)
