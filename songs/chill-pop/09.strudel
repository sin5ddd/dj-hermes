// @title chill-pop-09
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd sd:br bd sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Eb5:lydian D5:phrygian C5:dorian Bb4:major>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Eb5:lydian D5:phrygian C5:dorian Bb4:major>")
  .s("plk:ps").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Eb5:lydian D5:phrygian C5:dorian Bb4:major>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<Eb6:lydian D6:phrygian C6:dorian Bb5:major>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<Eb5:lydian D5:phrygian C5:dorian Bb4:major>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb5:lydian D5:phrygian C5:dorian Bb4:major>")
  .s("pf:wa").cut(1).gain(0.14).room(0.3).orbit(2)
