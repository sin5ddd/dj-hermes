// @title chill-pop-30
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd:dc sd:br bd:dc sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<C#6:dorian F#6:mixolydian B5:major Ab6:minor>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<C#3:dorian F#3:mixolydian B2:major Ab3:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("vc:ya").gain(0.12).cut(1)
