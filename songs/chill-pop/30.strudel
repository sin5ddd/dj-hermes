// @title chill-pop-30
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd]*2, hh*8, <~ ~ ~ [bd sd bd sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<C#3:dorian F#3:mixolydian B2:major Ab3:minor>")
  .s("sine").lpf(250).gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("plk:ps").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<C#5:dorian F#5:mixolydian B4:major Ab5:minor>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<C#6:dorian F#6:mixolydian B5:major Ab6:minor>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<C#4:dorian F#4:mixolydian B3:major Ab4:minor>")
  .s("triangle").lpf(1400).gain(0.24).room(0.25).orbit(2)
// pad
$: note("[0,4]").scale("<C#4:dorian F#4:mixolydian B3:major Ab4:minor>")
  .s("sawtooth").lpf(1100).gain(0.14)
  .attack(0.08).release(0.3)
