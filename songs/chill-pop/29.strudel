// @title chill-pop-29
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd sd:br bd sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("plk:gm").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("ep:rh").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<C6:dorian F6:mixolydian Bb5:major G6:minor>")
  .s("plk:kt").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("plk:ep").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("pf:wa").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<C5:dorian F5:mixolydian Bb4:major G5:minor>")
  .s("vc:pa").gain(0.12).cut(1)
