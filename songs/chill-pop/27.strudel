// @title chill-pop-27
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:lf ~ bd:lf ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:lf sd bd:lf sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("plk:ps").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<Bb5:dorian Eb6:mixolydian Ab5:major F6:minor>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("pf:ln").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<Bb4:dorian Eb5:mixolydian Ab4:major F5:minor>")
  .s("vc:ya").gain(0.12).cut(1)
