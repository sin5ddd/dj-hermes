// @title chill-pop-18
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:pp]*2, hh*8, <~ ~ ~ [bd sd:pp bd sd:pp]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<A4:major F#5:mixolydian B4:mixolydian E5:mixolydian>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<A4:major F#5:mixolydian B4:mixolydian E5:mixolydian>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<A4:major F#5:mixolydian B4:mixolydian E5:mixolydian>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<A5:major F#6:mixolydian B5:mixolydian E6:mixolydian>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<A4:major F#5:mixolydian B4:mixolydian E5:mixolydian>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<A2:major F#3:mixolydian B2:mixolydian E3:mixolydian>")
  .s("pf:cl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<A4:major F#5:mixolydian B4:mixolydian E5:mixolydian>")
  .s("vc:ya").gain(0.12).cut(1)
