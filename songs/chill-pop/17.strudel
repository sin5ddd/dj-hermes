// @title chill-pop-17
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:lf ~ bd:lf ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:lf sd bd:lf sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Ab4:major F5:mixolydian Bb4:mixolydian Eb5:mixolydian>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Ab4:major F5:mixolydian Bb4:mixolydian Eb5:mixolydian>")
  .s("plk:gm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Ab4:major F5:mixolydian Bb4:mixolydian Eb5:mixolydian>")
  .s("ep:rh").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<Ab5:major F6:mixolydian Bb5:mixolydian Eb6:mixolydian>")
  .s("plk:kt").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<Ab4:major F5:mixolydian Bb4:mixolydian Eb5:mixolydian>")
  .s("plk:ep").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<Ab2:major F3:mixolydian Bb2:mixolydian Eb3:mixolydian>")
  .s("pf:ln").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<Ab4:major F5:mixolydian Bb4:mixolydian Eb5:mixolydian>")
  .s("vc:pa").gain(0.12).cut(1)
