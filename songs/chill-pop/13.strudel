// @title chill-pop-13
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:pp]*2, hh*8, <~ ~ ~ [bd sd:pp bd sd:pp]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<Eb4:major C5:mixolydian F4:mixolydian Bb4:mixolydian>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<Eb4:major C5:mixolydian F4:mixolydian Bb4:mixolydian>")
  .s("ld:ny").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<Eb4:major C5:mixolydian F4:mixolydian Bb4:mixolydian>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<Eb5:major C6:mixolydian F5:mixolydian Bb5:mixolydian>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<Eb4:major C5:mixolydian F4:mixolydian Bb4:mixolydian>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<Eb2:major C3:mixolydian F2:mixolydian Bb2:mixolydian>")
  .s("pf:cl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<Eb4:major C5:mixolydian F4:mixolydian Bb4:mixolydian>")
  .s("vc:na").gain(0.12).cut(1)
