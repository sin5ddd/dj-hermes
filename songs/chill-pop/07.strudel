// @title chill-pop-07
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:lf ~ bd:lf ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:lf sd bd:lf sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<C#5:lydian C5:phrygian Bb4:dorian Ab4:major>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<C#5:lydian C5:phrygian Bb4:dorian Ab4:major>")
  .s("ld:ny").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<C#5:lydian C5:phrygian Bb4:dorian Ab4:major>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<C#6:lydian C6:phrygian Bb5:dorian Ab5:major>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<C#5:lydian C5:phrygian Bb4:dorian Ab4:major>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<C#3:lydian C3:phrygian Bb2:dorian Ab2:major>")
  .s("pf:ln").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<C#5:lydian C5:phrygian Bb4:dorian Ab4:major>")
  .s("vc:na").gain(0.12).cut(1)
