// @title chill-pop-21
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:dc sd bd:dc sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<D4:dorian G4:mixolydian C4:major A4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<D4:dorian G4:mixolydian C4:major A4:minor>")
  .s("plk:ps").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<D4:dorian G4:mixolydian C4:major A4:minor>")
  .s("ep:rs").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<D5:dorian G5:mixolydian C5:major A5:minor>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<D4:dorian G4:mixolydian C4:major A4:minor>")
  .s("ep:mt").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<D4:dorian G4:mixolydian C4:major A4:minor>")
  .s("pf:iv").cut(1).gain(0.14).room(0.3).orbit(2)
