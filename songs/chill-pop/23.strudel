// @title chill-pop-23
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:pp]*2, hh*8, <~ ~ ~ [bd sd:pp bd sd:pp]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<F4:dorian Bb4:mixolydian Eb4:major C5:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<F4:dorian Bb4:mixolydian Eb4:major C5:minor>")
  .s("plk:gm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<F4:dorian Bb4:mixolydian Eb4:major C5:minor>")
  .s("ep:rh").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<F5:dorian Bb5:mixolydian Eb5:major C6:minor>")
  .s("plk:kt").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<F4:dorian Bb4:mixolydian Eb4:major C5:minor>")
  .s("plk:ep").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<F2:dorian Bb2:mixolydian Eb2:major C3:minor>")
  .s("pf:cl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<F4:dorian Bb4:mixolydian Eb4:major C5:minor>")
  .s("vc:pa").gain(0.12).cut(1)
