// @title chill-pop-11
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd:dc ~ bd:dc ~, [~ sd]*2, hh*8, <~ ~ ~ [bd:dc sd bd:dc sd]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<C4:major A4:mixolydian D4:mixolydian G4:mixolydian>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<C4:major A4:mixolydian D4:mixolydian G4:mixolydian>")
  .s("plk:gm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<C4:major A4:mixolydian D4:mixolydian G4:mixolydian>")
  .s("ep:rh").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 4").scale("<C5:major A5:mixolydian D5:mixolydian G5:mixolydian>")
  .s("plk:kt").gain(0.12).cut(1)
// chords
$: note("[0,2,6]@2 [0,2,6]@2").scale("<C4:major A4:mixolydian D4:mixolydian G4:mixolydian>")
  .s("plk:ep").gain(0.24).room(0.25).orbit(2)
// pad
$: note("0").scale("<C2:major A2:mixolydian D2:mixolydian G2:mixolydian>")
  .s("pf:iv").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<C4:major A4:mixolydian D4:mixolydian G4:mixolydian>")
  .s("vc:pa").gain(0.12).cut(1)
