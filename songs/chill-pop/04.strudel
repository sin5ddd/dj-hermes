// @title chill-pop-04
// @genre chill-pop
setcpm(100/4)
// drums
$: s("bd ~ bd ~, [~ sd:br]*2, hh*8, <~ ~ ~ [bd sd:br bd sd:br]>").gain(0.5)
// bass
$: note("0 ~ 4 0  0 ~ <4 7 2 0>").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("bs:su").gain(0.42)
// lead
$: note("~ 2 4 6  4 2 ~ <0 2 4 6>").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("ld:ny").gain(0.16).cut(1)
// hook
$: note("0 ~ 2 6  ~ 4 2 <6 4 2 0>").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("ep:wr").gain(0.22)
// arp
$: note("0 2 4 6  4 2 0 ~").scale("<A5:lydian Ab5:phrygian F#5:dorian E5:major>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,6] ~ [0,2,6] ~").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("ep:ky").gain(0.24).room(0.25).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("pf:wa").cut(1).gain(0.14).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ ~ ~ ~").scale("<A4:lydian Ab4:phrygian F#4:dorian E4:major>")
  .s("vc:na").gain(0.12).cut(1)
