// @title chill-pop-04
// @genre chill-pop
// @details sparse 808 + sine sub + high major hook
setcpm(100/4)
// drums
$: s("bd:8t ~ ~ ~, [~ sd]*2, [~ hh]*4").gain(0.45)
// bass
$: note("0 ~ ~ 0").scale("C4:major").s("bs:su").gain(0.4)
// lead
$: note("4 7 9 4").scale("C4:major").s("square").lpf(2400).gain(0.18)
