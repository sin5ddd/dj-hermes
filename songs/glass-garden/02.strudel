// @title dew-chime
// @by strudel-rs
// @details sparse metal ping, chime pluck, fifth pad @ 96
setcpm(96/4)
// drums
$: s("bd:mt ~ ~ ~, perc:cm ~ perc:cm perc:tg, ~ ~ perc:tm ~").gain(0.34)
// bass
$: note("0 ~ ~ ~").scale("C4:lydian").s("bs:ss").gain(0.26)
// pad
$: note("0 ~ ~ ~").scale("C4:lydian").s("pf:ff").gain(0.2).cut(1)
  .attack(0.25).decay(0.3).sustain(0.7).release(0.55).room(0.42).orbit(1)
// lead
$: note("~ 4 ~ 3  ~ 7 <4 6> ~").scale("C4:lydian").s("plk:ch").gain(0.16).cut(1)
