// @title hail-tick
// @by strudel-rs
// @details metal ticks, triangle hail, crystal @ 96
setcpm(96/4)
// drums
$: s("bd:mt ~ ~ ~, perc:tm*8, perc:tg ~ perc:gs ~").gain(0.34)
// bass
$: note("0 ~ ~ ~").scale("C4:lydian").s("bs:ss").gain(0.26)
// pad
$: note("0 ~ ~ ~").scale("C4:lydian").s("pf:ff").gain(0.18).cut(1)
  .attack(0.15).decay(0.3).sustain(0.65).release(0.45).room(0.36).orbit(1)
// lead
$: note("3 4 6 4  ~ 3 <7 4> ~").scale("C4:lydian").s("plk:fc").gain(0.16).cut(1)
// fx
$: s("<~ ~ ~ fx:wp>").gain(0.18)
