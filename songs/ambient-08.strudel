// @title ambient-08
// @genre ambient
// @details tight 808 kick + amen sub + sine air
setcpm(70/4)
// drums
$: s("bd:8t ~ ~ ~, ~ hh ~ ~").gain(0.2)
// bass
$: note("0 2 ~ 0").scale("C4:minor").s("bs:am").gain(0.3)
// lead
$: note("2 0 ~ 5").scale("C4:minor").s("sine").lpf(1400).gain(0.12)
  .attack(0.2).release(0.5).delay(0.3).orbit(2)
