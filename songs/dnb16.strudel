// @title dnb16
// @genre drum and bass
// @details 16-bar loop @ 174 BPM
// cat() = one cycle (bar) per arg — same as mini "<a b c>"
setcpm(174/4)

// kick — Amen-ish A / A' / break / rebuild
$: s(cat(
  cat(
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ ~ bd ~ bd ~ ~",
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ bd ~ ~ ~ bd ~"
  ),
  cat(
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ ~ bd ~ bd ~ ~",
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ bd ~ ~ bd ~ ~"
  ),
  "bd ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ bd ~ ~ bd ~",
  cat(
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ ~ bd ~ bd ~ ~",
    "bd ~ ~ bd ~ ~ bd ~", "bd ~ bd ~ ~ ~ bd ~",
    "bd ~ ~ bd ~ ~ bd ~", "bd bd ~ bd ~ bd ~ bd"
  )
)).gain(0.88)

// snare — 2-step backbeat, fills, break
$: s(cat(
  cat(
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ sd sd ~]"
  ),
  cat(
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ sd ~ sd sd]"
  ),
  "[~ ~ ~ ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ ~ ~ ~]",
  cat(
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ ~ sd ~]", "[~ ~ sd ~ ~ sd sd ~]",
    "[~ ~ sd ~ ~ ~ sd ~]", "[sd ~ sd sd ~ sd sd ~]"
  )
)).gain(0.82)

// hat — full 16ths, half-time break
$: s(cat(
  cat("hh*16", "hh*16", "hh*16", "hh*16", "hh*16", "hh*16", "hh*16", "hh*16"),
  "hh*8", "hh*8",
  cat("hh*16", "hh*16", "hh*16", "hh*16", "hh*16", "hh*16")
)).gain(0.24)

// openhat — syncopated, silent break, end roll
$: s(cat(
  cat(
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ oh ~ ~ ~]"
  ),
  cat(
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ oh ~ oh ~]"
  ),
  "~", "[~ ~ ~ ~ ~ oh ~ ~]",
  cat(
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ ~ ~ ~ oh ~ ~ ~]",
    "[~ ~ ~ ~ ~ oh ~ ~]", "[~ oh ~ oh ~ oh ~ oh]"
  )
)).gain(0.32)

// reese — A minor, break, return
$: note(cat(
  cat(
    "a1 a1 a1 a1", "a1 a1 c2 a1", "a1 a1 a1 a1", "g1 g1 a1 a1",
    "a1 a1 a1 a1", "a1 a1 c2 d2", "a1 a1 a1 a1", "g1 g1 e1 g1"
  ),
  "a1 ~ ~ ~", "~ ~ ~ a1",
  cat(
    "a1 a1 a1 a1", "a1 a1 c2 a1", "a1 a1 a1 a1",
    "g1 g1 a1 a1", "a1 a1 c2 d2", "a1 g1 e1 a1"
  )
))
.s("sawtooth").lpf(280).gain(0.52).attack(0.02).decay(0.18).sustain(0.55).release(0.12)

// sub — root pulses under reese
$: note(cat(
  cat(
    "a1 ~ a1 ~", "a1 ~ a1 ~", "a1 ~ a1 ~", "g1 ~ a1 ~",
    "a1 ~ a1 ~", "a1 ~ a1 ~", "a1 ~ a1 ~", "g1 ~ e1 ~"
  ),
  "a1 ~ ~ ~", "~",
  cat(
    "a1 ~ a1 ~", "a1 ~ a1 ~", "a1 ~ a1 ~",
    "g1 ~ a1 ~", "a1 ~ a1 ~", "a1 g1 a1 ~"
  )
))
.s("sine").gain(0.35).attack(0.01).decay(0.1).sustain(0.6).release(0.1)
