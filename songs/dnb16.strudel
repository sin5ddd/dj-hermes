// @title dnb16
// @genre drum and bass
// @details short live dnb loop @ 174 BPM
setcpm(174/4)

// drums — break + hats
$: s("bd ~ ~ sd ~ bd bd ~, hh*16, [~@5 oh ~@2]").fast(2).gain(0.55)

// sub
$: note("0 ~ ~ <0 -1>")
  .scale("C1:minor")
  .s("sine").lpf(120).gain(0.7)
  .attack(0.01).release(0.4)

// stab
$: note("~ 4 ~ <7 9>")
  .scale("C3:minor")
  .s("square").lpf(2000).gain(0.15)
  .attack(0.001).decay(0.12).sustain(0.15).release(0.05)
