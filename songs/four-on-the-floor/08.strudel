// @title four-on-the-floor-08
// @genre techno
setcpm(124/4)
// drums
$: s("bd:tc*4, [~ hh:dk]*4, <~ ~ ~ [~@3 bd:tc ~@4]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("bs:ht").adsr("0.001:0.08:0.2:0.05").gain(0.44)
// lead
$: note("7@2 6 4  9@2 7 <4 9 3 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:sw").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.15)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:pk").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 3").scale("<A5:minor A5:minor E6:phrygian A5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<A2:minor A2:minor E3:phrygian A2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
