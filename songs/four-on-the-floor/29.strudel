// @title four-on-the-floor-29
// @genre techno
setcpm(124/4)
// drums
$: s("bd:tc*4, [~ hh]*4, <~ ~ ~ [bd:tc sd bd:tc sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("square").lpf(400).gain(0.44)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.05)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ld:sw").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:ac").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<Bb5:minor Bb5:minor F6:phrygian Bb5:minor>")
  .s("plk:pk").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:sf").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("pf:pu").cut(1).gain(0.16).room(0.3).orbit(2)
