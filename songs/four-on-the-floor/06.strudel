// @title four-on-the-floor-06
// @genre techno
setcpm(124/4)
// drums
$: s("bd:9p*4, [~ hh]*4, <~ ~ ~ [~@3 bd:9p ~@4]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("bs:ht").gain(0.44)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("ld:si").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:pk").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<G5:minor G5:minor D6:phrygian G5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("pf:cs").cut(1).gain(0.16).room(0.3).orbit(2)
