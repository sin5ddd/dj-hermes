// @title four-on-the-floor-22
// @genre techno
setcpm(124/4)
// drums
$: s("bd:9p*4, [~ hh]*4, <~ ~ ~ [bd:9p sd bd:9p sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("bs:ht").adsr("0.001:0.08:0.2:0.05").gain(0.44)
// lead
$: note("7@2 6 4  9@2 7 <4 9 3 7>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ld:pu").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.15)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:pk").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 3").scale("<D5:minor D5:minor A5:phrygian D5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<D2:minor D2:minor A2:phrygian D2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
