// @title four-on-the-floor-13
// @genre techno
setcpm(124/4)
// drums
$: s("bd:tc*4, [~ hh]*4, <~ ~ ~ [bd:tc sd bd:tc sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("square").lpf(400).gain(0.44)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.05)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("ld:pu").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:ac").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<Eb5:minor Eb5:minor Bb5:phrygian Eb5:minor>")
  .s("plk:pk").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:sf").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("pf:pu").cut(1).gain(0.16).room(0.3).orbit(2)
