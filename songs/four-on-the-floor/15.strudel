// @title four-on-the-floor-15
// @genre techno
setcpm(124/4)
// drums
$: s("bd*4, [~ hh]*4, <~ ~ ~ [bd sd bd sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("sawtooth").lpf(400).gain(0.44)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.05)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("square").lpf(2800).gain(0.15)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<F5:minor F5:minor C6:phrygian F5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("triangle").lpf(1200).gain(0.22)
// pad
$: note("[0,4]").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("sawtooth").lpf(800).orbit(2).gain(0.16)
  .attack(0.08).decay(0.2).sustain(0.7).release(0.4)
