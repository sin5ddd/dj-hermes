// @title four-on-the-floor-07
// @genre techno
setcpm(124/4)
// drums
$: s("bd*4, [~ hh]*4, <~ ~ ~ [~@3 bd ~@4]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<Ab2:minor Ab2:minor Eb3:phrygian Ab2:minor>")
  .s("sawtooth").lpf(400).gain(0.44)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.05)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("ld:ss").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<Ab5:minor Ab5:minor Eb6:phrygian Ab5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("pf:ff").gain(0.16).room(0.3).orbit(2)
