// @title four-on-the-floor-14
// @genre techno
setcpm(124/4)
// drums
$: s("bd:9p*4, [~ hh]*4, <~ ~ ~ [bd:9p sd bd:9p sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:ht").gain(0.44)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:sw").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:pk").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<E5:minor E5:minor B5:phrygian E5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("pf:cs").cut(1).gain(0.16).room(0.3).orbit(2)
