// @title four-on-the-floor-20
// @genre techno
setcpm(124/4)
// drums
$: s("bd:tc*4, [~ hh:dk]*4, <~ ~ ~ [bd:tc sd bd:tc sd]>").gain(0.62)
// bass
$: note("0 0 2 <4 0 3 0>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("bs:ht").gain(0.44)
// lead
$: note("~ 7 6 <4 9 3 7>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ld:sw").gain(0.15).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("plk:pk").gain(0.18).cut(1)
// arp
$: note("0 3 0 7  3 0 5 ~").scale("<B5:minor B5:minor F#6:phrygian B5:minor>")
  .s("plk:ac").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("pf:ff").gain(0.16).room(0.3).orbit(2)
