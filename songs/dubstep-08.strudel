// @title dubstep-08
// @genre dubstep
// @details mid-forward wobble + open-hat hits @ 140
setcpm(140/4)
// drums
$: s("bd:9p ~ ~ bd:9p, [~ ~ sd:tr ~], [~ oh:op]*2").gain(0.54)
// wobble
$: note("0 0 3 0").scale("C2:minor").s("sawtooth").lpf(sine.rangex(200, 1400)).lpq(4).gain(0.46)
  .attack(0.006).decay(0.14).sustain(0.42).release(0.08)
