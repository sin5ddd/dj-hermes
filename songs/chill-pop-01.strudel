// @title chill-pop-01
// @genre chill-pop
// @details house floor + saw-ish hook in C major
setcpm(100/4)
// drums
$: s("bd:hf*4, [~ sd]*2, [~ hh]*4").gain(0.5)
// bass
$: note("0 0 4 2").scale("C4:major").s("bs:hf").gain(0.44)
// lead
$: note("0 2 4 <7 9>").scale("C4:major").s("square").lpf(2500).gain(0.18)
