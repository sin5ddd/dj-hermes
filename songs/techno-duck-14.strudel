// @title dust-side
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:lf*4").gain(0.89).duckorbit(2).duckattack(0.046).duckdepth(0.84)
// hats
$: s("[~ hh:dk]*4").gain(0.34)
// bass
$: note("0 3 5 0").scale("C4:minor").s("bs:am").orbit(2).gain(0.34)
// lead
$: note("5 0 ~ 3  2 7 ~ 5").scale("C4:minor").s("plk:hd").orbit(2).gain(0.30).cut(1)
