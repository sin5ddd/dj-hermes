// @title chill-05
// @genre chill
// @details denser hats + oh, still not four-on-the-floor
setcpm(100/4)
// drums
$: s("bd ~ ~ sd, [~ hh]*4, ~ ~ ~ oh").gain(0.48)
// bass
$: note("0 0 2 4").scale("C2:minor").s("sine").lpf(380).gain(0.5)
// lead
$: note("~ 7 4 ~").scale("C4:minor").s("triangle").lpf(2000).gain(0.18)
