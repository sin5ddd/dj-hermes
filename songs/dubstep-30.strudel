// @title dubstep-30
// @genre dubstep
// @details hardstyle, dist-square + supersaw hop @ 140
setcpm(140/4)
// drums
$: s("bd:hs ~ ~ ~, [~ ~ sd:tr ~], hh:fc*4").gain(0.5)
// bass
$: note("2 ~ 0 5").scale("C4:minor").s("bs:dq").gain(0.4)
// lead
$: note("7 ~ 2 8").scale("C4:minor").s("ld:ss").gain(0.16).cut(1)
