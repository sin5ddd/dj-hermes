// @title garage16
// @genre uk garage, 2-step
// @details short live 2-step loop @ 132 BPM
setcpm(132/4)

// drums — 2-step skeleton
$: s("bd ~ bd ~ ~ bd ~ ~, [~ sd]*2, hh ~ hh hh hh ~ hh ~, [~@3 oh ~@4]").gain(0.55)

// bass
$: note("0 ~ 0 2 ~ <3 4> 0 ~")
  .scale("C2:minor")
  .s("sawtooth").lpf(420).gain(0.5)
  .attack(0.005).decay(0.08).sustain(0.25).release(0.05)

// stab
$: note("~ 4 ~ <6 7>")
  .scale("C3:minor")
  .s("square").lpf(2400).gain(0.16)
