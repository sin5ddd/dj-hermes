// @title garage16
// @genre uk garage, 2-step
// @details 16-bar loop @ 132 BPM
// cat() = one cycle (bar) per arg — same as mini "<a b c>"
setcpm(132/4)

// kick — 2-step A / A' / break / rebuild
$: s(cat(
  cat(
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ ~ ~ bd ~ ~ ~",
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ bd ~ bd ~ ~ ~"
  ),
  cat(
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ ~ ~ bd ~ ~ ~",
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ bd ~ ~ bd ~ ~"
  ),
  "bd ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ bd ~ bd ~",
  cat(
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ ~ ~ bd ~ ~ ~",
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ bd ~ bd ~ ~ ~",
    "bd ~ ~ ~ bd ~ bd ~", "bd ~ bd ~ bd ~ bd ~"
  )
)).gain(0.88)

// snare — 2-step claps, fill, break
$: s(cat(
  cat(
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ ~ sd ~ sd ~ sd ~]"
  ),
  cat(
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ sd ~ sd ~ ~ sd ~]"
  ),
  "[~ ~ ~ ~ ~ sd ~ ~]", "[~ ~ sd ~ ~ ~ ~ ~]",
  cat(
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ ~ sd ~ ~ ~ sd ~]",
    "[~ ~ sd ~ ~ sd ~ ~]", "[~ ~ sd ~ sd ~ sd ~]",
    "[~ ~ sd ~ ~ sd ~ ~]", "[sd ~ sd ~ ~ sd sd ~]"
  )
)).gain(0.8)

// hat — shuffle 2-step
$: s(cat(
  cat(
    "hh ~ hh hh hh ~ hh ~", "hh ~ hh hh hh ~ hh hh",
    "hh ~ hh hh hh ~ hh ~", "hh hh hh ~ hh ~ hh ~"
  ),
  cat(
    "hh ~ hh hh hh ~ hh ~", "hh ~ hh hh hh ~ hh hh",
    "hh ~ hh hh hh ~ hh ~", "hh hh ~ hh hh ~ hh hh"
  ),
  "hh ~ ~ ~ hh ~ ~ ~", "~ hh ~ hh ~ hh ~ hh",
  cat(
    "hh ~ hh hh hh ~ hh ~", "hh ~ hh hh hh ~ hh hh",
    "hh ~ hh hh hh ~ hh ~", "hh hh hh ~ hh ~ hh ~",
    "hh ~ hh hh hh ~ hh ~", "hh hh hh hh hh ~ hh hh"
  )
)).gain(0.27)

// openhat — sparse, silent break, end
$: s(cat(
  cat(
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ ~ ~ ~ oh ~ ~ oh]"
  ),
  cat(
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ oh ~ ~ ~ ~ oh ~]"
  ),
  "~", "[~ ~ ~ oh ~ ~ ~ ~]",
  cat(
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ ~ ~ ~ ~ ~ oh ~]",
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ ~ ~ ~ oh ~ ~ oh]",
    "[~ ~ ~ oh ~ ~ ~ ~]", "[~ oh ~ oh ~ oh ~ ~]"
  )
)).gain(0.34)

// bass — F minor 2-step, break, run
$: note(cat(
  cat(
    "f2 ~ f2 ~ ab2 ~ c3 ~", "f2 ~ f2 ~ eb2 ~ f2 ~",
    "f2 ~ f2 ~ ab2 ~ c3 ~", "bb1 ~ bb1 ~ c2 ~ eb2 ~",
    "f2 ~ f2 ~ ab2 ~ c3 ~", "f2 ~ f2 ~ eb2 ~ f2 ~",
    "f2 ~ f2 ~ ab2 ~ c3 ~", "bb1 ~ c2 ~ eb2 ~ f2 ~"
  ),
  "f2 ~ ~ ~ ~ ~ ~ ~", "~ ~ f2 ~ ab2 ~ c3 ~",
  cat(
    "f2 ~ f2 ~ ab2 ~ c3 ~", "f2 ~ f2 ~ eb2 ~ f2 ~",
    "f2 ~ f2 ~ ab2 ~ c3 ~", "bb1 ~ bb1 ~ c2 ~ eb2 ~",
    "f2 ~ f2 ~ ab2 ~ c3 ~", "f2 eb2 c2 bb1 ab1 bb1 c2 f2"
  )
))
.s("sawtooth").lpf(450).gain(0.5).attack(0.005).decay(0.1).sustain(0.3).release(0.08)

// keys — stab chords, break, resolve
$: note(cat(
  cat(
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ ~ ~ ~ ab3 ~ ~ ~",
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ ~ bb3 ~ ~ ab3 ~ ~",
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ ~ ~ ~ ab3 ~ ~ ~",
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ bb3 ~ ab3 ~ f3 ~ ~"
  ),
  "~", "~ ~ ~ ~ ~ ~ ab3 ~",
  cat(
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ ~ ~ ~ ab3 ~ ~ ~",
    "~ ~ ab3 ~ ~ ~ c4 ~", "~ ~ bb3 ~ ~ ab3 ~ ~",
    "~ ~ ab3 ~ ~ ~ c4 ~", "ab3 ~ bb3 ~ c4 ~ eb4 ~"
  )
))
.s("triangle").lpf(1800).gain(0.2).attack(0.002).decay(0.12).sustain(0.25).release(0.08)
