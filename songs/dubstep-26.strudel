// @title dubstep-26
// @genre dubstep
// @details zap kick, bright-reese + chime @ 140
setcpm(140/4)
// drums
$: s("bd:ez ~ ~ bd:ez, [~ ~ sd:pi ~], [~ hh:ch]*4").gain(0.5)
// bass
$: note("7 3 ~ 0").scale("C4:minor").s("bs:rb").gain(0.36)
// lead
$: note("8 ~ 3 5").scale("C4:minor").s("plk:ch").gain(0.18).cut(1)
