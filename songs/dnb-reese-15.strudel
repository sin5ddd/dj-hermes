// @title dnb-reese-15
// @genre drum and bass
// @details hardstyle drop, sub-bass + hollow 7 @ 174
setcpm(174/4)
// drums
$: s("[bd:hs ~ ~ sd:fc bd:hs ~ ~ sd:fc, [~ hh:fc]*2]*2").gain(0.64).lpf(2800)
// bass
$: note("2 0 5 7").scale("C4:minor").s("bs:sb").gain(0.44)
// lead
$: note("7 ~ 0 ~").scale("C4:minor").s("plk:s5").gain(0.18).cut(1)
