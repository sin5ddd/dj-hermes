// @title chill-09
// @genre chill
// @details dusty kick + sine sub + pent-ish hook
setcpm(90/4)
// drums
$: s("bd:lf ~ ~ ~, [~ hh]*4").gain(0.38)
// bass
$: note("0 ~ 3 0").scale("C4:minor").s("bs:ss").gain(0.34)
// lead
$: note("5 3 0 2").scale("C4:minor").s("triangle").lpf(1600).gain(0.18)
