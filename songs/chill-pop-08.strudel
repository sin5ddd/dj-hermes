// @title chill-pop-08
// @genre chill-pop
// @details zap kick + growl bass + monophonic ld:ss
setcpm(100/4)
// drums
$: s("bd:ez*4, [~ sd]*2, [~ hh]*4").gain(0.5)
// bass
$: note("0 ~ 4 0").scale("C4:major").s("bs:g2").gain(0.36)
// lead
$: note("7 ~ 9 4").scale("C4:major").s("ld:ss").gain(0.24).cut(1)
