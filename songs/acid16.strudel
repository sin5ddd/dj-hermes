// @title acid16
// @genre acid, minimal techno
// @details 16-bar loop @ 130 BPM
// Degrees 0-based C minor: 0=c 2=eb 3=f 4=g 6=bb 7=c+oct (−1 = bb below root)
// cat() = one bar per arg; <> alternates by global cycle within a slot
setcpm(130/4)

// drums — kick + hat + snare parallel
$: s(cat(
  cat(
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ bd, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ bd ~, [~ hh hh hh], [~ ~ sd sd]"
  ),
  cat(
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ bd, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ bd bd, [hh ~ hh hh], [~ sd ~ sd]"
  ),
  "bd ~ ~ ~, [~ ~ ~ hh], [~ ~ ~ ~]",
  "~ ~ ~ bd, [~ hh ~ ~], [~ ~ sd ~]",
  cat(
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ bd, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd ~ bd ~, [~ hh hh hh], [~ ~ sd sd]",
    "bd ~ ~ ~, [~ hh ~ hh], [~ ~ sd ~]",
    "bd bd ~ bd, [hh hh ~ hh], [sd ~ sd ~]"
  )
)).gain(0.55)

// acid — TB-ish 16ths; degree + scale + <> tail variants (16 bars)
$: note(cat(
  // A (4 bars) — same skeleton; <> picks different tails across cycles
  "0 2 0 3 0 <2 4> <4 2> <2 <3 6>>",
  "0 2 0 3 0 <2 4> <4 2> <2 <3 6>>",
  "0 2 0 3 0 <2 4> <4 2> <2 <3 6>>",
  "0 2 0 3 0 <2 4> <4 2> <2 <3 6>>",
  // A' (4)
  "0 2 0 3 0 <2 4> <4 2> <3 6 7 6>",
  "0 2 0 3 0 <2 4> <4 2> <3 6 7 6>",
  "0 2 0 3 0 <2 4> <4 2> <3 6 7 6>",
  "0 2 0 3 0 <2 4> <4 2> <3 6 7 6>",
  // break (2)
  "0 ~ ~ ~ ~ ~ ~ ~",
  "~ ~ ~ ~ 0 2 3 4",
  // B (6)
  "0 2 0 3 0 2 4 2",
  "0 2 0 3 0 4 2 3",
  "0 2 0 3 0 2 4 2",
  "0 3 2 4 0 2 3 4",
  "0 2 0 3 0 4 6 7",
  "7 6 4 3 2 3 4 0"
)).scale("C2:minor")
.s("sawtooth").lpf(650).gain(0.5).attack(0.001).decay(0.06).sustain(0.15).release(0.04)

// high — sparse stabs (C3:minor degrees)
$: note(cat(
  cat("~", "~ ~ ~ ~ ~ ~ 4 ~", "~", "~ ~ ~ ~ 6 ~ ~ ~"),
  cat("~", "~ ~ ~ ~ ~ ~ 4 ~", "~", "~ ~ 7 ~ ~ 6 ~ 4"),
  "~","~",
  cat("~", "~ ~ ~ ~ ~ ~ 4 ~", "~", "~ ~ ~ ~ 6 ~ ~ ~", "~ ~ ~ ~ ~ ~ 4 ~", "7 ~ 6 ~ 4 ~ 3 ~")
)).scale("C3:minor")
.s("square")
.lpf(3200).gain(0.16).attack(0.001).decay(0.05).sustain(0.1).release(0.03)
