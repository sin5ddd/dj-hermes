// @title future-bass-03
// @genre future-bass
// @details zap kick, bs:hf + ld:ss @ 140
setcpm(140/4)
// drums
$: s("bd:ez*4, [~ sd:tr]*2, hh:hs*8").gain(0.46)
// bass
$: note("0 0 4 0").scale("C4:major").s("bs:hf").gain(0.42)
// lead
$: note("4 ~ 7 4").scale("C4:major").s("ld:ss").gain(0.18).cut(1)
