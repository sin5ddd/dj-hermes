// @title future-bass-03
// @genre future-bass
// @details brighter: open chords + ld:ss hook @ 148
setcpm(148/4)
// drums
$: s("bd:hf*4, [~ sd:9s]*2, hh:hs*8, [~ oh:op]*2").gain(0.48)
// chords
$: note("[0,2,4] ~ [2,4,6] ~").scale("C3:minor").s("sawtooth").lpf(2200).gain(0.24)
  .attack(0.018).decay(0.16).sustain(0.42).release(0.12)
// lead
$: note("4 ~ 7 4").scale("C4:minor").s("ld:ss").gain(0.2).cut(1)
// sub
$: note("0 ~ 0 ~").scale("C4:minor").s("bs:su").gain(0.46)
