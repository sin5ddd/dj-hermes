// @title house16
// @genre house
// @details short live house loop @ 122 BPM
setcpm(122/4)

// drums
$: s("bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2").gain(0.55)

// bass
$: note("0 0 2 4 0 <2 3> 4 0")
  .scale("C2:minor")
  .s("sawtooth").lpf(450).gain(0.5)
  .attack(0.005).decay(0.1).sustain(0.3).release(0.06)

// stab
$: note("~ ~ 4 <7 6>")
  .scale("C3:minor")
  .s("square").lpf(2200).gain(0.18)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.05)

// chords
$: note("0 2 4 [6,8] ~ 2 4 [7,9]")
  .scale("C4:minor")
  .s("sawtooth").gain(0.28).bpf(1400)
