// @title house16
// @genre house
// @details 16-bar classic house loop @ 122 BPM
// cat() = one cycle (bar) per arg — same as mini "<a b c>"
// drums: parallel layers (comma = simultaneous, space = sequence)
setcpm(122/4)

// drums — smart mini: * densify, @ elongate, comma = parallel
$: s(cat(
  cat(
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh ~ [sd ~]]"
  ),
  "bd*4, [~@3 sd], hh*4, [~@3 oh]",
  cat(
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd*4, [~ sd]*2, [~ hh]*4, [~ oh]*2",
    "bd bd bd ~, [~ sd sd sd], hh*16, [~ oh oh oh]"
  )
)).gain(0.55)

// bass — C / F / break / return
$: note(cat(
  cat(
    "c2 c2 g2 c2", "c2 c2 g2 bb1", "f2 f2 c2 f2", "f2 f2 eb2 f2",
    "c2 c2 g2 c2", "c2 c2 g2 bb1", "f2 f2 c2 f2", "g2 g2 f2 g2"
  ),
  "c2 ~ ~ ~", "~ ~ g2 c2",
  cat(
    "c2 c2 g2 c2", "c2 c2 g2 bb1", "f2 f2 c2 f2",
    "f2 f2 eb2 f2", "c2 c2 g2 c2", "g2 f2 eb2 c2"
  )
))
.s("triangle").lpf(520).gain(0.58).attack(0.01).decay(0.15).sustain(0.5).release(0.1)

// pad — held chords, rest break, resolve
$: note(cat(
  cat("c3 ~ ~ ~", "c3 ~ ~ ~", "f3 ~ ~ ~", "f3 ~ ~ ~",
      "c3 ~ ~ ~", "c3 ~ ~ ~", "f3 ~ ~ ~", "g3 ~ ~ ~"),
  "~", "~",
  cat("c3 ~ ~ ~", "c3 ~ ~ ~", "f3 ~ ~ ~", "f3 ~ ~ ~", "c3 ~ ~ ~", "g3 ~ f3 ~")
))
.s("sine").lpf(900).gain(0.18).attack(0.08).decay(0.2).sustain(0.7).release(0.25)
