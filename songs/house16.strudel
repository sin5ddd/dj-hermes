// title: house16
// 16-bar classic house loop @ 122 BPM
setcpm(122/4)
// kick
$: s("<[bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd bd bd ~]>").gain(0.9)
