// @title electro-27
// @genre electro
// @details disco-dry, acid + dry house pluck @ 126
setcpm(126/4)
// drums
$: s("bd:dc*4, [~ sd:hd]*2, [~ hh:hs]*4").gain(0.5)
// bass
$: note("0 2 ~ 3 7 5 0 2").scale("C4:minor").s("bs:ac").gain(0.4)
// lead
$: note("7 5 ~ 2").scale("C4:minor").s("plk:hd").gain(0.22).cut(1)
