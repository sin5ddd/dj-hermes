// @title electro-08
// @genre electro
// @details disco-dry kick, bs:ht + climbing pluck @ 126
setcpm(126/4)
// drums
$: s("bd:dc*4, [~ sd:8s]*2, hh:tt*8").gain(0.5)
// bass
$: note("0 0 ~ 3 0 5 ~ 0").scale("C4:minor").s("bs:ht").gain(0.42)
// lead
$: note("0 2 4 7").scale("C4:minor").s("plk:lp").gain(0.22).cut(1)
