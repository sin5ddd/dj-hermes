// @title electro-20
// @genre electro
setcpm(126/4)
// drums
$: s("bd*4, ~ sd ~ sd, hh*16, <~ ~ ~ [bd sd bd sd]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<B2:minor B2:minor F#3:phrygian B2:minor>")
  .s("square").lpf(500).gain(0.46)
  .attack(0.001).decay(0.08).sustain(0.15).release(0.04)
// lead
$: note("~ 7 4 <9 7 12 7>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ld:ss").gain(0.14).cut(1)
// hook
$: note("12 ~ 7 <12 15 12 7>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("square").penv(12).pattack(0.001).pdecay(0.08).lpf(2400).gain(0.16)
// arp
$: note("~ 0 3 7  3 0 ~ 5").scale("<B5:minor B5:minor F#6:phrygian B5:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("plk:sp").gain(0.18)
// pad
$: note("0").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("pf:ff").gain(0.14).room(0.25).orbit(2)
