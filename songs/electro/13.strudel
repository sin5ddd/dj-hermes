// @title electro-13
// @genre electro
setcpm(126/4)
// drums
$: s("bd*4, ~ sd:rm ~ sd:rm, hh*16, <~ ~ ~ [bd sd:rm bd sd:rm]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("bs:dq").adsr("0.001:0.08:0.15:0.04").gain(0.46)
// lead
$: note("~ 7 4 <9 7 12 7>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("ld:pu").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.14)
// hook
$: note("12 ~ 7 <12 15 12 7>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// arp
$: note("~ 0 3 7  3 0 ~ 5").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("plk:sf").gain(0.18)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.25).orbit(2)
