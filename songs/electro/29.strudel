// @title electro-29
// @genre electro
setcpm(126/4)
// drums
$: s("bd*4, ~ sd ~ sd, hh:ch*8, <~ ~ ~ [bd sd bd sd]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("bs:dq").adsr("0.001:0.08:0.15:0.04").gain(0.46)
// lead
$: note("7@2 4 7  9@2 12 <9 7 12 7>").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("ld:ch").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.14)
// hook
$: note("12@2 7 12  15@2 12 <12 15 12 7>").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("ld:st").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// arp
$: note("0 3 7 12  3 0 5 7").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("plk:sf").gain(0.18)
// pad
$: note("0").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("ld:hf").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.25).orbit(2)
