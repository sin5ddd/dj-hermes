// @title electro-29
// @genre electro
// @details hardstyle, hoover + supersaw chirp @ 126
setcpm(126/4)
// drums
$: s("bd:hs*4, [~ sd:9s]*2, hh:fc*8").gain(0.5)
// bass
$: note("0 3 2 7 ~ 5 0 3").scale("C4:minor").s("bs:hv").gain(0.36)
// lead
$: note("0 ~ 8 3").scale("C4:minor").s("ld:ss").gain(0.16).cut(1)
