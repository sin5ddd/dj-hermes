// @title electro-16
// @genre electro
setcpm(126/4)
// drums
$: s("bd:ez*4, ~ sd ~ sd, hh*16, <~ ~ ~ [bd:ez sd bd:ez sd]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("bs:dq").gain(0.46)
// lead
$: note("~ 7 4 <9 7 12 7>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("ld:pu").gain(0.14).cut(1)
// hook
$: note("12 ~ 7 <12 15 12 7>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// arp
$: note("~ 0 3 7  3 0 ~ 5").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("plk:s5").gain(0.18)
// pad
$: note("<0 ~ ~ ~>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("pf:pu").cut(1).gain(0.14).room(0.25).orbit(2)
