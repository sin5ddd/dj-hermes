// @title electro-15
// @genre electro
setcpm(126/4)
// drums
$: s("bd:ez*4, ~ sd ~ sd, hh:ch*16, <~ ~ ~ [bd:ez sd bd:ez sd]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("bs:dq").gain(0.46)
// lead
$: note("~ 7 4 <9 7 12 7>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("ld:dp").gain(0.14).cut(1)
// hook
$: note("12 ~ 7 <12 15 12 7>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("ld:us").gain(0.16).cut(1)
// arp
$: note("~ 0 3 7  3 0 ~ 5").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("plk:sf").gain(0.18)
// pad
$: note("0").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("pf:ff").gain(0.14).room(0.25).orbit(2)
