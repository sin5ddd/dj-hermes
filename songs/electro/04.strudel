// @title electro-04
// @genre electro
// @details 909 punch, saw bass + ld:ss @ 126
setcpm(126/4)
// drums
$: s("bd:9p*4, [~ sd:9s]*2, hh:cl*8").gain(0.5)
// bass
$: note("0 3 5 3 0 7 5 0").scale("C2:minor").s("sawtooth").lpf(800).gain(0.4)
  .attack(0.001).decay(0.07).sustain(0.2).release(0.04)
// lead
$: note("4 ~ 7 4").scale("C4:minor").s("ld:ss").gain(0.16).cut(1)
