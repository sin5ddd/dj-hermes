// @title electro-18
// @genre electro
setcpm(126/4)
// drums
$: s("bd*4, ~ sd:rm ~ sd:rm, hh*16, <~ ~ ~ [bd sd:rm bd sd:rm]>").gain(0.62)
// bass
$: note("0 ~ 0 <3 0 0 5>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("bs:dq").gain(0.46)
// lead
$: note("~ 7 4 <9 7 12 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:ch").gain(0.14).cut(1)
// hook
$: note("12 ~ 7 <12 15 12 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:lz").cut(1).gain(0.16)
// arp
$: note("~ 0 3 7  3 0 ~ 5").scale("<A5:minor A5:minor E6:phrygian A5:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:s5").gain(0.18)
// pad
$: note("0").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("pf:ff").gain(0.14).room(0.25).orbit(2)
