// @title electro-30
// @genre electro
// @details fm-noise, growl-2 + fm pluck @ 126
setcpm(126/4)
// drums
$: s("bd:fn*4, [~ sd:pi]*2, hh:ch*8").gain(0.5)
// bass
$: note("7 0 5 3 2 0 7 3").scale("C4:minor").s("bs:g2").gain(0.38)
// lead
$: note("5 0 7 2").scale("C4:minor").s("plk:lp").gain(0.22).cut(1)
