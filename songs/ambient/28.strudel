// @title ambient-28
// @genre ambient
setcpm(70/4)
// pad
$: note("0").scale("<A2:minor F3:lydian D3:dorian E3:phrygian A2:minor F3:lydian D3:dorian E3:phrygian A2:minor F3:lydian D3:dorian E3:phrygian E3:phrygian D3:dorian F3:lydian A2:minor>")
  .s("ps:sh").adsr("0.4:0.8:0.7:0.8").cut(1).gain(0.22).room(0.5).orbit(2)
// bass
