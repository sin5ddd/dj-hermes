  .scale("<A4:minor F5:lydian D5:dorian E5:phrygian A4:minor F5:lydian D5:dorian E5:phrygian A4:minor F5:lydian D5:dorian E5:phrygian E5:phrygian D5:dorian F5:lydian A4:minor>")
  .s("ld:et").adsr("0.08:0.5:0.6:0.5").cut(1).gain(0.12)
