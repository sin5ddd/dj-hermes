// @title ambient-28
// @genre ambient
setcpm(70/4)
// drums
$: s("~ ~ ~ ~").gain(0.18)
// bass
$: note("0 ~ ~ <0 0 ~ 0>").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("bs:su").gain(0.28)
// lead
$: note("~ 7 ~ <9 7 4 11>").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("plk:bl").gain(0.1).cut(1)
// hook
$: note("0@2 ~ 4@2 ~").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("plk:am").gain(0.16).cut(1)
// arp
$: s("<~ perc:cm ~ perc:tg>").gain(0.1)
// chords
$: note("[0,2,4] ~ ~ ~").scale("<A3:minor A3:minor E4:dorian A3:minor>")
  .s("triangle").lpf(800).gain(0.18)
  .attack(0.2).release(0.8)
// pad
$: note("[0,4]").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("pf:ff").gain(0.24)
  .attack(0.3).decay(0.4).sustain(0.7).release(0.6).room(0.5).orbit(1)
