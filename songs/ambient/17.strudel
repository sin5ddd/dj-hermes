// @title ambient-17
// @genre ambient
setcpm(70/4)
// drums
$: s("~ ~ ~ ~").gain(0.18)
// bass
$: note("0 ~ ~ <0 0 ~ 0>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("bs:su").gain(0.28)
// lead
$: note("~ 7 ~ <9 7 4 11>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("ld:et").gain(0.1).cut(1)
// hook
$: note("0@2 ~ 4@2 ~").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("ld:cr").gain(0.16).cut(1)
// arp
$: s("<~ perc:tg ~ perc:cm>").gain(0.1)
// chords
$: note("<[[0,2,4] ~ ~ ~] ~ ~ ~>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("ld:fp").gain(0.18)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("pf:cl").cut(1).gain(0.24).room(0.5).orbit(1)
