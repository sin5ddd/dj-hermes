// @title ambient-12
// @genre ambient
setcpm(70/4)
// pad
$: note("0").scale("<D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor C3:mixolydian Bb2:lydian A2:phrygian>")
  .s("ps:sh").adsr("0.4:0.8:0.7:0.8").cut(1).gain(0.22).room(0.5).orbit(2)
// bass
$: note("0 ~ ~ ~").scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("bs:su").gain(0.26)
// chords
$: note("<[[0,2,4] ~ ~ ~] ~ ~ ~>").scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("ld:fp").gain(0.16)
// lead
$: note("<[~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ ~ ~ 4] [7 ~ 9 ~] [~ 4 ~ ~] [~ ~ 7 ~]>")
  .scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("ld:si").adsr("0.08:0.5:0.6:0.5").cut(1).gain(0.12)
// hook
$: note("<[0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~]>")
  .scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("plk:am").gain(0.14).cut(1)
// arp
$: note("<[~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~]>")
  .scale("<D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor C6:mixolydian Bb5:lydian A5:phrygian>")
  .s("plk:hp").cut(1).gain(0.1)
// drums
$: s("<~ ~ ~ ~ [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] ~ ~ ~ ~ ~ ~ ~ ~>").gain(0.18)
// perc
$: s("<~ ~ ~ ~ ~ perc:cb ~ perc:cm ~ ~ ~ ~ ~ ~ ~ ~>").gain(0.1)
// drone
$: note("<0 ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor C3:mixolydian Bb2:lydian A2:phrygian>")
  .s("dr:fg").adsr("0.5:1.0:0.6:1.0").cut(1).gain(0.1).room(0.45).orbit(2)
// air
$: s("<~ ~ ~ fx:ha ~ ~ ~ fx:nh ~ ~ ~ fx:ha ~ ~ ~ fx:wd>").gain(0.1).cut(1)
// fx
$: s("<~ ~ ~ ~ ~ ~ ~ fx:wh ~ ~ ~ ~ ~ ~ ~ fx:sw>").gain(0.14).cut(1)
// bells
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [~ 11 ~ ~] ~ [~ 7 ~ ~] ~>").scale("<D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor Bb5:lydian G5:dorian A5:phrygian D5:minor C6:mixolydian Bb5:lydian A5:phrygian>")
  .s("plk:ch").gain(0.08).cut(1)
