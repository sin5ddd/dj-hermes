// choir
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [0@3 ~] [0@3 ~] [0@3 ~] [0@3 ~]>").scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("pf:ca").adsr("0.3:0.6:0.7:0.6").cut(1).gain(0.1).room(0.4).orbit(2)
// counter
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~]>").scale("<D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor Bb4:lydian G4:dorian A4:phrygian D4:minor C5:mixolydian Bb4:lydian A4:phrygian>")
  .s("plk:ps").adsr("0.08:0.5:0.6:0.5").cut(1).gain(0.1)
// swell
$: note("<~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0>").scale("<D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor Bb2:lydian G2:dorian A2:phrygian D2:minor C3:mixolydian Bb2:lydian A2:phrygian>")
  .s("pf:cl").adsr("0.4:0.8:0.5:0.8").cut(1).gain(0.12).room(0.5).orbit(2)
