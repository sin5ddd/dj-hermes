// @title ambient-06
// @genre ambient
setcpm(70/4)
// pad
$: note("0").scale("<G2:minor Eb3:lydian C3:dorian D3:phrygian G2:minor Eb3:lydian C3:dorian D3:phrygian G2:minor Eb3:lydian C3:dorian D3:phrygian D3:phrygian C3:dorian Eb3:lydian G2:minor>")
  .s("pf:cl").adsr("0.4:0.8:0.7:0.8").cut(1).gain(0.22).room(0.5).orbit(2)
// bass
