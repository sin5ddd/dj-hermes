// @title ambient-15
// @genre ambient
setcpm(70/4)
// pad
$: note("0").scale("<F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor Eb3:mixolydian C#3:lydian C3:phrygian>")
  .s("pf:wa").adsr("0.4:0.8:0.7:0.8").cut(1).gain(0.22).room(0.5).orbit(2)
// bass
$: note("0 ~ ~ ~").scale("<F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("bs:su").gain(0.26)
// chords
$: note("[0,2,4]").scale("<F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("ep:mt").gain(0.16)
// lead
$: note("<[~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~] [~ ~ ~ 4] [7 ~ 9 ~] [~ 4 ~ ~] [~ ~ 7 ~]>")
  .scale("<F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("ld:si").adsr("0.08:0.5:0.6:0.5").cut(1).gain(0.12)
// hook
$: note("<[0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [0@2 ~ 4@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~] [4@2 ~ 0@2 ~]>")
  .scale("<F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("plk:am").gain(0.14).cut(1)
// arp
$: note("<[~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~]>")
  .scale("<F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor Eb6:mixolydian C#6:lydian C6:phrygian>")
  .s("plk:hp").cut(1).gain(0.1)
// drums
$: s("<~ ~ ~ ~ [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] [bd:lf ~ ~ ~] ~ ~ ~ ~ ~ ~ ~ ~>").gain(0.18)
// perc
$: s("<~ ~ ~ ~ ~ perc:cb ~ perc:cm ~ ~ ~ ~ ~ ~ ~ ~>").gain(0.1)
// drone
$: note("<0 ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor Eb3:mixolydian C#3:lydian C3:phrygian>")
  .s("dr:fg").adsr("0.5:1.0:0.6:1.0").cut(1).gain(0.1).room(0.45).orbit(2)
// air
$: s("<~ ~ ~ fx:ha ~ ~ ~ fx:nh ~ ~ ~ fx:ha ~ ~ ~ fx:wd>").gain(0.1).cut(1)
// fx
$: s("<~ ~ ~ ~ ~ ~ ~ fx:wh ~ ~ ~ ~ ~ ~ ~ fx:sw>").gain(0.14).cut(1)
// bells
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [~ 11 ~ ~] ~ [~ 7 ~ ~] ~>").scale("<F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor C#6:lydian Bb5:dorian C6:phrygian F5:minor Eb6:mixolydian C#6:lydian C6:phrygian>")
  .s("plk:bl").gain(0.08).cut(1)
// vox
$: s("<~ ~ ~ ~ ~ ~ ~ ~ ~ vc:na ~ ~ ~ ~ ~ ~>").gain(0.1).cut(1)
// choir
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [0@3 ~] [0@3 ~] [0@3 ~] [0@3 ~]>").scale("<F3:minor C#4:lydian Bb3:dorian C4:phrygian F3:minor C#4:lydian Bb3:dorian C4:phrygian F3:minor C#4:lydian Bb3:dorian C4:phrygian F3:minor Eb4:mixolydian C#4:lydian C4:phrygian>")
  .s("ld:cr").adsr("0.3:0.6:0.7:0.6").cut(1).gain(0.1).room(0.4).orbit(2)
// counter
$: note("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [~ 7 ~ ~] [~ ~ 4 ~] [~ 9 ~ 7] [4 ~ ~ ~]>").scale("<F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor C#5:lydian Bb4:dorian C5:phrygian F4:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("ld:ny").adsr("0.08:0.5:0.6:0.5").cut(1).gain(0.1)
// swell
$: note("<~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0>").scale("<F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor C#3:lydian Bb2:dorian C3:phrygian F2:minor Eb3:mixolydian C#3:lydian C3:phrygian>")
  .s("pf:cl").adsr("0.4:0.8:0.5:0.8").cut(1).gain(0.12).room(0.5).orbit(2)
