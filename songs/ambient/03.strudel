// drone
$: note("<0 ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Bb2:phrygian Ab2:dorian B2:lydian Eb2:minor>")
