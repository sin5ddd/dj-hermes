  .scale("<Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Bb4:phrygian Ab4:dorian B4:lydian Eb4:minor>")
  .s("plk:am").gain(0.14).cut(1)
// arp
$: note("<[~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [~ 4 ~ 7] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~] [7 ~ 4 ~]>")
