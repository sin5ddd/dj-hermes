// @title ambient-03
// @genre ambient
setcpm(70/4)
// pad
$: note("0").scale("<Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Eb2:minor B2:lydian Ab2:dorian Bb2:phrygian Bb2:phrygian Ab2:dorian B2:lydian Eb2:minor>")
  .s("pf:wa").adsr("0.4:0.8:0.7:0.8").cut(1).gain(0.22).room(0.5).orbit(2)
// bass
$: note("0 ~ ~ ~").scale("<Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Eb4:minor B4:lydian Ab4:dorian Bb4:phrygian Bb4:phrygian Ab4:dorian B4:lydian Eb4:minor>")
  .s("bs:su").gain(0.26)
// chords
