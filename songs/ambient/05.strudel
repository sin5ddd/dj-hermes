// @title ambient-05
// @genre ambient
setcpm(70/4)
// drums
$: s("bd:lf ~ ~ ~").gain(0.18)
// bass
$: note("0 ~ ~ <0 0 ~ 0>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("bs:su").gain(0.28)
// lead
$: note("~ 7 ~ <9 7 4 11>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("plk:bl").gain(0.1).cut(1)
// hook
$: note("0@2 ~ 4@2 ~").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("plk:am").gain(0.16).cut(1)
// arp
$: s("<~ perc:cm ~ perc:tg>").gain(0.1)
// chords
$: note("[0,2,4] ~ ~ ~").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("ep:mt").gain(0.18)
// pad
$: note("0").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("pf:ff").gain(0.24).room(0.5).orbit(1)
