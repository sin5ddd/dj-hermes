// @title lofi-hiphop-02
// @genre lofi-hiphop
// @details kick only + dark Reese + hollow pf:ff
setcpm(84/4)
// drums
$: s("bd:lf ~ ~ ~").gain(0.4)
// bass
$: note("0 3 0 <0 -1>").scale("C4:minor").s("bs:dk").gain(0.3)
// pad
$: note("0 ~ 0 ~").scale("C4:minor").s("pf:ff").gain(0.22)
  .attack(0.12).release(0.4).room(0.36).orbit(1)
