// @title future-bass-18
// @genre future-bass
// @details dust drop, sine-sub + add9 chime @ 140
setcpm(140/4)
// drums
$: s("bd:lf ~ bd:lf ~, [~ sd:hd]*2, [~ hh:cl]*4").gain(0.48)
// bass
$: note("4 2 ~ 0").scale("C4:major").s("bs:ss").gain(0.46)
// lead
$: note("[0,4,9] 9 4 0").scale("C4:major").s("plk:ch").gain(0.18).cut(1)
