// @title skill-acid-303-filter-envelope
// @genre acid techno
// @details TB-303: per-note lpenv (not static lpf), techno kick-front, 130 BPM
setcpm(130/4)
// drums — techno four-on-the-floor (no house snare)
$: s("bd*4, [~ hh]*4").gain(0.65)
// acid — 16ths, monophonic, filter env retriggers per onset
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("C2:minor")
  .s("sawtooth")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.48)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
