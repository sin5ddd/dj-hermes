// @title dubstep-10
// @genre dubstep
// @details thud kick, square pulse + fx:sd @ 140
setcpm(140/4)
// drums
$: s("bd:tc ~ ~ ~, [~ ~ sd:hd ~], [~ hh:tt]*4").gain(0.52)
// bass
$: note("0 ~ 0 ~").scale("C2:minor").s("square").lpf(140).gain(0.44)
  .attack(0.01).decay(0.25).sustain(0.35).release(0.12)
// fx
$: s("<fx:sd ~ ~ ~>").gain(0.26)
