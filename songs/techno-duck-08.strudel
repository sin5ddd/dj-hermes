// @title fm-lead-pump
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.85)
// hats
$: s("[~ hh]*4").gain(0.4)
// bass
$: note("0 0 2 0").scale("C2:minor")
  .s("sine").fm(3).fmh(1).fmdec(0.28).fmsus(0.22).lpf(440).gain(0.5)
  .orbit(2)
// pad
$: note("0 2 4 7").scale("C3:minor")
  .s("triangle").lpf(1000).orbit(2).gain(0.22)
  .attack(0.06).sustain(0.6).release(0.2)
// lead
$: note("4 2 0 2").scale("C4:minor")
  .s("sine").fm(3).fmh(2).fmatt(0.01).fmdec(0.3).fmsus(0.25)
  .lpf(1800).orbit(2).gain(0.2)
  .attack(0.01).decay(0.2).sustain(0.35).release(0.1)
