// @title frost-bell
// @by strudel-rs
// @details metal hit, glass smash, FM bell @ 96
setcpm(96/4)
// drums
$: s("bd:mt ~ ~ ~, perc:mh ~ perc:gs ~, perc:tg ~ ~ perc:tm").gain(0.34)
// bass
$: note("0 ~ ~ ~").scale("C4:lydian").s("bs:ss").gain(0.26)
// pad
$: note("0 ~ ~ ~").scale("C4:lydian").s("pf:ff").gain(0.18).cut(1)
  .attack(0.2).decay(0.3).sustain(0.7).release(0.5).room(0.4).orbit(1)
// lead
$: note("0 ~ 4 ~  3 ~ <6 7> ~").scale("C4:lydian").s("plk:bl").gain(0.16).cut(1)
// fx
$: s("<~ ~ ~ fx:gs>").gain(0.18)
