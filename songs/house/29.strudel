// @title house-29
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp]*2, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58).lpf(4000)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("plk:lp").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<Bb5:minor Bb5:minor F6:dorian Bb5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Bb3:minor Bb3:minor F4:dorian Bb3:minor>")
  .s("triangle").lpf(1400).gain(0.24)
// pad
$: note("[0,4]").scale("<Bb3:minor Bb3:minor F4:dorian Bb3:minor>")
  .s("sine").fm(1.2).fmh(1).fmdec(0.8).fmsus(0.4)
  .room(0.3).orbit(2).gain(0.16)
