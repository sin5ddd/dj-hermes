// @title house-03
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp:rm]*2, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Eb4:minor Eb4:minor Bb4:dorian Eb4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("7@2 4 7  9@2 4 <7 9 4 2>").scale("<Eb4:minor Eb4:minor Bb4:dorian Eb4:minor>")
  .s("ld:us").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<Eb4:minor Eb4:minor Bb4:dorian Eb4:minor>")
  .s("plk:lp").gain(0.22).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<Eb5:minor Eb5:minor Bb5:dorian Eb5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<Eb4:minor Eb4:minor Bb4:dorian Eb4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Bb2:dorian Eb2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<Eb4:minor Eb4:minor Bb4:dorian Eb4:minor>")
  .s("vc:na").gain(0.14).cut(1)
