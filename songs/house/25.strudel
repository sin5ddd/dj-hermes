// @title house-25
// @genre house
setcpm(124/4)
// drums
$: s("bd:dc*4, [~ cp]*2, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.58).lpf(4000)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("7@2 4 7  9@2 4 <7 9 4 2>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("plk:hb").gain(0.22).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<F5:minor F5:minor C6:dorian F5:minor>")
  .s("plk:aj").gain(0.14).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("ep:wr").gain(0.22)
// pad
$: note("0").scale("<F2:minor F2:minor C3:dorian F2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("vc:pa").gain(0.14).cut(1)
