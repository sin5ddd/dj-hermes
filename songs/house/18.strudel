// @title house-18
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp:rm]*2, hh:cl*8, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("ld:us").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("plk:lp").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<A5:minor A5:minor E6:dorian A5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<A2:minor A2:minor E3:dorian A2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<A4:minor A4:minor E5:dorian A4:minor>")
  .s("vc:na").gain(0.14).cut(1)
