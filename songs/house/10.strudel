// @title house-10
// @genre house
setcpm(124/4)
// drums
$: s("bd:dc*4, [~ cp]*2, [~ hh:cl]*4, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<B4:minor B4:minor F#5:dorian B4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<B4:minor B4:minor F#5:dorian B4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<B4:minor B4:minor F#5:dorian B4:minor>")
  .s("plk:hb").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<B5:minor B5:minor F#6:dorian B5:minor>")
  .s("plk:aj").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<B4:minor B4:minor F#5:dorian B4:minor>")
  .s("ep:wr").gain(0.22)
// pad
$: note("0").scale("<B4:minor B4:minor F#5:dorian B4:minor>")
  .s("pf:ff").gain(0.16).room(0.3).orbit(2)
