// @title house-15
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp]*2, hh:hs*8, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("plk:lp").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<F5:minor F5:minor C6:dorian F5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("0").scale("<F4:minor F4:minor C5:dorian F4:minor>")
  .s("pf:ff").gain(0.16).room(0.3).orbit(2)
