// @title house-02
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp]*2, [~ hh:cl]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<D4:minor D4:minor A4:dorian D4:minor>")
  .s("bs:sw").gain(0.42)
// lead
$: note("7@2 4 7  9@2 4 <7 9 4 2>").scale("<D4:minor D4:minor A4:dorian D4:minor>")
  .s("ld:sw").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<D4:minor D4:minor A4:dorian D4:minor>")
  .s("plk:ep").gain(0.22).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<D5:minor D5:minor A5:dorian D5:minor>")
  .s("plk:hb").gain(0.14).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<D4:minor D4:minor A4:dorian D4:minor>")
  .s("plk:sm").gain(0.22)
// pad
$: note("0").scale("<D2:minor D2:minor A2:dorian D2:minor>")
  .s("pf:mn").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<D4:minor D4:minor A4:dorian D4:minor>")
  .s("vc:ya").gain(0.14).cut(1)
