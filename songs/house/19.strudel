// @title house-19
// @genre house
setcpm(124/4)
// drums
$: s("bd:dc*4, [~ cp]*2, hh:hs*8, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("wt_organ").gain(0.16).cut(1)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("plk:hb").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<Bb5:minor Bb5:minor F6:dorian Bb5:minor>")
  .s("plk:aj").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("ep:wr").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("pf:fo").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<Bb4:minor Bb4:minor F5:dorian Bb4:minor>")
  .s("vc:pa").gain(0.14).cut(1)
