// @title house-27
// @genre house
setcpm(124/4)
// drums
$: s("bd:hf*4, [~ cp:rm]*2, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.58).lpf(4000)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("~ 7 4 <7 9 4 2>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("ld:sw").gain(0.16).cut(1)
// hook
$: note("4 ~ 7 4  2 0 ~ -1").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("plk:lp").gain(0.22).cut(1)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<Ab5:minor Ab5:minor Eb6:dorian Ab5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("ep:ky").gain(0.22)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("pf:mn").cut(1).gain(0.16).room(0.3).orbit(2)
// vox
$: note("~ 0 ~ ~  ~ 4 ~ ~").scale("<Ab4:minor Ab4:minor Eb5:dorian Ab4:minor>")
  .s("vc:na").gain(0.14).cut(1)
