// @title dnb-reese-06
// @genre drum and bass
// @details amen drop, square + plk:s5 as 0 ~ 0 ~ @ 174
setcpm(174/4)
// drums
$: s("[bd:dn ~ ~ sd:dn ~ ~ bd:dn sd:dn, [~ hh:dn]*2]*2").gain(0.66).lpf(3000)
// bass
$: note("0 ~ 0 ~").scale("C2:minor").s("square").lpf(120).gain(0.44)
// lead
$: note("0 ~ 0 ~").scale("C4:minor").s("plk:s5").gain(0.2).cut(1)
