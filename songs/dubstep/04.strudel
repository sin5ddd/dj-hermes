// @title dubstep-04
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd:ng ~ ~ ~ bd:ng ~ sd:ng ~, hh:dk*8, <~ ~ ~ [bd:ng sd:ng bd:ng sd:ng]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("7@2 ~ 10  7@2 3 <10 7 3 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:gr").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ 12 ~ 7  ~ 12 ~ 3").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<E2:minor E2:minor B2:phrygian E2:minor>")
  .s("dr:rd").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
