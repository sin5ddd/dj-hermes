// @title dubstep-18
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd ~ ~ ~ bd ~ sd:ng ~, hh*16, <~ ~ ~ [bd sd:ng bd sd:ng]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("7@2 ~ 10  7@2 3 <10 7 3 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:dp").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ 12 ~ 7  ~ 12 ~ 3").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<A2:minor A2:minor E3:phrygian A2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
