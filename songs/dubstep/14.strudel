// @title dubstep-14
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd ~ ~ ~ bd ~ sd:ng ~, hh*16, <~ ~ ~ [bd sd:ng bd sd:ng]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:wb")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("pf:fo").cut(1).gain(0.12).room(0.25).orbit(2)
