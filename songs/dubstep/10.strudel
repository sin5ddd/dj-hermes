// @title dubstep-10
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd ~ ~ ~ bd ~ sd ~, hh*8, <~ ~ ~ [bd sd bd sd]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<B2:minor B2:minor F#3:phrygian B2:minor>")
  .s("sawtooth").lpf(sine.rangex(80, 600)).lpq(6).gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("sawtooth").fm(4).fmh(1).fmdec(0.25).fmsus(0.2)
  .lpf(800).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("pf:ff").gain(0.12).room(0.25).orbit(2)
