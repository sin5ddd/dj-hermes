// @title dubstep-16
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd ~ ~ ~ bd ~ sd ~, hh*16, <~ ~ ~ [bd sd bd sd]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("sawtooth").lpf(sine.rangex(80, 600)).lpq(6).gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("sawtooth").fm(4).fmh(1).fmdec(0.25).fmsus(0.2)
  .lpf(800).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("square").lpf(2400).gain(0.1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("triangle").lpf(900).gain(0.16)
// pad
$: note("[0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("wt_organ").lpf(700).gain(0.12).room(0.25).orbit(2)
  .attack(0.08).release(0.3)
