// @title dubstep-12
// @genre dubstep
// @details gabber half-time, 808-sub + neuro pluck @ 140
setcpm(140/4)
// drums
$: s("bd:gb ~ ~ ~, [~ ~ sd:gb ~], hh:ns*4").gain(0.5)
// bass
$: note("5 ~ 0 3").scale("C4:minor").s("bs:8s").gain(0.46)
// lead
$: note("5 2 ~ 7").scale("C4:minor").s("plk:nn").gain(0.2).cut(1)
