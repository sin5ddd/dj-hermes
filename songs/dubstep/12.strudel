// @title dubstep-12
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd:ng ~ ~ ~ bd:ng ~ sd:ng ~, hh:dk*16, <~ ~ ~ [bd:ng sd:ng bd:ng sd:ng]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ld:dp").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:s5").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<D2:minor D2:minor A2:phrygian D2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
