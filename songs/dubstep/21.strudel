// @title dubstep-21
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd:ng ~ ~ ~ bd:ng ~ sd ~, hh*8, <~ ~ ~ [bd:ng sd bd:ng sd]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<C4:minor C4:minor G4:phrygian C4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("7@2 ~ 10  7@2 3 <10 7 3 7>").scale("<C4:minor C4:minor G4:phrygian C4:minor>")
  .s("ld:dp").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<C4:minor C4:minor G4:phrygian C4:minor>")
  .s("plk:nn").gain(0.18).cut(1)
// arp
$: note("~ 12 ~ 7  ~ 12 ~ 3").scale("<C4:minor C4:minor G4:phrygian C4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<C4:minor C4:minor G4:phrygian C4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("0").scale("<C2:minor C2:minor G2:phrygian C2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
