// @title dubstep-19
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd ~ ~ ~ bd ~ sd ~, hh:dk*16, <~ ~ ~ [bd sd bd sd]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ld:gr")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:nn").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("dr:rd").cut(1).gain(0.12).room(0.25).orbit(2)
