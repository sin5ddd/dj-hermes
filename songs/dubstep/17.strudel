// @title dubstep-17
// @genre dubstep
setcpm(140/4)
// drums
$: s("bd:ng ~ ~ ~ bd:ng ~ sd ~, hh*16, <~ ~ ~ [bd:ng sd bd:ng sd]>").gain(0.72)
// bass
$: note("0 0 3 <0 0 3 -1>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("bs:wb").gain(0.5)
// lead
$: note("~ 7 ~ <10 7 3 7>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("ld:wb")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:nn").gain(0.18).cut(1)
// arp
$: note("~ ~ 12 ~").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:dt").gain(0.1).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("pf:fo").cut(1).gain(0.12).room(0.25).orbit(2)
