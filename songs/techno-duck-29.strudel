// @title floor-amen
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:hf*4").gain(0.89).duckorbit(2).duckattack(0.046).duckdepth(0.90)
// hats
$: s("[~ hh:hs]*4").gain(0.34)
// bass
$: note("3 7 0 3").scale("C4:minor").s("bs:sb").orbit(2).gain(0.32)
// lead
$: note("2 5 ~ 0  7 ~ 3 2").scale("C4:minor").s("ep:ky").orbit(2).gain(0.30)
