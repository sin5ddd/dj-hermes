// @title future-bass-26
// @genre future-bass
// @details thud, growl + major stack @ 140
setcpm(140/4)
// drums
$: s("bd:tc*4, [~ sd:pp]*2, [~ hh:pd]*4").gain(0.48)
// bass
$: note("2 7 0 ~").scale("C4:major").s("bs:gr").gain(0.38)
// lead
$: note("~ 2 [0,2,4] 7").scale("C4:major").s("plk:sm").gain(0.22).cut(1)
