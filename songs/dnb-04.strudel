// @title dnb-04
// @genre drum and bass
// @details amen, bs:sb + tight plk:dt hook @ 174
setcpm(174/4)
// drums
$: s("[bd:dn sd:dn ~ sd:dn bd:dn ~ bd:dn sd:dn, hh:dn*4]*2").gain(0.68).lpf(4000)
// bass
$: note("0 0 -1 0").scale("C4:minor").s("bs:sb").gain(0.44)
// lead
$: note("4 ~ 7 0").scale("C4:minor").s("plk:dt").gain(0.22).cut(1)
