// @title electro-03
// @genre electro
// @details brighter electro: open hats, bass lpf 900 @ 128
setcpm(128/4)
// drums
$: s("bd:ez*4, [~ sd:9s]*2, hh:cl*8, [~ oh:op]*2").gain(0.56)
// bass
$: note("0 3 5 3 0 7 5 0").scale("C2:minor").s("sawtooth").lpf(900).gain(0.46)
  .attack(0.001).decay(0.07).sustain(0.22).release(0.04)
