// @title dnb-reese-03
// @genre drum and bass
// @details darker kit on the mid-Reese break @ 174
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dk*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(2500)
// sub
$: note("0 3 0 <0 -1>").scale("C2:minor").s("square").lpf(120).gain(0.42)
// mid
$: note("0 3 0 <0 -1>").scale("C4:minor").s("bs:rm").gain(0.36)
// stab
$: note("~ 4 ~ <7 4>").scale("C4:minor").s("plk:s5").gain(0.18).cut(1)
