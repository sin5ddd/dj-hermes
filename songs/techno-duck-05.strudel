// @title hf-pump
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:9p*4").gain(0.9).duckorbit(2).duckattack(0.03).duckdepth(0.9)
// hats
$: s("hh*8").gain(0.28)
// bass
$: note("0 0 2 0").scale("C4:minor").s("bs:hf").orbit(2).gain(0.38)
// pad
$: note("4 2 0 2").scale("C3:minor")
  .s("sawtooth").lpf(780).orbit(2).gain(0.26)
  .attack(0.05).sustain(0.6).release(0.2)
