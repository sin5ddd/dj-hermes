// @title deep-snap
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.92).duckorbit(2).duckattack(0.03).duckdepth(0.95)
// hats
$: s("[~ hh]*4").gain(0.36)
// bass
$: note("0 0 0 2").scale("C2:minor")
  .s("sine").fm(3).fmh(1).lpf(380).gain(0.52)
  .attack(0.004).decay(0.09).sustain(0.28).release(0.07)
  .orbit(2)
// pad
$: note("0 2 4 7").scale("C3:minor")
  .s("sawtooth").lpf(750).orbit(2).gain(0.3)
  .attack(0.04).sustain(0.62).release(0.18)
