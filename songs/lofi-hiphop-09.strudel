// @title lofi-hiphop-09
// @genre lofi-hiphop
// @details dusty kit + chords + fx:up once per 4 bars
setcpm(80/4)
// drums
$: s("bd:lf ~ ~ sd, [~ hh]*4").gain(0.44)
// chords
$: note("[0,2,4] ~ [0,3,5] ~").scale("C3:minor").s("triangle").lpf(1100).gain(0.32)
  .attack(0.05).release(0.3).room(0.3).orbit(1)
// bass
$: note("0 ~ 2 ~").scale("C2:minor").s("sine").lpf(300).gain(0.42)
// fx
$: s("<fx:up ~ ~ ~>").gain(0.22)
