// @title future-bass-16
// @genre future-bass
// @details hardstyle, hoover + future glass add9 @ 140
setcpm(140/4)
// drums
$: s("bd:hs*4, [~ sd:9s]*2, [~ hh:fc]*4").gain(0.46)
// bass
$: note("7 0 4 ~").scale("C4:major").s("bs:hv").gain(0.36)
// lead
$: note("[0,4,9] ~ 4 9").scale("C4:major").s("plk:fg").gain(0.2).cut(1)
