// @title future-bass-30
// @genre future-bass
// @details fm-noise, supersaw + major stab 2/7/9 @ 140
setcpm(140/4)
// drums
$: s("bd:fn*4, [~ sd:tr]*2, hh:ch*8").gain(0.46)
// bass
$: note("7 2 ~ 4").scale("C4:major").s("bs:sw").gain(0.38)
// lead
$: note("2 ~ 7 9").scale("C4:major").s("plk:s3").gain(0.22).cut(1)
