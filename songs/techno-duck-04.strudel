// @title split-orbits
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd*4").gain(0.9).duckorbit("2:3").duckattack(0.04).duckdepth(0.85)
// hats
$: s("[~ hh]*4").gain(0.38)
// bass
$: note("0 0 2 <4 6>").scale("C2:minor")
  .s("sine").fm(3).fmh(1).fmdec(0.25).fmsus(0.2).lpf(420).gain(0.52)
  .attack(0.005).decay(0.1).sustain(0.3).release(0.08)
  .orbit(2)
// pad
$: note("0 2 4 7").scale("C3:minor")
  .s("sawtooth").lpf(1000).orbit(3).gain(0.32)
  .attack(0.05).decay(0.2).sustain(0.6).release(0.2)
