// @title floor-drop
// @genre four-on-the-floor
setcpm(124/4)
// drums
$: s("bd:tc*4, hh*8").gain(0.64)
// bass
$: note("0 0 2 4").scale("C2:minor").s("sawtooth").lpf(420).gain(0.48)
  .attack(0.004).decay(0.08).sustain(0.25).release(0.06)
// pad
$: note("0 2 4 7").scale("C3:minor").s("triangle").lpf(900).attack(0.08).sustain(0.55).release(0.2).gain(0.2)
