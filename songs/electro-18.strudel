// @title electro-18
// @genre electro
// @details dust four, supersaw + soft rhodes @ 126
setcpm(126/4)
// drums
$: s("bd:lf*4, [~ sd:br]*2, [~ hh:dk]*4").gain(0.48)
// bass
$: note("2 0 7 0 5 2 0 3").scale("C4:minor").s("bs:sw").gain(0.38)
// lead
$: note("12 ~ 7 5").scale("C4:minor").s("ep:rs").gain(0.22).cut(1)
