// @title floor-pcm-duck
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:hf*4").gain(0.88).duckorbit(2).duckattack(0.04).duckdepth(0.84)
// hats
$: s("[~ hh]*4").gain(0.38)
// bass
$: note("0 0 4 0").scale("C4:minor").s("bs:hf").orbit(2).gain(0.4)
// pad
$: note("0 2 4 7").scale("C3:minor")
  .s("sawtooth").lpf(880).orbit(2).gain(0.3)
  .attack(0.05).sustain(0.6).release(0.2)
