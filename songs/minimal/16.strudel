// @title minimal-16
// @genre minimal
setcpm(126/4)
// drums
$: s("bd:tc*4, <[~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 [~ oh ~ ~]*2 ~ ~ [~ oh ~ ~]*2 [~ oh ~ ~]*2>, <~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp>").gain(0.7)
// bass
$: note("<~ ~ ~ ~ [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~]>").scale("<G2:minor G2:minor G2:minor D3:phrygian>")
  .s("sawtooth").lpf(320).gain(0.4)
// lead
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] ~ ~ ~ ~>").scale("<G4:minor G4:minor G4:minor D5:phrygian>")
  .s("plk:ac").gain(0.1).cut(1)
// hook
$: note("<~ ~ ~ ~ [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] ~ ~ [~ 4 ~ ~] [~ 4 ~ ~]>").scale("<G4:minor G4:minor G4:minor D5:phrygian>")
  .s("plk:pk").gain(0.12).cut(1)
// arp
$: s("<~ perc:tk ~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ perc:st ~ ~ ~ perc:tk>").gain(0.12)
// chords
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] ~ ~>").scale("<G4:minor G4:minor G4:minor D5:phrygian>")
  .s("ep:mt").gain(0.14)
// pad
$: note("<~ ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<G4:minor G4:minor G4:minor D5:phrygian>")
  .s("pf:pu").orbit(2).cut(1).gain(0.1).room(0.25)
// fx
$: s("<~ ~ ~ fx:nh ~ ~ fx:ry ~ fx:mc ~ ~ ~ fx:sd ~ ~ fx:dn>").gain(0.18).cut(1)
