// @title dnb-08
// @genre drum and bass
// @details amen + quiet square stab @ 174
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(4000)
// sub
$: note("0 3 0 <0 -1>").scale("C2:minor").s("square").lpf(120).gain(0.42)
  .attack(0.01).decay(0.5).release(0.4)
// mid
$: note("0 3 0 <0 -1>").scale("C2:minor").s("sawtooth").lpf(1000).gain(0.36)
  .attack(0.01).decay(0.4).release(0.3)
// stab
$: note("~ 4 ~ <7 9>").scale("C3:minor").s("square").lpf(2000).gain(0.15)
