// @title chill-03
// @genre chill
// @details dark Reese (bs:dk only sub) + close triangle chords
setcpm(100/4)
// drums
$: s("bd ~ ~ sd").gain(0.4)
// bass
$: note("0 3 0 <0 -1>").scale("C4:minor").s("bs:dk").gain(0.32)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("C3:minor").s("triangle").lpf(1000).gain(0.22)
