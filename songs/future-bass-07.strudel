// @title future-bass-07
// @genre future-bass
// @details hollow fifth pad pf:ff as 0 ~ 0 ~ (not a triad) @ 142
setcpm(142/4)
// drums
$: s("bd:hf*4, [~ sd:hd]*2, [~ hh:hs]*4").gain(0.5)
// pad
$: note("0 ~ 0 ~").scale("C4:minor").s("pf:ff").gain(0.22)
// lead
$: note("7 9 7 <11 12>").scale("C4:minor").s("square").lpf(2600).gain(0.15)
// sub
$: note("0 ~ 0 ~").scale("C4:minor").s("bs:su").gain(0.48)
