// @title future-bass-29
// @genre future-bass
// @details hardstyle, hoover + add9 chime run @ 140
setcpm(140/4)
// drums
$: s("bd:hs*4, [~ sd:cs]*2, [~ hh:fc]*4").gain(0.46)
// bass
$: note("0 9 ~ 4").scale("C4:major").s("bs:hv").gain(0.36)
// lead
$: note("[0,4,9] 7 2 9").scale("C4:major").s("plk:ch").gain(0.18).cut(1)
