// @title future-bass-17
// @genre future-bass
// @details frenchcore, acid + major stack walk @ 140
setcpm(140/4)
// drums
$: s("bd:fc*4, [~ sd:fc]*2, hh:hs*8").gain(0.48)
// bass
$: note("0 ~ 2 7").scale("C4:major").s("bs:ac").gain(0.4)
// lead
$: note("2 [0,2,4] 0 4").scale("C4:major").s("plk:sm").gain(0.22).cut(1)
