// @title dubstep-02
// @genre dubstep
// @details darker wobble (rangex 60–280) @ 140
setcpm(140/4)
// drums
$: s("bd:tc ~ ~ ~, [~ ~ sd:ng ~], hh:dk*4").gain(0.56)
// wobble
$: note("0 0 ~ -1").scale("C2:minor").s("sawtooth").lpf(sine.rangex(60, 280)).lpq(8).gain(0.5)
  .attack(0.012).decay(0.22).sustain(0.35).release(0.12)
