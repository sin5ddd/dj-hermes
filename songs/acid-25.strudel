// @title alt-slide
// @genre acid
setcpm(130/4)
// drums
$: s("bd:01*4, [~ hh:ch]*4").gain(0.58)
// bass
$: note("4 0 2 7  0 5 3 0  7 2 5 0  3 -1 4 <2 0>")
  .scale("C2:minor")
  .s("sawtooth")
  .lpf("250 720 250 250  250 760 250 250  250 250 700 250  780 250 250 250")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("5 ~ ~ 2").scale("C4:minor").s("ld:ss").gain(0.14)
