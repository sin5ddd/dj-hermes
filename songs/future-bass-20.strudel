// @title future-bass-20
// @genre future-bass
// @details neuro four, growl-2 + add9 mallet @ 140
setcpm(140/4)
// drums
$: s("bd:ng*4, [~ sd:tr]*2, hh:tt*8").gain(0.46)
// bass
$: note("2 0 ~ 5").scale("C4:major").s("bs:g2").gain(0.38)
// lead
$: note("7 [0,4,9] 2 ~").scale("C4:major").s("plk:mb").gain(0.2).cut(1)
