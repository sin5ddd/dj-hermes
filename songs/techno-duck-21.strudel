// @title neuro-pump
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:ng*4").gain(0.85).duckorbit(2).duckattack(0.034).duckdepth(0.86)
// hats
$: s("[~ hh:hs]*4").gain(0.28)
// bass
$: note("0 2 7 0").scale("C4:minor").s("bs:gr").orbit(2).gain(0.32)
// pad
$: note("2 ~ 8 ~").scale("C4:minor").s("pf:ff").orbit(2).gain(0.20)
