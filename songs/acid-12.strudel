// @title square-twist
// @genre acid
setcpm(130/4)
// drums
$: s("bd:8b*4, hh*8").gain(0.60)
// bass
$: note("5 3 0 2  7 0 3 5  0 4 2 0  -1 5 3 <2 7>")
  .scale("C2:minor")
  .s("square")
  .lpf("250 250 250 710  250 750 250 250  680 250 250 730  250 250 780 250")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// fx
$: s("<fx:nr ~ ~ ~>").gain(0.22)
