// @title core-side
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:fc*4").gain(0.88).duckorbit(2).duckattack(0.042).duckdepth(0.90)
// hats
$: s("[~ hh:fc]*4").gain(0.32)
// bass
$: note("0 7 5 3").scale("C4:minor").s("bs:fc").orbit(2).gain(0.36)
// lead
$: note("7 3 ~ 0  2 5 ~ 7").scale("C4:minor").s("plk:cv").orbit(2).gain(0.30).cut(1)
