// @title punch-hold
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:9p*4").gain(0.88).duckorbit(2).duckattack(0.04).duckdepth(0.84)
// hats
$: s("[~ hh]*4").gain(0.38)
// bass
$: note("0 2 0 4").scale("C2:minor")
  .s("sawtooth").fm(3).fmh(1).fmdec(0.25).fmsus(0.2).lpf(420).gain(0.46)
  .orbit(2)
// lead
$: note("0 ~ ~ ~").scale("C4:minor").s("ld:ss").orbit(2).gain(0.18)
