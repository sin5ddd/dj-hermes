// @title pump-bright
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd*4").gain(0.88).duckorbit(2).duckattack(0.035).duckdepth(0.82)
// hats
$: s("[~ hh]*4").gain(0.42)
// bass
$: note("0 2 4 0").scale("C3:major")
  .s("sawtooth").fm(3).fmh(2).fmdec(0.28).fmsus(0.22).lpf(900).gain(0.4)
  .attack(0.005).decay(0.1).sustain(0.3).release(0.08)
  .orbit(2)
// pad
$: note("[0,4,9] ~ [0,4,9] ~").scale("C3:major")
  .s("triangle").lpf(1500).orbit(2).gain(0.3)
  .attack(0.05).sustain(0.55).release(0.18)
