// @title clockwork
// @by strudel-rs
// @details clock ticks, toms, wurli, marimba @ 96
setcpm(96/4)
// drums
$: s("bd:lf ~ ~ ~, perc:tk*8, [~ tom:md ~ tom:lo]").gain(0.36)
// keys
$: note("[0,2,4] ~ [2,4,6] ~").scale("C4:mixolydian").s("ep:wr").gain(0.16)
  .attack(0.005).decay(0.25).sustain(0.2).release(0.22).room(0.24).orbit(1)
// lead
$: note("4 2 0 2  6 <4 7> 2 0").scale("C4:mixolydian").s("plk:mm").gain(0.2).cut(1)
// fx
$: s("<~ ~ ~ fx:ts>").gain(0.2)
