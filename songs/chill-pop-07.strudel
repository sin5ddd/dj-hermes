// @title chill-pop-07
// @genre chill-pop
// @details click kick + hoover bass + monophonic plk:lp
setcpm(100/4)
// drums
$: s("bd:ck*4, [~ sd]*2, [~ hh]*4").gain(0.5)
// bass
$: note("0 4 0 2").scale("C4:major").s("bs:hv").gain(0.36)
// lead
$: note("2 0 4 7").scale("C4:major").s("plk:lp").gain(0.28).cut(1)
