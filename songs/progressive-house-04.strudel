// @title organ-bed
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd*4, [~ cp]*2, [~ hh:cl]*4").gain(0.55)
// bass
$: note("0 ~ 0 ~").scale("C4:minor").s("bs:su").gain(0.32)
// pad
$: note("0 2 4 7").scale("C3:minor").s("wt_organ").lpf(1000).attack(0.12).sustain(0.6).release(0.3).gain(0.22).room(0.4)
