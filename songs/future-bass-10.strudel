// @title future-bass-10
// @genre future-bass
// @details 150 drop-adjacent + fx:up once per 4 bars
setcpm(150/4)
// drums
$: s("bd:hf ~ bd:hf ~, [~ sd:hd]*2, [~ hh:hs]*4").gain(0.5)
// chords
$: note("[0,2,4] ~ [0,3,5] ~").scale("C3:minor").s("sawtooth").lpf(1600).gain(0.26)
  .attack(0.02).decay(0.2).sustain(0.4).release(0.14)
// lead
$: note("7 4 <12 11> 9").scale("C4:minor").s("square").lpf(3000).gain(0.15)
// sub
$: note("0 ~ 0 ~").scale("C4:minor").s("bs:su").gain(0.48)
// fx
$: s("<fx:up ~ ~ ~>").gain(0.24)
