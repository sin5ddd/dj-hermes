// @title regular-accent
// @genre acid
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh]*4").gain(0.64)
// bass
$: note("0 3 0 5  0 3 7 0  4 0 3 0  2 0 -1 3")
  .scale("C2:minor")
  .s("sawtooth")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// pad
$: note("0 ~ 4 ~").scale("C3:minor").s("triangle").lpf(700).attack(0.1).sustain(0.55).release(0.25).gain(0.14)
