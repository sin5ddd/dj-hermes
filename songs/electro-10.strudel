// @title electro-10
// @genre electro
// @details 130 electro + fx:up once per 4 bars
setcpm(130/4)
// drums
$: s("bd:ez*4, [~ sd:9s]*2, hh:cl*8").gain(0.5)
// bass
$: note("0 3 0 7 0 5 3 0").scale("C2:minor").s("square").lpf(680).gain(0.46)
  .attack(0.001).decay(0.07).sustain(0.2).release(0.04)
// fx
$: s("<fx:up ~ ~ ~>").gain(0.24)
