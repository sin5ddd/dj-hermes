// @title dnb-reese-08
// @genre drum and bass
// @details jungle roll, square + moving bs:rm @ 174
setcpm(174/4)
// drums
$: s("[bd:jg <~ sd:jg> ~ sd:jg bd:jg ~ <bd:jg sd:jg> ~, hh:dn*4]*2").gain(0.66).lpf(3600)
// bass
$: note("3 0 3 <0 5>").scale("C2:minor").s("square").lpf(120).gain(0.42)
// lead
$: note("3 0 3 <0 5>").scale("C4:minor").s("bs:rm").gain(0.34)
