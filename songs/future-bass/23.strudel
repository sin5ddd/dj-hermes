// @title future-bass-23
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd ~ bd ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh:ch*8, <~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0]>")
  .scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("square").lpf(3200).gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [~ 9 ~ 7] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11] [~ 12 ~ 9] [~ 11 ~ 7] [~ 9 ~ 4] [~ 7 ~ 4] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11]>")
  .scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("plk:mb").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<Eb5:major Bb5:mixolydian C6:minor Ab5:lydian Eb5:major Bb5:mixolydian C6:minor Ab5:lydian Ab5:lydian C6:minor Bb5:mixolydian Eb5:major Eb5:major D6:locrian C6:minor Bb5:mixolydian>")
  .s("plk:fc").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("plk:sm").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("pf:sp").cut(1).gain(0.14).room(0.3).orbit(2)
// strings
$: note("<0 ~ ~ ~>").scale("<Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Eb4:major Bb4:mixolydian C5:minor Ab4:lydian Ab4:lydian C5:minor Bb4:mixolydian Eb4:major Eb4:major D5:locrian C5:minor Bb4:mixolydian>")
  .s("pf:hl").cut(1).gain(0.12).room(0.45).orbit(2)
