// @title future-bass-14
// @genre future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, [~ hh:hs]*4").gain(0.42)
// bass
$: note("<[0 7 0 0  4 0 ~ 7] [0 0 4 7  0 ~ 2 0] [0 4 0 ~  7 0 4 0] [0 ~ 7 4  0 0 7 2] [0 0 0 4  7 ~ 0 4] [0 7 ~ 4  0 4 0 7] [0 4 7 0  ~ 0 2 7] [0 0 ~ 7  4 0 0 4]>")
  .scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("bs:8s").gain(0.42).cut(1).orbit(2)
// lead
$: note("<[4 ~ ~ 7  9 ~ 4 2] [~ 7 ~ 9  4 7 ~ 2] [9 4 ~ 7  ~ 2 0 4] [~ 4 9 7  2 ~ 4 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4] [~ 11 7 4  9 2 ~ 4] [11 4 ~ 7  ~ 2 0 4] [7 ~ 4 2  0 4 7 ~] [4 2 ~ 0  7 ~ 4 9] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4]>")
  .scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("ld:st").gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 7  ~ 12 ~ 9] [11 ~ 9 7  ~ 4 ~ 11] [~ 12 7 11  9 ~ 7 4] [7 ~ 11 12  ~ 9 4 2] [11 12 7 9  12 11 7 4] [~ 12 ~ 9  11 7 ~ 4] [12 9 ~ 11  7 12 9 7] [11 7 12 9  7 4 2 0] [~ 9 ~ 12  ~ 4 ~ 7] [12 ~ 7 4  ~ 0 ~ 11] [~ 4 ~ 9  7 ~ 2 0] [9 4 ~ 0  ~ 7 4 2] [11 12 7 9  12 11 7 4] [~ 12 ~ 9  11 7 ~ 4] [12 9 ~ 11  7 12 9 7] [11 7 12 9  7 4 2 0]>")
  .scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("ld:an").gain(0.18).cut(1)
// arp
$: note("<[0 ~ ~ ~  ~ ~ 4 ~] [~ 0 ~ ~  4 ~ ~ ~] [~ ~ 0 ~  ~ 4 ~ ~] [4 ~ ~ 0  ~ ~ ~ 7] [0 ~ 4 ~  ~ ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~] [~ 0 ~ ~  ~ ~ 4 ~] [0 ~ ~ 4  ~ ~ 0 ~]>")
  .scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[[0,4,8] ~ [0,4,8] ~  [0,2,8] ~ ~ [0,4,8]] [[0,4,8] [0,4,8] ~ [0,2,8]  ~ [0,4,8] ~ ~] [[0,2,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,2,8] ~  [0,4,8] [0,4,8] ~ ~]>")
  .scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~ 0 ~ ~>").scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("pf:ff").gain(0.14).room(0.25).orbit(2)
// strings
$: note("<~ 0 ~ ~ ~ ~ 0 ~ ~ ~ 0 ~ ~ ~ ~ 0>").scale("<E4:major B4:mixolydian C#5:minor A4:lydian C#5:minor A4:lydian E4:major B4:mixolydian C#5:minor B4:mixolydian A4:lydian Ab4:phrygian C#5:minor A4:lydian E4:major B4:mixolydian>")
  .s("dr:rw").gain(0.12).orbit(2)
