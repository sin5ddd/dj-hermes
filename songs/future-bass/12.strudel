// @title future-bass-12
// @genre future-bass
// @details 808 boom, 808-sub + major stab 0/4/7 @ 140
setcpm(140/4)
// drums
$: s("bd:8b*4, [~ sd:8s]*2, hh:tt*8").gain(0.48)
// bass
$: note("4 0 ~ 7").scale("C4:major").s("bs:8s").gain(0.46)
// lead
$: note("0 4 ~ 7").scale("C4:major").s("plk:s3").gain(0.22).cut(1)
