// @title future-bass-12
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd:8t ~ bd:8t ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:ch*8, <~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [~ 9 ~ 7] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11] [~ 12 ~ 9] [~ 11 ~ 7] [~ 9 ~ 4] [~ 7 ~ 4] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<B5:minor G5:lydian A5:mixolydian D5:major B5:minor G5:lydian A5:mixolydian D5:major D5:major A5:mixolydian G5:lydian B5:minor D5:major C#6:locrian B5:minor A5:mixolydian>")
  .s("plk:fg").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("ps:gb").cut(1).gain(0.14).room(0.3).orbit(2)
// strings
$: note("<0 ~ ~ ~>").scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("pf:wm").cut(1).gain(0.12).room(0.45).orbit(2)
