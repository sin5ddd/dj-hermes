// @title future-bass-20
// @genre future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ bd:8d ~] [bd:8d ~ ~ ~] [bd:8d ~ bd:8d ~] [bd:8d ~ ~ bd:8d]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh:ch*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]]>").gain(0.42)
// bass
$: note("<[0 4 0 7  0 ~ 4 0] [0 0 7 4  0 2 ~ 0] [0 7 ~ 0  4 0 7 4] [0 0 0 7  4 ~ 0 2] [0 4 ~ 7  0 0 4 7] [0 7 0 4  ~ 2 0 0] [0 0 4 ~  7 0 4 0] [0 ~ 0 7  4 2 0 7]>")
  .scale("<Ab5:minor E5:lydian B4:major F#5:mixolydian B4:major F#5:mixolydian Ab5:minor E5:lydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor F#5:mixolydian E5:lydian Eb5:phrygian>")
  .s("bs:ht").gain(0.42).cut(1).orbit(2)
// lead
$: note("<[7 ~ 4 ~  9 4 ~ 2] [~ 4 7 2  9 ~ 4 7] [4 9 ~ 7  ~ 2 4 0] [~ 7 4 9  2 0 ~ 4] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7] [~ 4 9 7  11 4 ~ 2] [4 11 ~ 7  9 2 0 ~] [~ 7 11 4  2 0 4 7] [11 7 4 2  ~ 0 4 9] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7]>")
  .scale("<Ab5:minor E5:lydian B4:major F#5:mixolydian B4:major F#5:mixolydian Ab5:minor E5:lydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor F#5:mixolydian E5:lydian Eb5:phrygian>")
  .s("ld:us").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 12 ~ 7  11 ~ 9 4] [12 7 ~ 11  ~ 9 7 2] [~ 7 12 9  11 4 ~ 7] [9 ~ 11 7  12 4 2 0] [12 11 9 7  11 12 7 9] [~ 9 12 11  7 4 9 7] [11 7 ~ 12  9 7 4 2] [12 9 11 7  4 2 0 7] [~ 4 12 9  ~ 7 0 4] [9 ~ 7 2  0 4 ~ 11] [~ 2 9 4  7 0 2 ~] [4 0 ~ 7  2 4 0 9] [12 11 9 7  11 12 7 9] [~ 9 12 11  7 4 9 7] [11 7 ~ 12  9 7 4 2] [12 9 11 7  4 2 0 7]>")
  .scale("<Ab5:minor E5:lydian B4:major F#5:mixolydian B4:major F#5:mixolydian Ab5:minor E5:lydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor F#5:mixolydian E5:lydian Eb5:phrygian>")
  .s("ld:st").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.18)
// arp
$: note("<[~ 0 ~ 4  ~ ~ ~ ~] [0 ~ ~ ~  ~ ~ 4 ~] [~ ~ 0 4  ~ ~ ~ ~] [~ 4 ~ ~  ~ 0 ~ ~] [0 ~ ~ 4  ~ ~ ~ 7] [~ ~ 0 ~  ~ ~ ~ 4] [4 ~ ~ ~  0 ~ ~ ~] [~ 0 ~ ~  4 ~ ~ 0]>")
  .scale("<Ab5:minor E5:lydian B4:major F#5:mixolydian B4:major F#5:mixolydian Ab5:minor E5:lydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor F#5:mixolydian E5:lydian Eb5:phrygian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[~ [0,4,8] ~ [0,4,8]  [0,2,8] ~ [0,4,8] ~] [[0,4,8] ~ ~ [0,2,8]  [0,4,8] ~ [0,2,8] [0,4,8]] [~ [0,2,8] [0,4,8] ~  [0,4,8] ~ ~ [0,2,8]] [[0,4,8] ~ [0,4,8] ~  ~ [0,2,8] [0,4,8] ~]>")
  .scale("<Ab5:minor E5:lydian B4:major F#5:mixolydian B4:major F#5:mixolydian Ab5:minor E5:lydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor F#5:mixolydian E5:lydian Eb5:phrygian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<~ 0 ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~ 0>").scale("<Ab3:minor E3:lydian B2:major F#3:mixolydian B2:major F#3:mixolydian Ab3:minor E3:lydian Ab3:minor E3:lydian B2:major F#3:mixolydian Ab3:minor F#3:mixolydian E3:lydian Eb3:phrygian>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.25).orbit(2)
// strings
$: note("<0 ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~>").scale("<Ab3:minor E3:lydian B2:major F#3:mixolydian B2:major F#3:mixolydian Ab3:minor E3:lydian Ab3:minor E3:lydian B2:major F#3:mixolydian Ab3:minor F#3:mixolydian E3:lydian Eb3:phrygian>")
  .s("dr:rw").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).orbit(2)
