// @title future-bass-09
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd:8t ~ bd:8t ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh*8, <~ ~ ~ [hh*16] ~ ~ ~ [hh*16] ~ ~ ~ [hh*16] ~ ~ ~ [hh*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ld:st").gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [~ 9 ~ 7] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11] [~ 12 ~ 9] [~ 11 ~ 7] [~ 9 ~ 4] [~ 7 ~ 4] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("plk:ch").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<Eb6:lydian F6:mixolydian D6:phrygian G6:minor Eb6:lydian F6:mixolydian D6:phrygian G6:minor G6:minor D6:phrygian F6:mixolydian Eb6:lydian Bb5:major A6:locrian G6:minor F6:mixolydian>")
  .s("plk:fc").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("plk:sm").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("pf:ga").cut(1).gain(0.14).room(0.3).orbit(2)
// strings
$: note("<0 ~ ~ ~>").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ld:cr").cut(1).gain(0.12).room(0.45).orbit(2)
