// @title future-bass-09
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd ~ bd ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh*8, <~ ~ ~ [hh*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("4@2 7 9@2  7 4 <2 0> ~").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("~ 11 ~ 12  ~ 9 ~ <11 12>").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("plk:fg").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("sawtooth").lpf(1800).gain(0.22).orbit(2)
  .attack(0.02).decay(0.2).sustain(0.4).release(0.15)
// pad
$: note("[0,4]").scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor>")
  .s("sine").fm(1.2).fmh(1).fmdec(0.8).fmsus(0.4)
  .room(0.3).orbit(2).gain(0.14)
