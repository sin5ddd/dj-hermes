// @title future-bass-26
// @genre future-bass
setcpm(140/4)
// kick
$: s("<[bd ~ ~ ~] [bd ~ ~ ~] [bd [~ bd] ~ ~] [bd ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, [~ hh]*4").gain(0.42)
// bass
$: note("<[0 0 7 0  4 ~ 0 7] [0 ~ 0 4  7 0 ~ 4] [0 4 ~ 0  7 ~ 0 4] [0 0 4 7  ~ 0 2 0] [0 7 0 ~  4 0 7 4] [0 0 ~ 7  4 0 0 2] [0 ~ 4 0  7 4 ~ 0] [0 4 7 0  2 ~ 0 7]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major E5:minor D5:mixolydian C5:lydian B4:phrygian>")
  .s("bs:sw").gain(0.42).cut(1).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 7 4] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 7 ~ 11] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4] [9@2 4 7@2 2 0 4] [~ 7 9 2  4 0 ~ 7] [4@2 2 0@2 7 4 2] [~ 2 0 4  7 4 9 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major E5:minor D5:mixolydian C5:lydian B4:phrygian>")
  .s("ld:st").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 11 ~ 7  ~ 12 ~ 9] [11 ~ 9 7  ~ 4 ~ 11] [~ 12 7 11  9 ~ 7 4] [7 ~ 11 12  ~ 9 4 2] [11 12 7 9  12 11 7 4] [~ 12 ~ 9  11 7 ~ 4] [12 9 ~ 11  7 12 9 7] [11 7 12 9  7 4 2 0] [~ 9 ~ 12  ~ 4 ~ 7] [12 ~ 7 4  ~ 0 ~ 11] [~ 4 ~ 9  7 ~ 2 0] [9 4 ~ 0  ~ 7 4 2] [11 12 7 9  12 11 7 4] [~ 12 ~ 9  11 7 ~ 4] [12 9 ~ 11  7 12 9 7] [11 7 12 9  7 4 2 0]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major E5:minor D5:mixolydian C5:lydian B4:phrygian>")
  .s("ld:an").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.18)
// arp
$: note("<[0 ~ ~ ~  ~ ~ 4 ~] [~ 0 ~ ~  4 ~ ~ ~] [~ ~ 0 ~  ~ 4 ~ ~] [4 ~ ~ 0  ~ ~ ~ 7] [0 ~ 4 ~  ~ ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~] [~ 0 ~ ~  ~ ~ 4 ~] [0 ~ ~ 4  ~ ~ 0 ~]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major E5:minor D5:mixolydian C5:lydian B4:phrygian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[[0,4,8] ~ [0,4,8] ~  [0,2,8] ~ ~ [0,4,8]] [[0,4,8] [0,4,8] ~ [0,2,8]  ~ [0,4,8] ~ ~] [[0,2,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,2,8] ~  [0,4,8] [0,4,8] ~ ~]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major E5:minor D5:mixolydian C5:lydian B4:phrygian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~ 0 ~ ~>").scale("<G2:major D3:mixolydian E3:minor C3:lydian G2:major D3:mixolydian E3:minor C3:lydian C3:lydian E3:minor D3:mixolydian G2:major E3:minor D3:mixolydian C3:lydian B2:phrygian>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.25).orbit(2)
// strings
$: note("<~ 0 ~ ~ ~ ~ 0 ~ ~ ~ 0 ~ ~ ~ ~ 0>").scale("<G2:major D3:mixolydian E3:minor C3:lydian G2:major D3:mixolydian E3:minor C3:lydian C3:lydian E3:minor D3:mixolydian G2:major E3:minor D3:mixolydian C3:lydian B2:phrygian>")
  .s("dr:rw").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).orbit(2)
