// @title future-bass-02
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd ~ bd ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh*8, <~ ~ ~ [hh*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("4@2 7 9@2  7 4 <2 0> ~").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("ld:mx").gain(0.16).cut(1)
// hook
$: note("~ 11 ~ 12  ~ 9 ~ <11 12>").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("plk:bl").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("plk:fg").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<G4:lydian A4:mixolydian F#4:phrygian B4:minor>")
  .s("ps:gb").cut(1).gain(0.14).room(0.3).orbit(2)
