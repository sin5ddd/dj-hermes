// @title future-bass-24
// @genre future-bass
// @details floor, bright-reese + glass add9 @ 140
setcpm(140/4)
// drums
$: s("bd:hf*4, [~ sd:9s]*2, [~ hh:hs]*4").gain(0.46)
// bass
$: note("0 ~ 5 7").scale("C4:major").s("bs:rb").gain(0.36)
// lead
$: note("4 [0,4,9] ~ 2").scale("C4:major").s("plk:fg").gain(0.2).cut(1)
