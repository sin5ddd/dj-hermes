// @title future-bass-15
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd ~ bd ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh:ch*8, <~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0]>")
  .scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("square").lpf(3200).gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [~ 9 ~ 7] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11] [~ 12 ~ 9] [~ 11 ~ 7] [~ 9 ~ 4] [~ 7 ~ 4] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11]>")
  .scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("plk:mb").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<D6:minor Bb5:lydian C6:mixolydian F5:major D6:minor Bb5:lydian C6:mixolydian F5:major F5:major C6:mixolydian Bb5:lydian D6:minor F5:major E6:locrian D6:minor C6:mixolydian>")
  .s("plk:fc").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("plk:sm").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("pf:ff").gain(0.14).room(0.3).orbit(2)
// strings
$: note("<0 ~ ~ ~>").scale("<D5:minor Bb4:lydian C5:mixolydian F4:major D5:minor Bb4:lydian C5:mixolydian F4:major F4:major C5:mixolydian Bb4:lydian D5:minor F4:major E5:locrian D5:minor C5:mixolydian>")
  .s("pf:hl").cut(1).gain(0.12).room(0.45).orbit(2)
