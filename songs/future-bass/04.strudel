// @title future-bass-04
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd:8t ~ bd:8t ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:ch*8, <~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16] ~ ~ ~ [hh:ch*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@2 7 9@2  7 4 2 0] [4@2 7 9@2  7 4 0 2] [4@2 7 9@2  7 4 2 ~] [4@2 7 9@2  7 4 2 0]>")
  .scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("<[~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [~ 9 ~ 7] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11] [~ 12 ~ 9] [~ 11 ~ 7] [~ 9 ~ 4] [~ 7 ~ 4] [~ 11 ~ 12] [~ 9 ~ 11] [~ 11 ~ 12] [11 12 9 11]>")
  .scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<A5:lydian B5:mixolydian Ab5:phrygian C#6:minor A5:lydian B5:mixolydian Ab5:phrygian C#6:minor C#6:minor Ab5:phrygian B5:mixolydian A5:lydian E5:major Eb6:locrian C#6:minor B5:mixolydian>")
  .s("plk:fg").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("pf:ga").cut(1).gain(0.14).room(0.3).orbit(2)
// strings
$: note("<0 ~ ~ ~>").scale("<A4:lydian B4:mixolydian Ab4:phrygian C#5:minor A4:lydian B4:mixolydian Ab4:phrygian C#5:minor C#5:minor Ab4:phrygian B4:mixolydian A4:lydian E4:major Eb5:locrian C#5:minor B4:mixolydian>")
  .s("pf:wm").cut(1).gain(0.12).room(0.45).orbit(2)
