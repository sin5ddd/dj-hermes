// @title future-bass-17
// @genre future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ ~ ~] [bd:8d [~ bd:8d] ~ ~] [bd:8d ~ ~ bd:8d] [bd:8d ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh:ch*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]]>").gain(0.42)
// bass
$: note("<[0 0 ~ 0  0 ~ 7 4] [0 0 0 ~  0 4 ~ 7] [0 ~ 0 0  4 0 7 ~] [0 0 ~ 4  0 ~ 2 7] [0 0 0 0  ~ 0 4 7] [0 ~ 0 4  0 7 ~ 2] [0 0 ~ 0  4 ~ 7 0] [0 4 0 ~  7 0 2 0]>")
  .scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("bs:sw").gain(0.42).cut(1).orbit(2)
// lead
$: note("<[~ 4 ~ 7  ~ 9 4 2] [~ 7 4 9  7 ~ 4 2] [4 ~ 9 7  ~ 4 2 0] [~ 4 7 9  4 2 ~ 7] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2 ~] [4@2 7 9@2 7 4 2] [7 9 4 ~  2 0 4 7] [~ 4 9 2  0 ~ 7 4] [9 ~ 2 4  7 0 ~ 2] [4 0 7 ~  2 4 0 9] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2 ~] [4@2 7 9@2 7 4 2]>")
  .scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("<[~ 7 ~ 11  ~ 9 ~ 7] [~ 11 ~ 9  ~ 7 ~ 4] [7 ~ 11 9  ~ 7 4 2] [~ 9 ~ 7  ~ 4 ~ 11] [7 11 ~ 12  11 7 9 7] [~ 11 ~ 12  9 ~ 7 4] [7 12 ~ 11  9 ~ 12 7] [7 11 12 9  11 7 4 2] [~ 12 ~ 9  ~ 7 ~ 4] [~ 11 ~ 7  ~ 4 ~ 0] [~ 9 ~ 4  ~ 7 ~ 2] [~ 7 ~ 4  ~ 2 ~ 0] [7 11 ~ 12  11 7 9 7] [~ 11 ~ 12  9 ~ 7 4] [7 12 ~ 11  9 ~ 12 7] [7 11 12 9  11 7 4 2]>")
  .scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("ld:an").gain(0.18).cut(1)
// arp
$: note("<[0 4 7 12  7 4 0 7] [0 7 4 12  7 0 4 7] [4 0 7 12  4 7 0 4] [0 7 12 4  7 4 0 12] [0 4 7 12  9 7 4 0] [4 7 12 7  4 0 7 12] [0 4 12 7  4 7 0 4] [7 12 4 0  7 4 12 7]>")
  .scale("<F6:minor C#6:lydian Ab5:major Eb6:mixolydian Ab5:major Eb6:mixolydian F6:minor C#6:lydian F6:minor C#6:lydian Ab5:major Eb6:mixolydian F6:minor Eb6:mixolydian C#6:lydian C6:phrygian>")
  .s("ld:sw").gain(0.12).cut(1)
// chords
$: note("<[[0,4,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,4,8] ~] [[0,2,8] ~ [0,2,8] ~  ~ [0,4,8] ~ [0,4,8]] [[0,4,8] ~ ~ [0,4,8]  [0,2,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,4,8] [0,4,8]  ~ [0,2,8] ~ ~]>")
  .scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ 0 ~ ~ ~>").scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("pf:hz").gain(0.14).room(0.25).orbit(2)
// strings
$: note("<~ ~ 0 ~ ~ ~ 0 ~ 0 ~ ~ ~ ~ ~ 0 ~>").scale("<F5:minor C#5:lydian Ab4:major Eb5:mixolydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor Eb5:mixolydian C#5:lydian C5:phrygian>")
  .s("dr:sl").gain(0.12).orbit(2)
