// @title future-bass-21
// @genre future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ bd:8t] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:tt*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]]>").gain(0.42)
// bass
$: note("<[0 0 0 7  ~ 4 0 0] [0 7 4 ~  0 0 7 4] [0 ~ 0 4  7 0 4 ~] [0 4 0 7  0 2 7 0] [0 0 7 0  4 ~ 0 7] [0 4 ~ 0  7 4 0 2] [0 7 0 0  ~ 4 7 0] [0 0 4 7  2 0 ~ 4]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("bs:8s").gain(0.42).cut(1).orbit(2)
// lead
$: note("<[~ 2 4 7  ~ 9 4 2] [4 ~ 7 9  ~ 4 2 7] [~ 9 4 2  7 ~ 4 0] [7 4 ~ 9  4 2 ~ 7] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2 ~] [4@2 7 9@2 7 4 2] [4 7 11 9  7 ~ 4 2] [11 ~ 9 4  7 2 0 ~] [~ 9 7 11  4 0 2 4] [7 4 2 0  ~ 4 7 11] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2 ~] [4@2 7 9@2 7 4 2]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("<[~ 7 ~ 11  ~ 9 ~ 7] [~ 11 ~ 9  ~ 7 ~ 4] [7 ~ 11 9  ~ 7 4 2] [~ 9 ~ 7  ~ 4 ~ 11] [7 11 ~ 12  11 7 9 7] [~ 11 ~ 12  9 ~ 7 4] [7 12 ~ 11  9 ~ 12 7] [7 11 12 9  11 7 4 2] [~ 12 ~ 9  ~ 7 ~ 4] [~ 11 ~ 7  ~ 4 ~ 0] [~ 9 ~ 4  ~ 7 ~ 2] [~ 7 ~ 4  ~ 2 ~ 0] [7 11 ~ 12  11 7 9 7] [~ 11 ~ 12  9 ~ 7 4] [7 12 ~ 11  9 ~ 12 7] [7 11 12 9  11 7 4 2]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("plk:ss").gain(0.18).cut(1)
// arp
$: note("<[0 4 7 12  7 4 0 7] [0 7 4 12  7 0 4 7] [4 0 7 12  4 7 0 4] [0 7 12 4  7 4 0 12] [0 4 7 12  9 7 4 0] [4 7 12 7  4 0 7 12] [0 4 12 7  4 7 0 4] [7 12 4 0  7 4 12 7]>")
  .scale("<C5:major G5:mixolydian A5:minor F5:lydian C5:major G5:mixolydian A5:minor F5:lydian A5:minor G5:mixolydian F5:lydian E5:phrygian F5:lydian A5:minor G5:mixolydian C5:major>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("<[[0,4,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,4,8] ~] [[0,2,8] ~ [0,2,8] ~  ~ [0,4,8] ~ [0,4,8]] [[0,4,8] ~ ~ [0,4,8]  [0,2,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,4,8] [0,4,8]  ~ [0,2,8] ~ ~]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("ld:st").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ 0 ~ ~ ~>").scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("pf:fo").gain(0.14).room(0.25).orbit(2)
// strings
$: note("<~ ~ 0 ~ ~ ~ 0 ~ 0 ~ ~ ~ ~ ~ 0 ~>").scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian A4:minor G4:mixolydian F4:lydian E4:phrygian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("dr:sl").gain(0.12).orbit(2)
