// @title future-bass-21
// @genre future-bass
// @details jungle-round, tight-house + major stab walk @ 140
setcpm(140/4)
// drums
$: s("bd:jg*4, [~ sd:pp]*2, [~ hh:hs]*4, [~ oh:op]*2").gain(0.48)
// bass
$: note("7 ~ 4 0").scale("C4:major").s("bs:ht").gain(0.42)
// lead
$: note("[0,2,4] 0 7 2").scale("C4:major").s("plk:s3").gain(0.22).cut(1)
