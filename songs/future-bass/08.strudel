// @title future-bass-08
// @genre future-bass
setcpm(140/4)
// kick
$: s("bd:8t ~ bd:8t ~").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:ch*8, <~ ~ ~ [hh:ch*16]>").gain(0.42)
// bass
$: note("0 ~ 0 <0 4 0 2>").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("bs:su").gain(0.4).orbit(2)
// lead
$: note("4@2 7 9@2  7 4 <2 0> ~").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("~ 11 ~ 12  ~ 9 ~ <11 12>").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("0 4 ~ 7  4 ~ 9 4").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("plk:fg").gain(0.14).cut(1)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("plk:ss").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor>")
  .s("pf:sp").cut(1).gain(0.14).room(0.3).orbit(2)
