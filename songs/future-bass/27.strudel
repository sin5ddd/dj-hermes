// @title future-bass-27
// @genre future-bass
// @details disco-dry, acid + add9 house pluck @ 140
setcpm(140/4)
// drums
$: s("bd:dc*4, [~ sd:hd]*2, hh:hs*8").gain(0.48)
// bass
$: note("0 ~ 5 4").scale("C4:major").s("bs:ac").gain(0.4)
// lead
$: note("[0,4,9] 0 ~ 7").scale("C4:major").s("plk:hb").gain(0.22).cut(1)
