// @title chill-09
// @genre chill
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ bd:hf ~ ~ sd:br ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("~ 4 ~ 7 ~ <6 9 7 4>").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0@2 4 7@2 ~").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("ep:rs").gain(0.18).cut(1)
// arp
$: note("~ 7 12 7  4 0 ~ 2").scale("<Bb5:minor Bb5:minor Eb6:dorian Bb5:minor>")
  .s("plk:kl").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("ep:mt").gain(0.22).room(0.3).orbit(2)
// pad
$: note("0").scale("<Bb2:minor Bb2:minor Eb3:dorian Bb2:minor>")
  .s("pf:cl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
