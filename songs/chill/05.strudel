// @title chill-05
// @genre chill
// @details round kick + tight house bass + descending hook
setcpm(90/4)
// drums
$: s("bd:jg ~ ~ sd, [~ hh]*4").gain(0.44)
// bass
$: note("0 0 2 4").scale("C4:minor").s("bs:ht").gain(0.4)
// lead
$: note("~ 7 4 0").scale("C4:minor").s("triangle").lpf(2000).gain(0.18)
