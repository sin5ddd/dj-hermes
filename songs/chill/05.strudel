// @title chill-05
// @genre chill
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ bd:hf ~ ~ sd ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("~ 4 ~ 7 ~ <6 9 7 4>").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("triangle").lpf(1800).gain(0.16)
// hook
$: note("0@2 4 7@2 ~").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("plk:am").gain(0.18).cut(1)
// arp
$: note("~ 7 12 7  4 0 ~ 2").scale("<F5:minor F5:minor Bb5:dorian F5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<F3:minor F3:minor Bb3:dorian F3:minor>")
  .s("triangle").lpf(1200).gain(0.22).room(0.3).orbit(2)
  .attack(0.04).release(0.3)
// pad
$: note("[0,4]").scale("<F3:minor F3:minor Bb3:dorian F3:minor>")
  .s("wt_organ").lpf(900).gain(0.16).room(0.35).orbit(2)
  .attack(0.12).release(0.5)
