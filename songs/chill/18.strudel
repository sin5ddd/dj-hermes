// @title chill-18
// @genre chill
setcpm(90/4)
// drums
$: s("bd:lf ~ ~ bd:lf ~ ~ sd ~, [~ hh]*4, perc:sk, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("~ 4 ~ 7 ~ <6 9 7 4>").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0@2 4 7@2 ~").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("plk:am").gain(0.18).cut(1)
// arp
$: note("~ 7 12 7  4 0 ~ 2").scale("<A5:minor A5:minor D6:dorian A5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("ep:rs").gain(0.22).room(0.3).orbit(2)
// pad
$: note("0").scale("<A2:minor A2:minor D3:dorian A2:minor>")
  .s("pf:ln").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
