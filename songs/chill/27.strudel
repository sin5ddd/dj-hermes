// @title chill-27
// @genre chill
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ bd:hf ~ ~ sd:br ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("4@2 7 6  9@2 7 <6 9 7 4>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0@2 4 7@2  4 ~ ~").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ep:rs").gain(0.18).cut(1)
// arp
$: note("7 12 7 4  0 2 4 7").scale("<Ab5:minor Ab5:minor C#6:dorian Ab5:minor>")
  .s("plk:kl").gain(0.12).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ep:mt").gain(0.22).room(0.3).orbit(2)
// pad
$: note("0").scale("<Ab2:minor Ab2:minor C#3:dorian Ab2:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
