// @title chill-20
// @genre chill
// @details sub-layer kick + metal bass + monophonic ld:ss
setcpm(90/4)
// drums
$: s("bd:sb ~ ~ sd:pp, ~ ~ ~ oh:op").gain(0.4)
// bass
$: note("6 0 4 ~").scale("C4:minor").s("bs:mt").gain(0.36)
// lead
$: note("8 4 2 6").scale("C4:minor").s("ld:ss").gain(0.2).cut(1)
