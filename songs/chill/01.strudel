// @title chill-01
// @genre chill
// @details house kick + floor bass + soft triangle hook
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ ~, [~ sd]*2, [~ hh]*4").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4>").scale("C4:minor").s("bs:hf").gain(0.42)
// lead
$: note("~ 4 ~ 7 ~ <6 9>").scale("C4:minor").s("triangle").lpf(1800).gain(0.2)
