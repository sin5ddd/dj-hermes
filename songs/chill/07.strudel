// @title chill-07
// @genre chill
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ bd:hf ~ ~ sd:br ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("~ 4 ~ 7 ~ <6 9 7 4>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ld:ny").gain(0.16).cut(1)
// hook
$: note("0@2 4 7@2 ~").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ep:rs").gain(0.18).cut(1)
// arp
$: note("~ 7 12 7  4 0 ~ 2").scale("<Ab5:minor Ab5:minor C#6:dorian Ab5:minor>")
  .s("plk:kl").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ep:mt").gain(0.22).room(0.3).orbit(2)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("dr:fg").cut(1).gain(0.16).room(0.35).orbit(2)
