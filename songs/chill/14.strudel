// @title chill-14
// @genre chill
setcpm(90/4)
// drums
$: s("bd:hf ~ ~ bd:hf ~ ~ sd ~, [~ hh]*4, perc:sk, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("~ 4 ~ 7 ~ <6 9 7 4>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("triangle").lpf(1800).gain(0.16)
// hook
$: note("0@2 4 7@2 ~").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("plk:am").gain(0.18).cut(1)
// arp
$: note("~ 7 12 7  4 0 ~ 2").scale("<E5:minor E5:minor A5:dorian E5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<E3:minor E3:minor A3:dorian E3:minor>")
  .s("triangle").lpf(1200).gain(0.22).room(0.3).orbit(2)
  .attack(0.04).release(0.3)
// pad
$: note("[0,4]").scale("<E3:minor E3:minor A3:dorian E3:minor>")
  .s("wt_organ").lpf(900).gain(0.16).room(0.35).orbit(2)
  .attack(0.12).release(0.5)
