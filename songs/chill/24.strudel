// @title chill-24
// @genre chill
setcpm(90/4)
// drums
$: s("bd:lf ~ ~ bd:lf ~ ~ sd ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("4@2 7 6  9@2 7 <6 9 7 4>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("plk:ps").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0@2 4 7@2  4 ~ ~").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("plk:am").gain(0.18).cut(1)
// arp
$: note("7 12 7 4  0 2 4 7").scale("<E5:minor E5:minor A5:dorian E5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("ep:rs").gain(0.22).room(0.3).orbit(2)
// pad
$: note("0").scale("<E2:minor E2:minor A2:dorian E2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
