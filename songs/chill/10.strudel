// @title chill-10
// @genre chill
setcpm(90/4)
// drums
$: s("bd:lf ~ ~ bd:lf ~ ~ sd ~, [~ hh]*4, <~ ~ ~ oh>").gain(0.42)
// bass
$: note("0 ~ 2 ~ 0 <3 4 2 0>").scale("<B4:minor B4:minor E5:dorian B4:minor>")
  .s("bs:hf").gain(0.4)
// lead
$: note("4@2 7 6  9@2 7 <6 9 7 4>").scale("<B4:minor B4:minor E5:dorian B4:minor>")
  .s("ld:ny").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("0@2 4 7@2  4 ~ ~").scale("<B4:minor B4:minor E5:dorian B4:minor>")
  .s("plk:am").gain(0.18).cut(1)
// arp
$: note("7 12 7 4  0 2 4 7").scale("<B5:minor B5:minor E6:dorian B5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,2,4]@2 [0,2,4]@2").scale("<B4:minor B4:minor E5:dorian B4:minor>")
  .s("ep:rs").gain(0.22).room(0.3).orbit(2)
// pad
$: note("0").scale("<B2:minor B2:minor E3:dorian B2:minor>")
  .s("pf:ln").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
