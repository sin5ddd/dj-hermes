// @title dnb-09
// @genre drum and bass
// @details jungle-rounder kit on the amen grid @ 174
setcpm(174/4)
// drums
$: s("[bd:jg <~ sd:jg> ~ sd:jg ~ <bd:jg ~> <bd:jg sd:jg> <bd:jg ~>, hh:dn*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(3600)
// sub
$: note("0 3 0 <0 -1>").scale("C2:minor").s("square").lpf(120).gain(0.42)
  .attack(0.01).decay(0.5).release(0.4)
// mid
$: note("0 3 0 <0 -1>").scale("C2:minor").s("sawtooth").lpf(1050).gain(0.36)
  .attack(0.01).decay(0.4).release(0.3)
