// @title future-bass-05
// @genre future-bass
// @details busier hats / oh on the four-on-the-floor @ 146
setcpm(146/4)
// drums
$: s("bd:hf*4, [~ sd:hd]*2, hh:hs*8, [~ oh:op]*2").gain(0.44)
// chords
$: note("[0,2,4] ~ [0,3,5] ~").scale("C3:minor").s("sawtooth").lpf(1600).gain(0.26)
  .attack(0.02).decay(0.18).sustain(0.4).release(0.14)
// lead
$: note("7 4 <9 11> 4").scale("C4:minor").s("square").lpf(2800).gain(0.15)
// sub
$: note("0 ~ 3 ~").scale("C4:minor").s("bs:su").gain(0.46)
