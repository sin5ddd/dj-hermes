// @title acid-25
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("bs:su").lpf(sine.range(80, 240).slow(16)).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("G1:minor")
  .s("sawtooth")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("sine").fm(3).fmh(2).fmatt(0.01).fmdec(0.3).fmsus(0.25).lpf(1800).lpenv(2).gain(0.12).cut(1)
// arp
$: s("<~ perc:tm ~ perc:mh>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("pf:pu").cut(1).gain(0.12).room(0.25).orbit(2)
