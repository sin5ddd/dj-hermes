// @title acid-25
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("bs:su").lpf(sine.range(80, 240).slow(16)).gain(0.32)
// hook
$: note("g1 d2 g1 d2  bb1 b1 c2 d2  g1 f1 g1 bb1  d2 c2 bb1 <g1 d2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("sine").fm(3).fmh(2).fmatt(0.01).fmdec(0.3).fmsus(0.25).lpf(1800).lpenv(2).adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("0").scale("<G1:minor G1:minor D2:phrygian G1:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
