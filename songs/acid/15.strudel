// @title acid-15
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:su").lpq(4).lpf(150).gain(0.32)
// hook
$: note("e2 b2 e2 b2  g2 ab2 a2 b2  e2 d2 e2 g2  b2 a2 g2 <e2 b2>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:lp").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<E5:minor E5:minor B5:phrygian E5:minor>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("0").scale("<E2:minor E2:minor B2:phrygian E2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
