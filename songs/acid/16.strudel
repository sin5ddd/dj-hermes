// @title acid-16
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:8t*4, hh:dk*8, <~ ~ ~ [~@3 bd:8t ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<F#1:minor F#1:minor C#2:phrygian F#1:minor>")
  .s("sine").lpf(sine.range(80, 240).slow(16)).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("F#1:minor")
  .s("square")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<F#3:minor F#3:minor C#4:phrygian F#3:minor>")
  .s("plk:pk").gain(0.12).cut(1)
// arp
$: s("<~ perc:tk ~ perc:cb>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<F#3:minor F#3:minor C#4:phrygian F#3:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<F#3:minor F#3:minor C#4:phrygian F#3:minor>")
  .s("pf:cs").cut(1).gain(0.12).room(0.25).orbit(2)
