// @title acid-13
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd*4, [~ hh:cl]*4, <~ ~ ~ [~@3 bd ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("bs:su").lpf(280).gain(0.32)
// hook
$: note("a2 a3 a2 c3  c#3 a2 e3 a2  a2 g2 ab2 a2  c3 e3 d3 <c3 a2>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:fc").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<A5:minor A5:minor E6:phrygian A5:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("0").scale("<A2:minor A2:minor E3:phrygian A2:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
