// @title acid-03
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd*4, [~ hh:cl]*4, <~ ~ ~ [~@3 bd ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("bs:su").lpq(3).lpf(sine.rangex(70, 200).slow(8)).gain(0.32)
// hook
$: note("g1 g2 g1 bb1  b1 g1 d2 g1  g1 f1 f#1 g1  bb1 d2 c2 <bb1 g1>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("ld:fm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<G1:minor G1:minor D2:phrygian G1:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
