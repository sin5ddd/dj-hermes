// @title acid-18
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:mt*4, [~ hh:pd]*4, <~ ~ ~ [~@3 bd:mt ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<B1:minor B1:minor F#2:phrygian B1:minor>")
  .s("sine").lpq(3).lpf(sine.rangex(60, 180).slow(6)).gain(0.32)
// hook
$: note("b1 d2 f#2 d2  eb2 e2 f2 f#2  b1 b1 a1 bb1  b1 d2 e2 <f#2 b2>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("ld:sf").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("plk:cv").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("0").scale("<B1:minor B1:minor F#2:phrygian B1:minor>")
  .s("pf:fo").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
