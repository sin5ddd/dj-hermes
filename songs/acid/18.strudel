// @title acid-18
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:mt*4, [~ hh:pd]*4, <~ ~ ~ [~@3 bd:mt ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<B1:minor B1:minor F#2:phrygian B1:minor>")
  .s("sine").lpq(3).lpf(sine.rangex(60, 180).slow(6)).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("B1:minor")
  .s("square")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("ld:sf").gain(0.12).cut(1)
// arp
$: s("<~ perc:sk ~ perc:tm>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<B3:minor B3:minor F#4:phrygian B3:minor>")
  .s("pf:fo").cut(1).gain(0.12).room(0.25).orbit(2)
