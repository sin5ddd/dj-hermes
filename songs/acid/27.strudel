// @title acid-27
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ng*4, [~ hh:ns]*4, <~ ~ ~ [~@3 bd:ng ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("bs:su").lpq(3).lpf(sine.rangex(60, 180).slow(6)).gain(0.32)
// hook
$: note("bb1 bb1 bb2 bb1  c#2 d2 bb2 bb1  eb2 e2 bb2 bb1  f2 c#2 bb1 <c2 bb2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("plk:fc").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<Bb1:minor Bb1:minor F2:phrygian Bb1:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
