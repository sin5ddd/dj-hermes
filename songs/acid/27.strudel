// @title acid-27
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ng*4, [~ hh:ns]*4, <~ ~ ~ [~@3 bd:ng ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("bs:su").lpq(3).lpf(sine.rangex(60, 180).slow(6)).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("Bb1:minor")
  .s("sawtooth")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("plk:fc").gain(0.12).cut(1)
// arp
$: s("<~ perc:st ~ perc:tk>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("pf:ff").gain(0.12).room(0.25).orbit(2)
