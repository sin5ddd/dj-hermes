// @title acid-22
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:9p*4, [~ hh]*4, <~ ~ ~ [~@3 bd:9p ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<D1:minor D1:minor A1:phrygian D1:minor>")
  .s("sine").lpf(280).gain(0.32)
// hook
$: note("d1 f1 f#1 g1  ab1 g1 f1 d1  a1 ab1 g1 f1  f#1 g1 a1 <d1 a1>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<D3:minor D3:minor A3:phrygian D3:minor>")
  .s("plk:lp").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<D3:minor D3:minor A3:phrygian D3:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<D1:minor D1:minor A1:phrygian D1:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
