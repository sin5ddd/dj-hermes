// @title acid-10
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:lf*4, [~ hh:dk]*4, <~ ~ ~ [~@3 bd:lf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Ab2:minor Ab2:minor Eb3:phrygian Ab2:minor>")
  .s("sine").lpf(100).gain(0.32)
// hook
$: note("ab2 eb3 b2 c3  ab2 c#3 d3 eb3  b2 ab2 g2 ab2  eb3 c#3 b2 <c3 ab2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("ld:fm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Ab5:minor Ab5:minor Eb6:phrygian Ab5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("0").scale("<Ab2:minor Ab2:minor Eb3:phrygian Ab2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
