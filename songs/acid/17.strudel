// @title acid-17
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ng*4, [~ hh:ns]*4, <~ ~ ~ [~@3 bd:ng ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("bs:su").lpf(220).gain(0.32)
// hook
$: note("b2 b2 b3 b2  d3 eb3 b3 b2  e3 f3 b3 b2  f#3 d3 b2 <c#3 b3>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ld:fm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<B5:minor B5:minor F#6:phrygian B5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<B4:minor B4:minor F#5:phrygian B4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<B2:minor B2:minor F#3:phrygian B2:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
