// @title acid-28
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:mt*4, hh:pd*8, <~ ~ ~ [~@3 bd:mt ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("sine").lpf(100).gain(0.32)
// hook
$: note("bb2 c#3 f3 c#3  d3 eb3 e3 f3  bb2 bb2 ab2 a2  bb2 c#3 eb3 <f3 bb3>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ld:mt").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Bb5:minor Bb5:minor F6:phrygian Bb5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("0").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
