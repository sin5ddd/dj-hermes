// @title nine-skip
// @genre acid
setcpm(130/4)
// drums
$: s("bd:9p*4, hh:cl*8").gain(0.62)
// bass
$: note("0 5 2 7  3 0 5 2  7 0 4 3  2 -1 5 <0 3>")
  .scale("C2:minor")
  .s("square")
  .lpf("270 700 270 270  270 270 760 270  720 270 270 270  270 780 270 680")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("7 ~ 3 ~").scale("C4:minor").s("plk:ac").gain(0.14).cut(1)
