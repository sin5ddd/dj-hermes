// @title acid-29
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:9p*4, [~ hh]*4, <~ ~ ~ [~@3 bd:9p ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("bs:su").gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("Bb2:minor")
  .s("sawtooth")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:pk").gain(0.12).cut(1)
// arp
$: s("<~ perc:tm ~ perc:mh>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("dr:pd").cut(1).gain(0.12).room(0.25).orbit(2)
