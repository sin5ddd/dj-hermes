// @title acid-29
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:dc*4, [~ hh:tt]*4, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("bs:su").lpf(120).gain(0.32)
// hook
$: note("eb2 e2 f2 f#2  g2 f#2 f2 eb2  bb2 b2 bb2 ab2  g2 f#2 eb2 <bb2 eb2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:lp").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<Eb5:minor Eb5:minor Bb5:phrygian Eb5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
