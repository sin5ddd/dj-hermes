// @title acid-09
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:dc*4, [~ hh:tt]*4, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Ab3:minor Ab3:minor Eb4:phrygian Ab3:minor>")
  .s("bs:su").lpq(3).lpf(sine.rangex(60, 180).slow(6)).gain(0.32)
// hook
$: note("ab1 a1 bb1 b1  c2 b1 bb1 ab1  eb2 e2 eb2 c#2  c2 b1 ab1 <eb2 ab1>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Ab3:minor Ab3:minor Eb4:phrygian Ab3:minor>")
  .s("plk:pk").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Ab3:minor Ab3:minor Eb4:phrygian Ab3:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<Ab1:minor Ab1:minor Eb2:phrygian Ab1:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
