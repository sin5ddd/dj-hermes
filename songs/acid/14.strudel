// @title acid-14
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ez*4, [~ hh:ch]*4, <~ ~ ~ [~@3 bd:ez ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<E1:minor E1:minor B1:phrygian E1:minor>")
  .s("sine").lpq(2).lpf(sine.rangex(90, 260).slow(4)).gain(0.32)
// hook
$: note("b1 bb1 a1 ab1  g1 f#1 f1 e1  b1 a1 g1 e1  eb1 e1 g1 <ab1 b1>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<E3:minor E3:minor B3:phrygian E3:minor>")
  .s("ld:mt").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<E3:minor E3:minor B3:phrygian E3:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<E1:minor E1:minor B1:phrygian E1:minor>")
  .s("dr:pd").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
