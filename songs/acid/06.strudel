// @title acid-06
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:8t*4, [~ hh:dk]*4, <~ ~ ~ [~@3 bd:8t ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("sine").lpq(4).lpf(150).gain(0.32)
// hook
$: note("eb2 f2 eb2 f#2  eb2 g2 eb2 ab2  bb2 a2 bb2 f#2  eb2 d2 eb2 <f#2 bb2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:fc").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Eb5:minor Eb5:minor Bb5:phrygian Eb5:minor>")
  .s("plk:cv").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("pf:fo").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
