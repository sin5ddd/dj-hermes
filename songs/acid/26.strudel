// @title acid-26
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:8t*4, [~ hh:dk]*4, <~ ~ ~ [~@3 bd:8t ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("sine").lpf(220).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("G2:minor")
  .s("sawtooth")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("ld:sf").gain(0.12).cut(1)
// arp
$: s("<~ perc:mh ~ perc:st>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("dr:pd").cut(1).gain(0.12).room(0.25).orbit(2)
