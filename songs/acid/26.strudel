// @title acid-26
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:8t*4, [~ hh:dk]*4, <~ ~ ~ [~@3 bd:8t ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("sine").lpf(220).gain(0.32)
// hook
$: note("g2 a2 g2 bb2  g2 b2 g2 c3  d3 c#3 d3 bb2  g2 f#2 g2 <bb2 d3>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("ld:sf").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<G5:minor G5:minor D6:phrygian G5:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("0").scale("<G2:minor G2:minor D3:phrygian G2:minor>")
  .s("dr:pd").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
