// @title acid-04
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ez*4, hh:ch*8, <~ ~ ~ [~@3 bd:ez ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("sine").lpf(280).gain(0.32)
// hook
$: note("c3 b2 bb2 a2  ab2 g2 f#2 f2  c3 bb2 ab2 f2  e2 f2 ab2 <a2 c3>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("ld:sf").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<F5:minor F5:minor C6:phrygian F5:minor>")
  .s("plk:hp").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("pf:cs").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
