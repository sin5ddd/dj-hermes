// @title acid-07
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ng*4, [~ hh:ns]*4, <~ ~ ~ [~@3 bd:ng ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("bs:su").lpf(sine.range(80, 240).slow(16)).gain(0.32)
// hook
$: note("f1 f1 f2 f1  ab1 a1 f2 f1  bb1 b1 f2 f1  c2 ab1 f1 <g1 f2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("ld:mt").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<F3:minor F3:minor C4:phrygian F3:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<F1:minor F1:minor C2:phrygian F1:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
