// @title neuro-accent
// @genre acid
setcpm(130/4)
// drums
$: s("bd:ng*4, [~ hh:hs]*4").gain(0.59)
// bass
$: note("0 7 5 0  2 3 7 0  5 2 0 4  3 0 -1 <2 7>")
  .scale("C2:minor")
  .s("sawtooth")
  .lpf("265 780 265 265  265 265 720 265  740 265 265 265  265 700 265 760")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// fx
$: s("<fx:rp ~ ~ ~>").gain(0.22)
