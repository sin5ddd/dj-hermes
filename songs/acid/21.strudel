// @title acid-21
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:tc*4, [~ hh]*4, <~ ~ ~ [~@3 bd:tc ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<C#4:minor C#4:minor Ab4:phrygian C#4:minor>")
  .s("bs:su").lpq(3).lpf(sine.rangex(70, 200).slow(8)).gain(0.32)
// hook
$: note("c#2 c#2 e2 f2  ab2 e2 eb2 c#2  f#2 g2 f#2 c#2  c2 e2 c#2 <eb2 ab2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<C#4:minor C#4:minor Ab4:phrygian C#4:minor>")
  .s("ld:mt").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<C#5:minor C#5:minor Ab5:phrygian C#5:minor>")
  .s("plk:s5").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<C#4:minor C#4:minor Ab4:phrygian C#4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("0").scale("<C#2:minor C#2:minor Ab2:phrygian C#2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
