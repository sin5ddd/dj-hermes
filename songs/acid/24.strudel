// @title acid-24
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:ez*4, hh:ch*8, <~ ~ ~ [~@3 bd:ez ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<E2:minor E2:minor B2:phrygian E2:minor>")
  .s("sine").lpq(4).lpf(150).gain(0.32)
// hook
$: note("b2 bb2 a2 ab2  g2 f#2 f2 e2  b2 a2 g2 e2  eb2 e2 g2 <ab2 b2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:fm").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<E5:minor E5:minor B5:phrygian E5:minor>")
  .s("plk:cv").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<E2:minor E2:minor B2:phrygian E2:minor>")
  .s("pf:fo").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
