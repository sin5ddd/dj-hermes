// @title acid-19
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:dc*4, [~ hh:tt]*4, <~ ~ ~ [~@3 bd:dc ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<F#4:minor F#4:minor C#5:phrygian F#4:minor>")
  .s("bs:su").lpf(100).gain(0.32)
// hook
$: note("f#2 g2 ab2 a2  bb2 a2 ab2 f#2  c#3 d3 c#3 b2  bb2 a2 f#2 <c#3 f#2>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<F#4:minor F#4:minor C#5:phrygian F#4:minor>")
  .s("ld:sf").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<F#5:minor F#5:minor C#6:phrygian F#5:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<F#4:minor F#4:minor C#5:phrygian F#4:minor>")
  .s("ep:ky").gain(0.16)
// pad
$: note("0").scale("<F#2:minor F#2:minor C#3:phrygian F#2:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
