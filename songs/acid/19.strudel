// @title cine-sparse
// @genre acid
setcpm(130/4)
// drums
$: s("bd:cn*4, [~ hh:ns]*4").gain(0.63)
// bass
$: note("0 ~ 5 ~  3 0 ~ 7  ~ 2 0 ~  5 ~ -1 ~")
  .scale("C2:minor")
  .s("sawtooth")
  .lpf("210 210 680 210  210 720 210 210  210 210 760 210  700 210 210 210")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("7 ~ ~ 5").scale("C4:minor").s("ld:ss").gain(0.14)
