// @title acid-23
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd*4, [~ hh:cl]*4, <~ ~ ~ [~@3 bd ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("bs:su").lpq(2).lpf(sine.rangex(90, 260).slow(4)).gain(0.32)
// hook
$: note("ab2 ab3 ab2 b2  c3 ab2 eb3 ab2  ab2 f#2 g2 ab2  b2 eb3 c#3 <b2 ab2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("[260 260 720 260]*4")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:pk").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Ab5:minor Ab5:minor Eb6:phrygian Ab5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("0").scale("<Ab2:minor Ab2:minor Eb3:phrygian Ab2:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
