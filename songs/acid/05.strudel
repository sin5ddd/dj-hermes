// @title acid-05
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("bs:su").lpq(2).lpf(sine.rangex(90, 260).slow(4)).gain(0.32)
// hook
$: note("bb1 f2 bb1 f2  c#2 d2 eb2 f2  bb1 ab1 bb1 c#2  f2 eb2 c#2 <bb1 f2>")
  .s("sawtooth")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("ld:sf").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("0").scale("<Bb1:minor Bb1:minor F2:phrygian Bb1:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
