// @title acid-05
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh:hs]*4, <~ ~ ~ [~@3 bd:hf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("bs:su").lpq(2).lpf(sine.rangex(90, 260).slow(4)).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("Bb1:minor")
  .s("sawtooth")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("ld:sf").gain(0.12).cut(1)
// arp
$: s("<~ perc:cb ~ perc:sk>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Bb3:minor Bb3:minor F4:phrygian Bb3:minor>")
  .s("dr:fg").cut(1).gain(0.12).room(0.25).orbit(2)
