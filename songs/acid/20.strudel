// @title acid-20
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:lf*4, hh:dk*8, <~ ~ ~ [~@3 bd:lf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Eb1:minor Eb1:minor Bb1:phrygian Eb1:minor>")
  .s("sine").lpf(120).gain(0.32)
// hook
$: note("eb1 bb1 f#1 g1  eb1 ab1 a1 bb1  f#1 eb1 d1 eb1  bb1 ab1 f#1 <g1 eb1>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("7@2 ~ 9  12@2 7 <9 7 4 12>").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("plk:fc").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,4]@2 [0,4]@2").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("0").scale("<Eb1:minor Eb1:minor Bb1:phrygian Eb1:minor>")
  .s("dr:pd").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
