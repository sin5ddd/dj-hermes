// @title acid-20
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:lf*4, hh:dk*8, <~ ~ ~ [~@3 bd:lf ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<Eb1:minor Eb1:minor Bb1:phrygian Eb1:minor>")
  .s("sine").lpf(120).gain(0.32)
// hook
$: note("0 0 3 0  7 3 2 0  4 4 3 0  -1 3 0 <2 5>")
  .scale("Eb1:minor")
  .s("square")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.44)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("plk:fc").gain(0.12).cut(1)
// arp
$: s("<~ perc:mh ~ perc:st>").gain(0.14)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("plk:an").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb3:minor Eb3:minor Bb3:phrygian Eb3:minor>")
  .s("dr:pd").cut(1).gain(0.12).room(0.25).orbit(2)
