// @title acid-11
// @genre acid techno
setcpm(130/4)
// drums
$: s("bd:tc*4, [~ hh]*4, <~ ~ ~ [~@3 bd:tc ~@4]>").gain(0.62)
// bass
$: note("0 ~ 0 <0 0 3 0>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("bs:su").lpf(120).gain(0.32)
// hook
$: note("d2 d2 f2 f#2  a2 f2 e2 d2  g2 ab2 g2 d2  c#2 f2 d2 <e2 a2>")
  .s("square")
  .adsr("0.001:0.1:0.12:0.04")
  .lpf("260 260 720 260  760 260 260 260  260 680 260 260  740 720 260 260")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.3)
// lead
$: note("~ 7 ~ <9 7 4 12>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("sine").fm(3).fmh(2).fmatt(0.01).fmdec(0.3).fmsus(0.25).lpf(1800).lpenv(2).adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<D5:minor D5:minor A5:phrygian D5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:sf").gain(0.16)
// pad
$: note("0").scale("<D2:minor D2:minor A2:phrygian D2:minor>")
  .s("dr:fg").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.25).orbit(2)
