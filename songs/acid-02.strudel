// @title square-riser
// @genre acid
setcpm(130/4)
// drums
$: s("bd:tc*4, [~ hh]*4").gain(0.64)
// bass
$: note("0 2 3 4  2 3 0 <-1 2>  0 3 7 3  2 0 4 0")
  .scale("C2:minor")
  .s("square")
  .lpf("240 240 700 240  240 740 240 240  660 240 240 720  240 240 760 240")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// fx
$: s("<fx:up ~ ~ ~>").gain(0.22)
