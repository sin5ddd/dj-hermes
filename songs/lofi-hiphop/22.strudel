// @title lofi-hiphop-22
// @genre lofi-hiphop
setcpm(84/4)
// drums
$: s("bd:lf ~ ~ sd:br, [~ hh]*4, <~ ~ ~ [bd:lf sd:br bd:lf sd:br]>").gain(0.44)
// bass
$: note("0 ~ 2 <0 0 3 2>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("bs:su").gain(0.38)
// lead
$: note("~ 4 7 <5 4 0 2>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("plk:lf").gain(0.18).cut(1)
// hook
$: note("[0,2,4] ~ [0,3,5] ~").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("ep:rs").gain(0.22)
  .attack(0.05).decay(0.3).sustain(0.5).release(0.3)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<D5:minor D5:minor G5:dorian D5:minor>")
  .s("plk:ny").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("ep:mt").gain(0.2).room(0.3).orbit(1)
// pad
$: note("<0 ~ ~ ~>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("pf:cl").cut(1).gain(0.14).room(0.35).orbit(1)
