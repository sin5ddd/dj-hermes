// @title lofi-hiphop-03
// @genre lofi-hiphop
setcpm(84/4)
// drums
$: s("bd:lf ~ ~ sd:br, [~ hh:dk]*4, <~ ~ ~ [bd:lf sd:br bd:lf sd:br]>").gain(0.44)
// bass
$: note("0 ~ 2 <0 0 3 2>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("bs:su").gain(0.38)
// lead
$: note("~ 4 7 <5 4 0 2>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ld:ny").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.18)
// hook
$: note("[0,2,4] ~ [0,3,5] ~").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ep:wr").adsr("0.05:0.3:0.5:0.3").cut(1).gain(0.22)
// arp
$: note("~ 0 4 7  ~ 4 0 2").scale("<Eb5:minor Eb5:minor Ab5:dorian Eb5:minor>")
  .s("plk:lf").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ep:mt").gain(0.2).room(0.3).orbit(1)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Ab2:dorian Eb2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.14).room(0.35).orbit(1)
