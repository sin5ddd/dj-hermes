// @title square-fifth
// @genre acid
setcpm(130/4)
// drums
$: s("bd:hf*4, [~ hh]*4").gain(0.64)
// bass
$: note("0 0 5 0  4 5 0 2  7 5 4 0  3 0 -1 5")
  .scale("C2:minor")
  .s("square")
  .lpf("250 250 710 250  250 750 250 250  680 250 250 730  250 250 780 250")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// pad
$: note("4 ~ ~ ~").scale("C4:minor").s("pf:ff").gain(0.14)
