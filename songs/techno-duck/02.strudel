// @title thud-close
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:9p*4").gain(0.88).duckorbit(2).duckattack(0.035).duckdepth(0.88)
// hats
$: s("[~ hh]*4").gain(0.32)
// bass
$: note("0 0 0 2").scale("C2:minor")
  .s("sine").fm(2.5).fmh(1).fmdec(0.3).fmsus(0.25).lpf(360).gain(0.48)
  .orbit(2)
// pad
$: note("[0,2,4] ~ [0,2,4] ~").scale("C3:minor")
  .s("triangle").lpf(620).orbit(2).gain(0.26)
  .attack(0.06).sustain(0.65).release(0.22)
