// @title break-saw
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:dn*4").gain(0.86).duckorbit(2).duckattack(0.038).duckdepth(0.90)
// hats
$: s("[~ hh:hs]*4").gain(0.30)
// bass
$: note("0 5 3 5").scale("C4:minor").s("bs:sw").orbit(2).gain(0.32)
// lead
$: note("2 ~ 5 ~").scale("C4:minor").s("ld:ss").orbit(2).gain(0.30).cut(1)
