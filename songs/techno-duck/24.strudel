// @title techno-duck-24
// @genre techno
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.85)
// hats
$: s("hh:cl*8, <~ ~ ~ hh:cl*8>").gain(0.38)
// bass
$: note("0 0 2 <4 6 2 0>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:ht").gain(0.52)
  .orbit(2)
// lead
$: note("~ 7 4 <9 7 4 2>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:sw")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:ac").gain(0.16).cut(1)
// arp
$: s("<~ perc:tm ~ perc:ti>").gain(0.18)
// chords
$: note("[0,2,4] ~ ~ ~").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:ky").gain(0.18).orbit(2)
// pad
$: note("0").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("pf:ff").orbit(2).gain(0.22).room(0.25)
