// @title techno-duck-25
// @genre techno
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.85)
// hats
$: s("hh*8, <~ ~ ~ hh*8>").gain(0.38)
// bass
$: note("0 0 2 <4 6 2 0>").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("sawtooth").adsr("0.005:0.1:0.3:0.08").lpf(500).gain(0.52)
  .orbit(2)
// lead
$: note("7@2 4 7  9@2 4 <9 7 4 2>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("ld:pu").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:pk").gain(0.16).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<F5:minor F5:minor C6:phrygian F5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4]").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:sf").gain(0.18).orbit(2)
// pad
$: note("0").scale("<F2:minor F2:minor C3:phrygian F2:minor>")
  .s("pf:pu").adsr("0.2:0.4:0.5:0.4").cut(1).orbit(2).gain(0.22).room(0.25)
