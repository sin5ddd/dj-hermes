// @title dark-pump
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:9p*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.88)
// hats
$: s("[~ hh]*4").gain(0.3)
// bass
$: note("0 ~ 0 2").scale("C4:minor").s("bs:dk").orbit(2).gain(0.3)
// pad
$: note("0 4 7 4").scale("C3:minor")
  .s("triangle").lpf(680).orbit(2).gain(0.22)
  .attack(0.08).sustain(0.65).release(0.22)
