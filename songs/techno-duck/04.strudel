// @title techno-duck-04
// @genre techno
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.85)
// hats
$: s("[~ hh:cl]*4, <~ ~ ~ hh:cl*8>").gain(0.38)
// bass
$: note("0 0 2 <4 6 2 0>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("bs:ht").adsr("0.005:0.1:0.3:0.08").gain(0.52)
  .orbit(2)
// lead
$: note("7@2 4 7  9@2 4 <9 7 4 2>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ld:sw").adsr("0.01:0.3:0.7:0.2")
  .cut(1).gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("plk:ac").gain(0.16).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<E5:minor E5:minor B5:phrygian E5:minor>")
  .s("plk:hd").gain(0.14).cut(1)
// chords
$: note("[0,2,4]").scale("<E4:minor E4:minor B4:phrygian E4:minor>")
  .s("ep:ky").gain(0.18).orbit(2)
// pad
$: note("0").scale("<E2:minor E2:minor B2:phrygian E2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).orbit(2).gain(0.22).room(0.25)
