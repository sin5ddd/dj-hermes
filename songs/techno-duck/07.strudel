// @title punch-pluck
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.88).duckorbit(2).duckattack(0.05).duckdepth(0.83)
// hats
$: s("[~ hh]*4").gain(0.38)
// bass
$: note("0 3 0 0").scale("C2:minor")
  .s("sine").fm(3).fmh(1).fmdec(0.28).fmsus(0.22).lpf(440).gain(0.48)
  .orbit(2)
// lead
$: note("7 ~ 4 0  2 ~ 0 ~").scale("C4:minor").s("plk:lp").gain(0.3).cut(1)
