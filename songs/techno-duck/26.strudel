// @title thud-reese
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.85).duckorbit(2).duckattack(0.034).duckdepth(0.84)
// hats
$: s("[~ hh:hs]*4").gain(0.28)
// bass
$: note("2 3 0 5").scale("C4:minor").s("bs:rn").orbit(2).gain(0.34)
// lead
$: note("5 ~ 2 7  0 3 ~ 5").scale("C4:minor").s("plk:an").orbit(2).gain(0.30).cut(1)
