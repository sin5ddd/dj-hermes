// @title techno-duck-03
// @genre techno
setcpm(126/4)
// kick
$: s("bd*4").gain(0.9).duckorbit(2).duckattack(0.04).duckdepth(0.85)
// hats
$: s("[~ hh:cl]*4, <~ ~ ~ hh:cl*8>").gain(0.38)
// bass
$: note("0 0 2 <4 6 2 0>").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("sawtooth").adsr("0.005:0.1:0.3:0.08").lpf(500).gain(0.52)
  .orbit(2)
// lead
$: note("7@2 4 7  9@2 4 <9 7 4 2>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("wt_bright")
  .gain(0.16)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:pk").gain(0.16).cut(1)
// arp
$: note("0 4 7 12  7 4 0 2").scale("<Eb5:minor Eb5:minor Bb5:phrygian Eb5:minor>")
  .s("plk:cv").gain(0.14).cut(1)
// chords
$: note("[0,2,4]").scale("<Eb4:minor Eb4:minor Bb4:phrygian Eb4:minor>")
  .s("plk:sf").gain(0.18).orbit(2)
// pad
$: note("0").scale("<Eb2:minor Eb2:minor Bb2:phrygian Eb2:minor>")
  .s("pf:or").adsr("0.2:0.4:0.5:0.4").cut(1).orbit(2).gain(0.22).room(0.25)
