// @title disco-glue
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:dc*4").gain(0.84).duckorbit(2).duckattack(0.030).duckdepth(0.80)
// hats
$: s("[~ hh:tt]*4").gain(0.26)
// bass
$: note("5 2 7 0").scale("C4:minor").s("bs:rm").orbit(2).gain(0.34)
// lead
$: note("3 7 2 ~  ~ 0 5 3").scale("C4:minor").s("plk:ss").orbit(2).gain(0.30).cut(1)
