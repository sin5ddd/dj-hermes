// @title gear-room
// @by strudel-rs
// @details no kick, stick/foley, tom talk @ 96
setcpm(96/4)
// drums
$: s("perc:tk*8, perc:st ~ perc:fk ~, tom:lo ~ tom:md tom:hi").gain(0.36)
// keys
$: note("[0,2,4] ~ [0,4,6] ~").scale("C4:mixolydian").s("ep:wr").gain(0.16)
  .attack(0.005).decay(0.25).sustain(0.2).release(0.22).room(0.26).orbit(1)
// lead
$: note("~ 4 2 6  4 0 <2 7> ~").scale("C4:mixolydian").s("plk:mm").gain(0.18).cut(1)
