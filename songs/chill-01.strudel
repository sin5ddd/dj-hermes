// @title chill-01
// @genre chill
// @details sparse kit + sine bass + soft triangle lead (skill bed)
setcpm(100/4)
// drums
$: s("bd ~ ~ ~, [~ sd]*2, [~ hh]*4").gain(0.45)
// bass
$: note("0 ~ 2 ~ 0 <3 4>").scale("C2:minor").s("sine").lpf(350).gain(0.5)
// lead
$: note("~ 4 ~ 7 ~ <6 9>").scale("C3:minor").s("triangle").lpf(1800).gain(0.2)
