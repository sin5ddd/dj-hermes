// @title chill-pop-09
// @genre chill-pop
// @details house floor bs:hf + monophonic ld:ss (no pad, no second sub)
setcpm(110/4)
// drums
$: s("bd*4, [~ cp]*2, [~ hh]*4").gain(0.5)
// bass
$: note("0 0 4 0").scale("C4:major").s("bs:hf").gain(0.42)
// hook
$: note("4 ~ 7 4").scale("C4:major").s("ld:ss").gain(0.24).cut(1)
