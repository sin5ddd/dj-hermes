// @title electro-09
// @genre electro
// @details zap kick, octave square + ld:ss @ 126
setcpm(126/4)
// drums
$: s("bd:ez*4, [~ sd:9s]*2, hh:cl*8").gain(0.5)
// bass
$: note("0 7 0 <3 5>").scale("C2:minor").s("square").lpf(640).gain(0.44)
  .attack(0.001).decay(0.06).sustain(0.16).release(0.03)
// lead
$: note("7 ~ 4 0").scale("C4:minor").s("ld:ss").gain(0.16).cut(1)
