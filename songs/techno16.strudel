// title: techno16
// 16-bar dark techno loop @ 128 BPM
setcpm(128/4)
// kick
$: s("<[bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd bd ~ bd] [bd ~ bd bd] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4] [bd*4]>").gain(0.92)
// hat
$: s("<[hh*8] [hh*8] [hh*8] [hh*8] [hh*8] [hh*16] [hh*8] [hh*8] [hh*4] [hh*4] [hh*8] [hh*16] [hh*8] [hh*16] [hh*8] [hh*16]>").gain(0.28)
// snare
$: s("<[~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ [sd sd]] [~ ~ ~ sd] [~ sd ~ ~] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ [sd sd]] [~ sd ~ sd] [sd ~ sd sd]>").gain(0.78)
// bass
$: note("<[c2 c2 eb2 g2] [c2 c2 eb2 g2] [c2 bb1 eb2 g2] [c2 c2 f2 g2] [c2 c2 eb2 g2] [c2 c2 eb2 bb2] [c2 bb1 eb2 g2] [c2 c2 f2 g2] [c2 ~ ~ ~] [~ ~ eb2 g2] [c2 c2 eb2 g2] [c2 c2 eb2 g2] [c2 bb1 eb2 g2] [c2 c2 f2 bb2] [c2 c2 eb2 g2] [c2 g2 bb2 c3]>").s("sawtooth").lpf(380).gain(0.55).attack(0.005).decay(0.12).sustain(0.35).release(0.08)
// stab
$: note("<[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ g3 ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ bb3 ~ ~] [~ ~ g3 ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ g3 ~] [~ eb4 ~ ~] [~ ~ g3 ~] [~ bb3 ~ g3] [~ ~ ~ ~] [g3 ~ bb3 c4]>").s("square").lpf(2200).gain(0.22).attack(0.001).decay(0.08).sustain(0.2).release(0.05)
