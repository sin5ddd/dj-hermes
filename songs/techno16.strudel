// @title techno16
// @genre techno
// @details 16-bar dark techno loop @ 128 BPM
// cat() = one cycle (bar) per arg — same as mini "<a b c>"
setcpm(128/4)

// drums — kick + hat + snare parallel
$: s(cat(
  cat(
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*16, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ [sd sd]]"
  ),
  "bd bd ~ bd, hh*4, [~ ~ ~ sd]",
  "bd ~ bd bd, hh*4, [~ sd ~ ~]",
  cat(
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*16, [~ sd ~ sd]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*16, [~ sd ~ [sd sd]]",
    "bd*4, hh*8, [~ sd ~ sd]",
    "bd*4, hh*16, [sd ~ sd sd]"
  )
)).gain(0.55)

// bass — C2:minor degrees (−1 = bb below root)
$: note(cat(
  cat(
    "0 0 2 4", "0 0 2 4", "0 -1 2 4", "0 0 3 4",
    "0 0 2 4", "0 0 2 6", "0 -1 2 4", "0 0 3 4"
  ),
  "0 ~ ~ ~", "~ ~ 2 4",
  cat(
    "0 0 2 4", "0 0 2 4", "0 -1 2 4",
    "0 0 3 6", "0 0 2 4", "0 4 6 7"
  )
)).scale("C2:minor")
.s("sawtooth").lpf(380).gain(0.55).attack(0.005).decay(0.12).sustain(0.35).release(0.08)

// stab — C3:minor degrees
$: note(cat(
  cat("~", "~", "~ ~ 4 ~", "~", "~", "~ 6 ~ ~", "~ ~ 4 ~", "~"),
  "~", "~",
  cat("~ ~ 4 ~", "~ 9 ~ ~", "~ ~ 4 ~", "~ 6 ~ 4", "~", "4 ~ 6 7")
)).scale("C3:minor")
.s("square").lpf(2200).gain(0.22).attack(0.001).decay(0.08).sustain(0.2).release(0.05)
