// @title pump-dark
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.88).duckorbit(2).duckattack(0.04).duckdepth(0.88)
// hats
$: s("[~ hh]*4").gain(0.32)
// bass
$: note("0 0 2 0").scale("C2:minor")
  .s("sine").fm(2.5).fmh(1).fmdec(0.3).fmsus(0.25).lpf(360).gain(0.5)
  .attack(0.005).decay(0.1).sustain(0.3).release(0.08)
  .orbit(2)
// pad
$: note("[0,2,4] ~ [0,2,4] ~").scale("C3:minor")
  .s("sawtooth").lpf(620).orbit(2).gain(0.28)
  .attack(0.06).sustain(0.65).release(0.22)
