// @title progressive-house-14
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd*4, [~ cp]*2, hh*16, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("plk:hb").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<E5:minor E5:minor A5:dorian E5:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("ep:ky").gain(0.24)
// pad
$: note("0").scale("<E4:minor E4:minor A4:dorian E4:minor>")
  .s("pf:ff").gain(0.18).room(0.4).orbit(2)
