// @title tight-lift
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd:9p*4, [~ cp]*2, [~ hh:hs]*4").gain(0.58)
// bass
$: note("0 4 4 0").scale("C4:minor").s("bs:ht").gain(0.4)
// pad
$: note("[4,6,8] ~ [0,2,4] ~").scale("C3:minor").s("sawtooth").lpf(850).attack(0.1).sustain(0.62).release(0.28).gain(0.26)
