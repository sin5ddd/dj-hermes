// @title progressive-house-28
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd:hf*4, [~ cp:rm]*2, hh*8, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("plk:tg").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<A5:minor A5:minor D6:dorian A5:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("ep:wr").gain(0.24)
// pad
$: note("<0 ~ ~ ~>").scale("<A4:minor A4:minor D5:dorian A4:minor>")
  .s("pf:ju").cut(1).gain(0.18).room(0.4).orbit(2)
