// @title progressive-house-03
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd*4, [~ cp]*2, hh*8, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("bs:hf").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ld:ss").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("plk:hb").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<Eb5:minor Eb5:minor Ab5:dorian Eb5:minor>")
  .s("triangle").lpf(2800).gain(0.12)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Eb3:minor Eb3:minor Ab3:dorian Eb3:minor>")
  .s("sawtooth").lpf(1200).gain(0.24)
  .attack(0.04).release(0.25)
// pad
$: note("[0,4]").scale("<Eb3:minor Eb3:minor Ab3:dorian Eb3:minor>")
  .s("sawtooth").lpf(900).attack(0.1).release(0.4).gain(0.18).room(0.4).orbit(2)
