// @title progressive-house-19
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd*4, [~ cp]*2, hh:hs*16, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("ld:us").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("plk:tg").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<Bb5:minor Bb5:minor Eb6:dorian Bb5:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Bb4:minor Bb4:minor Eb5:dorian Bb4:minor>")
  .s("ep:wr").gain(0.24)
// pad
$: note("0").scale("<Bb2:minor Bb2:minor Eb3:dorian Bb2:minor>")
  .s("ld:fp").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.18).room(0.4).orbit(2)
