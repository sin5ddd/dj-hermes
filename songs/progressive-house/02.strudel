// @title progressive-house-02
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd*4, [~ cp:rm]*2, hh*8, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("bs:sw").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("ld:tg").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("plk:ss").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<D5:minor D5:minor G5:dorian D5:minor>")
  .s("plk:hd").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("plk:sm").gain(0.24)
// pad
$: note("<0 ~ ~ ~>").scale("<D4:minor D4:minor G4:dorian D4:minor>")
  .s("pf:wm").cut(1).gain(0.18).room(0.4).orbit(2)
