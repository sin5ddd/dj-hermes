// @title progressive-house-13
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd:hf*4, [~ cp]*2, hh*16, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("bs:ht").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ld:an").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("plk:tg").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<Eb5:minor Eb5:minor Ab5:dorian Eb5:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("ep:wr").gain(0.24)
// pad
$: note("<0 ~ ~ ~>").scale("<Eb4:minor Eb4:minor Ab4:dorian Eb4:minor>")
  .s("pf:ju").cut(1).gain(0.18).room(0.4).orbit(2)
