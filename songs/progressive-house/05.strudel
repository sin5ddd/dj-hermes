// @title progressive-house-05
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd:hf*4, [~ cp]*2, hh*8, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("bs:sw").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("ld:an").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("plk:ss").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<F5:minor F5:minor Bb5:dorian F5:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<F4:minor F4:minor Bb4:dorian F4:minor>")
  .s("plk:sm").gain(0.24)
// pad
$: note("0").scale("<F2:minor F2:minor Bb2:dorian F2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.18).room(0.4).orbit(2)
