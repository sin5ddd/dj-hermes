// @title progressive-house-17
// @genre progressive-house
setcpm(128/4)
// drums
$: s("bd:hf*4, [~ cp]*2, hh*16, <~ ~ ~ oh>").gain(0.58)
// bass
$: note("0 0 4 <0 2 4 0>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("bs:sw").gain(0.42)
// lead
$: note("4@2 7 9@3 ~").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("ld:an").gain(0.16).cut(1)
// hook
$: note("~ 7 4 <9 7 4 2>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("plk:ss").gain(0.18).cut(1)
// arp
$: note("0 2 4 7  4 2 0 ~").scale("<Ab5:minor Ab5:minor C#6:dorian Ab5:minor>")
  .s("plk:aj").gain(0.12).cut(1)
// chords
$: note("[0,2,4] ~ [0,2,4] ~").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("plk:sm").gain(0.24)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor C#5:dorian Ab4:minor>")
  .s("pf:wm").cut(1).gain(0.18).room(0.4).orbit(2)
