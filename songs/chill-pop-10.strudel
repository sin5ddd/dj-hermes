// @title chill-pop-10
// @genre chill-pop
// @details tight dnb kick + metal bass + evolving FM lead
setcpm(100/4)
// drums
$: s("bd:dn*4, [~ sd]*2, [~ hh]*4").gain(0.48)
// bass
$: note("0 2 0 4").scale("C4:major").s("bs:mt").gain(0.36)
// lead
$: note("9 7 4 0").scale("C4:major")
  .s("sine").fm(3).fmh(2).fmatt(0.01).fmdec(0.3).fmsus(0.25)
  .lpf(1800).lpenv(2).gain(0.26)
