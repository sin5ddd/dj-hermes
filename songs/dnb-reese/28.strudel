// @title dnb-reese-28
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(2500)
// bass
$: note("0 3 0 <0 -1>").scale("A2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("A4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("A4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("11@2 7 12  9@2 7 <12 9 7 4>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:ds").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<A5:minor A5:minor E6:phrygian A5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ep:mt").gain(0.14)
// pad
$: note("0").scale("<A2:minor A2:minor E3:phrygian A2:minor>")
  .s("pf:fo").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.2).orbit(2)
