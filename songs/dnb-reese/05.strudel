// @title dnb-reese-05
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd:jg <~ sd:jg> ~ sd:jg ~ <bd:jg ~> <bd:jg sd:jg> <bd:jg ~>, hh*4, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("F2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("F4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("F4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("~ 11 7 <12 9 7 4>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:nn").gain(0.12).cut(1)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<F5:minor F5:minor C6:phrygian F5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("plk:sf").gain(0.14)
// pad
$: note("<0 ~ ~ ~>").scale("<F4:minor F4:minor C5:phrygian F4:minor>")
  .s("dr:rd").cut(1).gain(0.12).room(0.2).orbit(2)
