// @title dnb-reese-01
// @genre drum and bass
// @details amen, square + bs:rm mid glue @ 174
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*4, [~@5 oh:dn ~@2]]*2").gain(0.68).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("C2:minor").s("square").lpf(120).gain(0.42)
// lead
$: note("0 3 0 <0 -1>").scale("C4:minor").s("bs:rm").gain(0.36)
