// @title dnb-reese-02
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd:jg <~ sd:jg> ~ sd:jg ~ <bd:jg ~> <bd:jg sd:jg> <bd:jg ~>, hh*4, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("D2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("D4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("D4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("11@2 7 12  9@2 7 <12 9 7 4>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:nn").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<D5:minor D5:minor A5:phrygian D5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ep:mt").gain(0.14)
// pad
$: note("0").scale("<D2:minor D2:minor A2:phrygian D2:minor>")
  .s("dr:rd").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.2).orbit(2)
