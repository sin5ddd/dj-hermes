// @title dnb-reese-17
// @genre drum and bass
// @details dust kit, bright-reese + hollow offbeat @ 174
setcpm(174/4)
// drums
$: s("[bd:lf ~ sd:br ~ bd:lf ~ ~ sd:br, hh:dk*4]*2").gain(0.62).lpf(2200)
// bass
$: note("0 2 7 ~").scale("C4:minor").s("bs:rb").gain(0.36)
// lead
$: note("~ 0 4 ~").scale("C4:minor").s("plk:s5").gain(0.2).cut(1)
