// @title dnb-reese-06
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd <~ sd> ~ sd ~ <bd ~> <bd sd> <bd ~>, hh*4, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("G2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("G4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("G4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("~ 11 7 <12 9 7 4>").scale("<G4:minor G4:minor D5:phrygian G4:minor>")
  .s("square").lpf(2800).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<G5:minor G5:minor D6:phrygian G5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("triangle").lpf(1400).gain(0.14)
// pad
$: note("[0,4]").scale("<G3:minor G3:minor D4:phrygian G3:minor>")
  .s("sine").fm(1.2).fmh(1).fmdec(0.8).fmsus(0.4)
  .room(0.2).orbit(2).gain(0.12)
