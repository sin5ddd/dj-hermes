// @title dnb-reese-19
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*8, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("Bb2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("Bb4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("Bb4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("~ 11 7 <12 9 7 4>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ld:ds").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Bb5:minor Bb5:minor F6:phrygian Bb5:minor>")
  .s("plk:nn").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("plk:sf").gain(0.14)
// pad
$: note("0").scale("<Bb2:minor Bb2:minor F3:phrygian Bb2:minor>")
  .s("pf:fo").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.2).orbit(2)
