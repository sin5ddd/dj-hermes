// @title dnb-reese-19
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd <~ sd> ~ sd ~ <bd ~> <bd sd> <bd ~>, hh*8, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("Bb2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("Bb4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("Bb4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("~ 11 7 <12 9 7 4>").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ld:ss").gain(0.12).cut(1)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<Bb5:minor Bb5:minor F6:phrygian Bb5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("ep:mt").gain(0.14)
// pad
$: note("0").scale("<Bb4:minor Bb4:minor F5:phrygian Bb4:minor>")
  .s("pf:ff").gain(0.12).room(0.2).orbit(2)
