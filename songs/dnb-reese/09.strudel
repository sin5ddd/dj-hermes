// @title dnb-reese-09
// @genre drum and bass
// @details amen, amen-sub + fx:id once per 4 bars @ 174
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*4]*2").gain(0.68).lpf(4000)
// bass
$: note("0 5 0 <3 0>").scale("C4:minor").s("bs:am").gain(0.44)
// fx
$: s("<fx:id ~ ~ ~>").gain(0.28)
