// @title dnb-reese-12
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd <~ sd> ~ sd ~ <bd ~> <bd sd> <bd ~>, hh*8, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1>").scale("D2:minor").s("square").lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1>").scale("D4:minor").s("bs:rm").gain(0.36)
// hook
$: note("~ 4 ~ <7 4>").scale("D4:minor").s("plk:s5").gain(0.2).cut(1)
// lead
$: note("~ 11 7 <12 9 7 4>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("square").lpf(2800).gain(0.12)
// arp
$: note("~ 0 7 12  7 0 ~ 4").scale("<D5:minor D5:minor A5:phrygian D5:minor>")
  .s("plk:dt").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ ~ [0,4]").scale("<D3:minor D3:minor A3:phrygian D3:minor>")
  .s("triangle").lpf(1400).gain(0.14)
// pad
$: note("[0,4]").scale("<D3:minor D3:minor A3:phrygian D3:minor>")
  .s("sine").fm(1.2).fmh(1).fmdec(0.8).fmsus(0.4)
  .room(0.2).orbit(2).gain(0.12)
