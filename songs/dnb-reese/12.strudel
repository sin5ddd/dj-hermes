// @title dnb-reese-12
// @genre drum and bass
// @details gabber, sine-sub + mid-reese hops @ 174
setcpm(174/4)
// drums
$: s("[bd:gb ~ ~ sd:gb ~ ~ ~ sd:gb, hh:ns*8]*2").gain(0.64).lpf(2800)
// bass
$: note("2 7 0 ~").scale("C4:minor").s("bs:ss").gain(0.46)
// lead
$: note("5 2 0 ~").scale("C4:minor").s("bs:rm").gain(0.34)
