// @title dnb-18
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd <~ sd> ~ sd ~ <bd ~> <bd sd> <bd ~>, hh:dn*8, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1 0 3>").scale("A2:minor")
  .s("square").attack(0.01).decay(0.5).release(0.4).lpf(120).gain(0.42)
// bass-mid
$: note("0 3 0 <0 -1 0 3>").scale("A2:minor")
  .s("sawtooth").attack(0.01).decay(0.4).release(0.3).lpf(1000).gain(0.32)
// lead
$: note("7@2 ~ 9  11@2 7 <9 7 4 11>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ld:dp").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.14)
// hook
$: note("~ 4 7@2  4 7 4 <7 4 4 7>").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("plk:dt").gain(0.16).cut(1)
// arp
$: note("0 7 12 7  0 4 7 12").scale("<A5:minor A5:minor E6:phrygian A5:minor>")
  .s("plk:lp").gain(0.12).cut(1)
// chords
$: note("[0,4] ~ [0,4] ~").scale("<A4:minor A4:minor E5:phrygian A4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<A2:minor A2:minor E3:phrygian A2:minor>")
  .s("pf:ff").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.22).orbit(2)
