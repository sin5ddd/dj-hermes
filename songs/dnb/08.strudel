// @title dnb-08
// @genre drum and bass
// @details jungle-rounder, bs:am + short fx:id @ 174
setcpm(174/4)
// drums
$: s("[bd:jg <~ sd:jg> ~ sd:jg ~ <bd:jg ~> <bd:jg sd:jg> <bd:jg ~>, hh:dn*4]*2").gain(0.66).lpf(3600)
// bass
$: note("0 3 ~ -1").scale("C4:minor").s("bs:am").gain(0.46)
// fx
$: s("<fx:id ~ ~ ~>").gain(0.28)
