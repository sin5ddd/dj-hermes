// @title dnb-07
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd:dn <~ sd:dn> ~ sd:dn ~ <bd:dn ~> <bd:dn sd:dn> <bd:dn ~>, hh:dn*4, [~@5 oh:dn ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1 0 3>").scale("Ab2:minor")
  .s("square").lpf(120).gain(0.42)
  .attack(0.01).decay(0.5).release(0.4)
// bass-mid
$: note("0 3 0 <0 -1 0 3>").scale("Ab2:minor")
  .s("sawtooth").lpf(1000).gain(0.32)
  .attack(0.01).decay(0.4).release(0.3)
// lead
$: note("~ 7 ~ <9 7 4 11>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("ld:ds").gain(0.14).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:nn").gain(0.16).cut(1)
// arp
$: s("<~ perc:tm ~ perc:st>").gain(0.16)
// chords
$: note("[0,4] ~ [0,4] ~").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("plk:s5").gain(0.16)
// pad
$: note("<0 ~ ~ ~>").scale("<Ab4:minor Ab4:minor Eb5:phrygian Ab4:minor>")
  .s("pf:fo").cut(1).gain(0.12).room(0.22).orbit(2)
