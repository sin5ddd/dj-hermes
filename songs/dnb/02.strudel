// @title dnb-02
// @genre drum and bass
setcpm(174/4)
// drums
$: s("[bd <~ sd> ~ sd ~ <bd ~> <bd sd> <bd ~>, hh*4, [~@5 oh ~@2]]*2").gain(0.7).lpf(4000)
// bass
$: note("0 3 0 <0 -1 0 3>").scale("D2:minor")
  .s("square").lpf(120).gain(0.42)
  .attack(0.01).decay(0.5).release(0.4)
// bass-mid
$: note("0 3 0 <0 -1 0 3>").scale("D2:minor")
  .s("sawtooth").lpf(1000).gain(0.32)
  .attack(0.01).decay(0.4).release(0.3)
// lead
$: note("~ 7 ~ <9 7 4 11>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ld:ss").gain(0.14).cut(1)
// hook
$: note("~ 4 ~ <7 4 4 7>").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("plk:dt").gain(0.16).cut(1)
// arp
$: s("<~ perc:st ~ perc:tm>").gain(0.16)
// chords
$: note("[0,4] ~ [0,4] ~").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("ep:mt").gain(0.16)
// pad
$: note("0").scale("<D4:minor D4:minor A4:phrygian D4:minor>")
  .s("pf:ff").gain(0.12).room(0.22).orbit(2)
