// @title grit-run
// @genre acid
setcpm(130/4)
// drums
$: s("bd:fn*4, [~ hh:pd]*4").gain(0.62)
// bass
$: note("2 5 3 0  7 2 0 5  3 0 7 4  0 2 -1 <5 7>")
  .scale("C2:minor")
  .s("square")
  .lpf("240 740 240 240  240 240 710 240  780 240 240 240  240 690 240 760")
  .lpq(14)
  .lpenv(3)
  .lpattack(0.001)
  .lpdecay(0.09)
  .lpsustain(0.05)
  .cut(1)
  .gain(0.46)
  .attack(0.001)
  .decay(0.1)
  .sustain(0.12)
  .release(0.04)
// fx
$: s("<fx:rf ~ ~ ~>").gain(0.22)
