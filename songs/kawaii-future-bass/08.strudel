// @title kawaii-future-bass-08
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ bd:8t ~] [bd:8t ~ ~ ~] [bd:8t ~ bd:8t ~] [bd:8t ~ ~ bd:8t]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:ch*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]]>").gain(0.42)
// bass
$: note("<[0 ~ 4 0  0 0 4 0] [0 0 0 ~  4 0 2 0] [0 4 0 2  ~ 0 0 4] [0 0 2 0  4 0 ~ 0] [0 4 ~ 0  0 4 2 0] [0 0 4 0  ~ 2 0 4] [0 2 0 ~  0 0 4 0] [0 0 ~ 4  0 2 4 0]>")
  .scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor D5:lydian E5:mixolydian C#5:phrygian F#5:minor F#5:minor C#5:phrygian E5:mixolydian D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian>")
  .s("bs:8s").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[~ 4 2 ~  7 9 4 2] [2 4 ~ 7  9 ~ 4 0] [~ 7 2 4  9 4 ~ 2] [4 7 9 ~  2 4 ~ 7] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7]>")
  .scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor D5:lydian E5:mixolydian C#5:phrygian F#5:minor F#5:minor C#5:phrygian E5:mixolydian D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian>")
  .s("square").lpf(3200).gain(0.16).cut(1)
// hook
$: note("<[~ 9 12 ~  11 9 ~ 12] [9 ~ 11 12  7 ~ 9 11] [~ 12 7 9  11 4 12 ~] [11 9 ~ 7  12 4 ~ 11] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4] [9 ~ 4 12  ~ 7 0 9] [~ 11 7 0  4 ~ 9 2] [12 4 ~ 7  0 2 4 ~] [~ 7 0 4  2 9 4 0] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4]>")
  .scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor D5:lydian E5:mixolydian C#5:phrygian F#5:minor F#5:minor C#5:phrygian E5:mixolydian D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian>")
  .s("plk:mb").gain(0.18).cut(1)
// arp
$: note("<[~ 0 ~ 4  ~ ~ ~ ~] [~ ~ ~ 0  ~ ~ ~ ~] [0 ~ ~ ~  ~ 4 ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 4 ~ ~  ~ ~ ~ ~] [0 ~ ~ ~  ~ ~ 0 ~] [~ ~ 4 ~  ~ 0 ~ ~] [~ 0 ~ ~  ~ ~ 4 ~]>")
  .scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor D5:lydian E5:mixolydian C#5:phrygian F#5:minor F#5:minor C#5:phrygian E5:mixolydian D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian>")
  .s("vc:na").gain(0.14).cut(1)
// chords
$: note("<[~ [0,4,8] ~ [0,4,8]  [0,2,8] ~ [0,4,8] ~] [[0,4,8] ~ ~ [0,2,8]  [0,4,8] ~ [0,2,8] [0,4,8]] [~ [0,2,8] [0,4,8] ~  [0,4,8] ~ ~ [0,2,8]] [[0,4,8] ~ [0,4,8] ~  ~ [0,2,8] [0,4,8] ~]>")
  .scale("<D5:lydian E5:mixolydian C#5:phrygian F#5:minor D5:lydian E5:mixolydian C#5:phrygian F#5:minor F#5:minor C#5:phrygian E5:mixolydian D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian>")
  .s("plk:ch").gain(0.2).orbit(2)
// pad
$: note("<~ 0 ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~ 0>").scale("<D3:lydian E3:mixolydian C#3:phrygian F#3:minor D3:lydian E3:mixolydian C#3:phrygian F#3:minor F#3:minor C#3:phrygian E3:mixolydian D3:lydian A2:major Ab3:locrian F#3:minor E3:mixolydian>")
  .s("pf:ga").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<0 ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~>").scale("<D3:lydian E3:mixolydian C#3:phrygian F#3:minor D3:lydian E3:mixolydian C#3:phrygian F#3:minor F#3:minor C#3:phrygian E3:mixolydian D3:lydian A2:major Ab3:locrian F#3:minor E3:mixolydian>")
  .s("pf:ca").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
