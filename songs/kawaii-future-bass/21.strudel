// @title kawaii-future-bass-21
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ bd:8t] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:tt*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]]>").gain(0.42)
// bass
$: note("<[0 0 4 ~  0 0 0 4] [0 4 0 0  ~ 2 0 0] [0 ~ 0 4  0 0 4 2] [0 0 2 ~  0 4 0 0] [0 4 0 4  0 ~ 0 0] [0 0 ~ 0  4 2 0 4] [0 2 0 0  4 ~ 0 2] [0 0 4 0  ~ 0 2 0]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian C4:major B4:locrian A4:minor G4:mixolydian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("bs:su").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[2@2 4 7@2 9 4 2] [4@2 7 9@2 4 2 7] [9@2 4 2 7@2 4 0] [7 4@2 9 4 2@2 7] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2@2] [4@2 7 9@2 7 4 2] [4 7 11 9 7@2 4 2] [11@2 9 4 7 2 0@2] [9@2 7 11 4 0 2 4] [7 4 2 0@2 4 7 11] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2@2] [4@2 7 9@2 7 4 2]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian C4:major B4:locrian A4:minor G4:mixolydian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 11 ~ 12  ~ 9 ~ 11] [~ 12 ~ 9  ~ 11 ~ 7] [~ 11 ~ 12  ~ 9 ~ 4] [~ 9 ~ 7  ~ 4 ~ 11] [11 ~ 12 9  ~ 11 12 9] [~ 11 ~ 12  9 ~ 11 7] [11 12 ~ 9  11 ~ 12 9] [11 12 9 11  12 9 11 7] [~ 12 ~ 9  ~ 7 ~ 4] [~ 11 ~ 7  ~ 4 ~ 0] [~ 9 ~ 4  ~ 7 ~ 2] [~ 7 ~ 4  ~ 2 ~ 0] [11 ~ 12 9  ~ 11 12 9] [~ 11 ~ 12  9 ~ 11 7] [11 12 ~ 9  11 ~ 12 9] [11 12 9 11  12 9 11 7]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian C4:major B4:locrian A4:minor G4:mixolydian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("plk:bl").gain(0.18).cut(1)
// arp
$: note("<[~ 0 ~ ~  ~ ~ ~ ~] [0 ~ ~ ~  ~ 4 ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  ~ ~ 0 ~] [0 ~ ~ ~  ~ ~ 4 ~] [~ ~ ~ 0  ~ ~ ~ ~] [~ 0 ~ 4  ~ ~ ~ ~] [4 ~ ~ ~  ~ 0 ~ ~]>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian C4:major B4:locrian A4:minor G4:mixolydian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("vc:pa").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<C4:major G4:mixolydian A4:minor F4:lydian C4:major G4:mixolydian A4:minor F4:lydian C4:major B4:locrian A4:minor G4:mixolydian F4:lydian A4:minor G4:mixolydian C4:major>")
  .s("ep:rs").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<C2:major G2:mixolydian A2:minor F2:lydian C2:major G2:mixolydian A2:minor F2:lydian C2:major B2:locrian A2:minor G2:mixolydian F2:lydian A2:minor G2:mixolydian C2:major>")
  .s("pf:ga").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<C2:major G2:mixolydian A2:minor F2:lydian C2:major G2:mixolydian A2:minor F2:lydian C2:major B2:locrian A2:minor G2:mixolydian F2:lydian A2:minor G2:mixolydian C2:major>")
  .s("ld:cr").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
