// @title kawaii-future-bass-14
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, [~ hh:hs]*4").gain(0.42)
// bass
$: note("<[0 4 ~ 0  0 4 0 ~] [0 0 0 4  2 0 ~ 0] [0 0 4 0  ~ 0 2 4] [0 2 ~ 0  0 4 0 0] [0 ~ 0 4  0 0 ~ 4] [0 4 0 2  0 0 4 ~] [0 0 2 0  ~ 4 0 0] [0 4 0 ~  2 0 0 4]>")
  .scale("<C#5:minor A4:lydian B4:mixolydian E4:major C#5:minor A4:lydian B4:mixolydian E4:major E4:major Eb5:locrian C#5:minor B4:mixolydian E4:major B4:mixolydian A4:lydian C#5:minor>")
  .s("bs:8s").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4@3 7 9@2 4 2] [7@3 9 4 7@2 2] [9 4@2 7@2 2 0 4] [4@2 9 7 2@2 4 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4] [11@2 7 4 9 2@2 4] [11 4@2 7@2 2 0 4] [7@2 4 2 0 4 7@2] [4 2@2 0 7@2 4 9] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4]>")
  .scale("<C#5:minor A4:lydian B4:mixolydian E4:major C#5:minor A4:lydian B4:mixolydian E4:major E4:major Eb5:locrian C#5:minor B4:mixolydian E4:major B4:mixolydian A4:lydian C#5:minor>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 12 ~ 11  ~ 7 ~ 9] [12 ~ 9 11  ~ 4 ~ 12] [~ 11 9 12  ~ 7 4 9] [9 ~ 12 7  ~ 11 4 0] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4] [~ 9 ~ 12  ~ 4 ~ 7] [11 ~ 4 0  ~ 7 ~ 9] [~ 7 12 4  0 ~ 2 4] [9 4 ~ 0  2 7 ~ 4] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4]>")
  .scale("<C#5:minor A4:lydian B4:mixolydian E4:major C#5:minor A4:lydian B4:mixolydian E4:major E4:major Eb5:locrian C#5:minor B4:mixolydian E4:major B4:mixolydian A4:lydian C#5:minor>")
  .s("plk:bl").gain(0.18).cut(1)
// arp
$: note("<[0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 0 ~ ~  ~ ~ ~ ~] [~ ~ ~ 4  ~ 0 ~ ~] [0 ~ ~ 4  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  0 ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~]>")
  .scale("<C#5:minor A4:lydian B4:mixolydian E4:major C#5:minor A4:lydian B4:mixolydian E4:major E4:major Eb5:locrian C#5:minor B4:mixolydian E4:major B4:mixolydian A4:lydian C#5:minor>")
  .s("vc:na").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<C#5:minor A4:lydian B4:mixolydian E4:major C#5:minor A4:lydian B4:mixolydian E4:major E4:major Eb5:locrian C#5:minor B4:mixolydian E4:major B4:mixolydian A4:lydian C#5:minor>")
  .s("ep:ky").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<C#3:minor A2:lydian B2:mixolydian E2:major C#3:minor A2:lydian B2:mixolydian E2:major E2:major Eb3:locrian C#3:minor B2:mixolydian E2:major B2:mixolydian A2:lydian C#3:minor>")
  .s("ps:mx").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<C#3:minor A2:lydian B2:mixolydian E2:major C#3:minor A2:lydian B2:mixolydian E2:major E2:major Eb3:locrian C#3:minor B2:mixolydian E2:major B2:mixolydian A2:lydian C#3:minor>")
  .s("pf:wm").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
// vox
$: s("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ iv:ses>").gain(0.5).cut(1)
