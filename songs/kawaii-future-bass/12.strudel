// @title kawaii-future-bass-12
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ bd:8d ~] [bd:8d ~ ~ ~] [bd:8d ~ bd:8d ~] [bd:8d ~ ~ bd:8d]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:tt*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]]>").gain(0.42)
// bass
$: note("<[0 4 0 0  ~ 0 4 0] [0 0 ~ 4  0 2 0 0] [0 0 4 0  2 ~ 0 4] [0 ~ 0 0  4 0 2 0] [0 0 0 ~  4 0 0 4] [0 4 ~ 0  0 2 ~ 0] [0 0 4 2  0 ~ 0 0] [0 2 0 4  ~ 0 0 2]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("bs:su").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[7 ~ 4 ~  9 4 ~ 2] [~ 4 7 2  9 ~ 4 7] [4 9 ~ 7  ~ 2 4 0] [~ 7 4 9  2 0 ~ 4] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7] [~ 4 9 7  11 4 ~ 2] [4 11 ~ 7  9 2 0 ~] [~ 7 11 4  2 0 4 7] [11 7 4 2  ~ 0 4 9] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("square").lpf(3200).gain(0.16).cut(1)
// hook
$: note("<[~ 9 12 ~  11 9 ~ 12] [9 ~ 11 12  7 ~ 9 11] [~ 12 7 9  11 4 12 ~] [11 9 ~ 7  12 4 ~ 11] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4] [9 ~ 4 12  ~ 7 0 9] [~ 11 7 0  4 ~ 9 2] [12 4 ~ 7  0 2 4 ~] [~ 7 0 4  2 9 4 0] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:ch").gain(0.18).cut(1)
// arp
$: note("<[~ 0 ~ 4  ~ ~ ~ ~] [~ ~ ~ 0  ~ ~ ~ ~] [0 ~ ~ ~  ~ 4 ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 4 ~ ~  ~ ~ ~ ~] [0 ~ ~ ~  ~ ~ 0 ~] [~ ~ 4 ~  ~ 0 ~ ~] [~ 0 ~ ~  ~ ~ 4 ~]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("vc:pa").gain(0.14).cut(1)
// chords
$: note("<[~ [0,4,8] ~ [0,4,8]  [0,2,8] ~ [0,4,8] ~] [[0,4,8] ~ ~ [0,2,8]  [0,4,8] ~ [0,2,8] [0,4,8]] [~ [0,2,8] [0,4,8] ~  [0,4,8] ~ ~ [0,2,8]] [[0,4,8] ~ [0,4,8] ~  ~ [0,2,8] [0,4,8] ~]>")
  .scale("<B4:minor G4:lydian A4:mixolydian D4:major B4:minor G4:lydian A4:mixolydian D4:major D4:major A4:mixolydian G4:lydian B4:minor D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:sm").gain(0.2).orbit(2)
// pad
$: note("<~ 0 ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~ 0>").scale("<B2:minor G2:lydian A2:mixolydian D2:major B2:minor G2:lydian A2:mixolydian D2:major D2:major A2:mixolydian G2:lydian B2:minor D2:major C#3:locrian B2:minor A2:mixolydian>")
  .s("pf:sp").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<0 ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~>").scale("<B2:minor G2:lydian A2:mixolydian D2:major B2:minor G2:lydian A2:mixolydian D2:major D2:major A2:mixolydian G2:lydian B2:minor D2:major C#3:locrian B2:minor A2:mixolydian>")
  .s("pf:ca").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
