// @title kawaii-future-bass-10
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ ~ ~] [bd:8d ~ ~ ~] [bd:8d [~ bd:8d] ~ ~] [bd:8d ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, [~ hh:tt]*4").gain(0.42)
// bass
$: note("<[0 0 0 4  0 ~ 0 0] [0 ~ 4 0  0 0 4 ~] [0 4 0 0  ~ 0 2 0] [0 0 ~ 0  4 0 0 2] [0 0 4 ~  0 0 0 4] [0 4 0 0  2 ~ 0 0] [0 ~ 0 4  0 4 ~ 0] [0 0 0 2  0 4 0 ~]>")
  .scale("<E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor Ab5:minor Eb5:phrygian F#5:mixolydian E5:lydian B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4@3 7@2 9 7 4] [7@2 4 9 7@2 4 2] [4@2 9 7@2 4 2 0] [4@2 7 9 4 7@2 11] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4] [9@2 4 7@2 2 0 4] [7@2 9 2 4 0@2 7] [4@2 2 0@2 7 4 2] [2@2 0 4 7 4 9 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4]>")
  .scale("<E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor Ab5:minor Eb5:phrygian F#5:mixolydian E5:lydian B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 12 ~ 11  ~ 7 ~ 9] [12 ~ 9 11  ~ 4 ~ 12] [~ 11 9 12  ~ 7 4 9] [9 ~ 12 7  ~ 11 4 0] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4] [~ 9 ~ 12  ~ 4 ~ 7] [11 ~ 4 0  ~ 7 ~ 9] [~ 7 12 4  0 ~ 2 4] [9 4 ~ 0  2 7 ~ 4] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4]>")
  .scale("<E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor Ab5:minor Eb5:phrygian F#5:mixolydian E5:lydian B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("<[0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 0 ~ ~  ~ ~ ~ ~] [~ ~ ~ 4  ~ 0 ~ ~] [0 ~ ~ 4  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  0 ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~]>")
  .scale("<E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor Ab5:minor Eb5:phrygian F#5:mixolydian E5:lydian B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor E5:lydian F#5:mixolydian Eb5:phrygian Ab5:minor Ab5:minor Eb5:phrygian F#5:mixolydian E5:lydian B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("ep:pd").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<E3:lydian F#3:mixolydian Eb3:phrygian Ab3:minor E3:lydian F#3:mixolydian Eb3:phrygian Ab3:minor Ab3:minor Eb3:phrygian F#3:mixolydian E3:lydian B2:major Bb3:locrian Ab3:minor F#3:mixolydian>")
  .s("pf:sp").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<E3:lydian F#3:mixolydian Eb3:phrygian Ab3:minor E3:lydian F#3:mixolydian Eb3:phrygian Ab3:minor Ab3:minor Eb3:phrygian F#3:mixolydian E3:lydian B2:major Bb3:locrian Ab3:minor F#3:mixolydian>")
  .s("pf:wm").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
