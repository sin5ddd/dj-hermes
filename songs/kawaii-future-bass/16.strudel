// @title kawaii-future-bass-16
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ bd:8t ~] [bd:8t ~ ~ ~] [bd:8t ~ bd:8t ~] [bd:8t ~ ~ bd:8t]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:hs*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:hs*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:hs*4]]>").gain(0.42)
// bass
$: note("<[0 ~ 4 0  0 0 4 0] [0 0 0 ~  4 0 2 0] [0 4 0 2  ~ 0 0 4] [0 0 2 0  4 0 ~ 0] [0 4 ~ 0  0 4 2 0] [0 0 4 0  ~ 2 0 4] [0 2 0 ~  0 0 4 0] [0 0 ~ 4  0 2 4 0]>")
  .scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[~ 4 2 ~  7 9 4 2] [2 4 ~ 7  9 ~ 4 0] [~ 7 2 4  9 4 ~ 2] [4 7 9 ~  2 4 ~ 7] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7] [~ 9 7 4  2 0 ~ 4] [9 ~ 7 4  ~ 2 0 4] [7 4 ~ 2  0 ~ 4 7] [~ 4 2 0  4 7 ~ 9] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7]>")
  .scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("square").lpf(3200).gain(0.16).cut(1)
// hook
$: note("<[~ 9 12 ~  11 9 ~ 12] [9 ~ 11 12  7 ~ 9 11] [~ 12 7 9  11 4 12 ~] [11 9 ~ 7  12 4 ~ 11] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4] [9 ~ 4 12  ~ 7 0 9] [~ 11 7 0  4 ~ 9 2] [12 4 ~ 7  0 2 4 ~] [~ 7 0 4  2 9 4 0] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4]>")
  .scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("plk:mb").gain(0.18).cut(1)
// arp
$: note("<[0 7 ~ 4  12 4 ~ 7] [4 ~ 0 9  7 4 12 ~] [~ 4 7 0  9 ~ 4 0] [7 12 4 0  ~ 7 4 9] [0 ~ 9 4  7 12 0 4] [4 7 ~ 0  12 ~ 7 4] [9 0 4 7  ~ 4 12 0] [~ 0 7 4  9 4 0 7]>")
  .scale("<E6:minor C6:lydian D6:mixolydian G5:major E6:minor C6:lydian D6:mixolydian G5:major G5:major D6:mixolydian C6:lydian E6:minor G5:major F#6:locrian E6:minor D6:mixolydian>")
  .s("plk:fc").gain(0.12).cut(1)
// chords
$: note("<[~ [0,4,8] ~ [0,4,8]  [0,2,8] ~ [0,4,8] ~] [[0,4,8] ~ ~ [0,2,8]  [0,4,8] ~ [0,2,8] [0,4,8]] [~ [0,2,8] [0,4,8] ~  [0,4,8] ~ ~ [0,2,8]] [[0,4,8] ~ [0,4,8] ~  ~ [0,2,8] [0,4,8] ~]>")
  .scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("plk:ch").gain(0.2).orbit(2)
// pad
$: note("<~ 0 ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~ 0>").scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("ps:gb").gain(0.16).room(0.35).orbit(2)
// strings
$: note("<0 ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ 0 ~ ~ 0 ~>").scale("<E5:minor C5:lydian D5:mixolydian G4:major E5:minor C5:lydian D5:mixolydian G4:major G4:major D5:mixolydian C5:lydian E5:minor G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("pf:ca").gain(0.12).room(0.45).orbit(2)
