// @title kawaii-future-bass-22
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, [~ hh:tt]*4").gain(0.42)
// bass
$: note("<[0 4 ~ 0  0 4 0 ~] [0 0 0 4  2 0 ~ 0] [0 0 4 0  ~ 0 2 4] [0 2 ~ 0  0 4 0 0] [0 ~ 0 4  0 0 ~ 4] [0 4 0 2  0 0 4 ~] [0 0 2 0  ~ 4 0 0] [0 4 0 ~  2 0 0 4]>")
  .scale("<D4:major A4:mixolydian B4:minor G4:lydian D4:major A4:mixolydian B4:minor G4:lydian G4:lydian B4:minor A4:mixolydian D4:major D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4 ~ ~ 7  9 ~ 4 2] [~ 7 ~ 9  4 7 ~ 2] [9 4 ~ 7  ~ 2 0 4] [~ 4 9 7  2 ~ 4 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4] [~ 11 7 4  9 2 ~ 4] [11 4 ~ 7  ~ 2 0 4] [7 ~ 4 2  0 4 7 ~] [4 2 ~ 0  7 ~ 4 9] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4]>")
  .scale("<D4:major A4:mixolydian B4:minor G4:lydian D4:major A4:mixolydian B4:minor G4:lydian G4:lydian B4:minor A4:mixolydian D4:major D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("ld:gl").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 12 ~ 11  ~ 7 ~ 9] [12 ~ 9 11  ~ 4 ~ 12] [~ 11 9 12  ~ 7 4 9] [9 ~ 12 7  ~ 11 4 0] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4] [~ 9 ~ 12  ~ 4 ~ 7] [11 ~ 4 0  ~ 7 ~ 9] [~ 7 12 4  0 ~ 2 4] [9 4 ~ 0  2 7 ~ 4] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4]>")
  .scale("<D4:major A4:mixolydian B4:minor G4:lydian D4:major A4:mixolydian B4:minor G4:lydian G4:lydian B4:minor A4:mixolydian D4:major D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:bl").gain(0.18).cut(1)
// arp
$: note("<[0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 0 ~ ~  ~ ~ ~ ~] [~ ~ ~ 4  ~ 0 ~ ~] [0 ~ ~ 4  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  0 ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~]>")
  .scale("<D4:major A4:mixolydian B4:minor G4:lydian D4:major A4:mixolydian B4:minor G4:lydian G4:lydian B4:minor A4:mixolydian D4:major D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[[0,4,8] ~ [0,4,8] ~  [0,2,8] ~ ~ [0,4,8]] [[0,4,8] [0,4,8] ~ [0,2,8]  ~ [0,4,8] ~ ~] [[0,2,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,2,8] ~  [0,4,8] [0,4,8] ~ ~]>")
  .scale("<D4:major A4:mixolydian B4:minor G4:lydian D4:major A4:mixolydian B4:minor G4:lydian G4:lydian B4:minor A4:mixolydian D4:major D4:major C#5:locrian B4:minor A4:mixolydian>")
  .s("plk:ch").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~ 0 ~ ~>").scale("<D2:major A2:mixolydian B2:minor G2:lydian D2:major A2:mixolydian B2:minor G2:lydian G2:lydian B2:minor A2:mixolydian D2:major D2:major C#3:locrian B2:minor A2:mixolydian>")
  .s("pf:sp").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<~ 0 ~ ~ ~ ~ 0 ~ ~ ~ 0 ~ ~ ~ ~ 0>").scale("<D2:major A2:mixolydian B2:minor G2:lydian D2:major A2:mixolydian B2:minor G2:lydian G2:lydian B2:minor A2:mixolydian D2:major D2:major C#3:locrian B2:minor A2:mixolydian>")
  .s("pf:wm").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
