// @title kawaii-future-bass-30
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ ~ ~] [bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, [~ hh:ch]*4").gain(0.42)
// bass
$: note("<[0 4 ~ 0  0 4 0 ~] [0 0 0 4  2 0 ~ 0] [0 0 4 0  ~ 0 2 4] [0 2 ~ 0  0 4 0 0] [0 ~ 0 4  0 0 ~ 4] [0 4 0 2  0 0 4 ~] [0 0 2 0  ~ 4 0 0] [0 4 0 ~  2 0 0 4]>")
  .scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("bs:su").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4 ~ ~ 7  9 ~ 4 2] [~ 7 ~ 9  4 7 ~ 2] [9 4 ~ 7  ~ 2 0 4] [~ 4 9 7  2 ~ 4 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4] [~ 11 7 4  9 2 ~ 4] [11 4 ~ 7  ~ 2 0 4] [7 ~ 4 2  0 4 7 ~] [4 2 ~ 0  7 ~ 4 9] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2 ~ 4] [9@2 7 4@2 2 0 4]>")
  .scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("ld:gl").gain(0.16).cut(1)
// hook
$: note("<[~ 12 ~ 11  ~ 7 ~ 9] [12 ~ 9 11  ~ 4 ~ 12] [~ 11 9 12  ~ 7 4 9] [9 ~ 12 7  ~ 11 4 0] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4] [~ 9 ~ 12  ~ 4 ~ 7] [11 ~ 4 0  ~ 7 ~ 9] [~ 7 12 4  0 ~ 2 4] [9 4 ~ 0  2 7 ~ 4] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4]>")
  .scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("plk:bl").gain(0.18).cut(1)
// arp
$: note("<[0 ~ 7 4  9 ~ 4 0] [4 7 ~ 12  4 0 7 ~] [~ 4 0 9  7 ~ 4 12] [7 0 4 ~  12 4 0 7] [0 9 4 7  ~ 4 0 9] [4 ~ 7 12  0 4 ~ 7] [9 4 0 ~  7 12 4 0] [~ 7 4 9  0 4 7 12]>")
  .scale("<B5:major F#6:mixolydian Ab6:minor E6:lydian B5:major F#6:mixolydian Ab6:minor E6:lydian E6:lydian Ab6:minor F#6:mixolydian B5:major B5:major Bb6:locrian Ab6:minor F#6:mixolydian>")
  .s("plk:fc").gain(0.12).cut(1)
// chords
$: note("<[[0,4,8] ~ [0,4,8] ~  [0,2,8] ~ ~ [0,4,8]] [[0,4,8] [0,4,8] ~ [0,2,8]  ~ [0,4,8] ~ ~] [[0,2,8] ~ ~ [0,4,8]  [0,4,8] ~ [0,2,8] ~] [[0,4,8] ~ [0,2,8] ~  [0,4,8] [0,4,8] ~ ~]>")
  .scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("plk:ch").gain(0.2).orbit(2)
// pad
$: note("<0 ~ ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~ 0 ~ ~>").scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("ps:gb").gain(0.16).room(0.35).orbit(2)
// strings
$: note("<~ 0 ~ ~ ~ ~ 0 ~ ~ ~ 0 ~ ~ ~ ~ 0>").scale("<B4:major F#5:mixolydian Ab5:minor E5:lydian B4:major F#5:mixolydian Ab5:minor E5:lydian E5:lydian Ab5:minor F#5:mixolydian B4:major B4:major Bb5:locrian Ab5:minor F#5:mixolydian>")
  .s("pf:wm").gain(0.12).room(0.45).orbit(2)
