// @title kawaii-future-bass-09
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ ~ ~] [bd:8d [~ bd:8d] ~ ~] [bd:8d ~ ~ bd:8d] [bd:8d ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:tt*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:tt*4]]>").gain(0.42)
// bass
$: note("<[0 0 ~ 0  0 ~ 0 4] [0 0 0 ~  0 4 ~ 0] [0 ~ 0 0  4 0 0 ~] [0 0 ~ 4  0 ~ 2 0] [0 0 0 0  ~ 0 4 0] [0 ~ 0 4  0 0 ~ 2] [0 0 ~ 0  4 ~ 0 0] [0 4 0 ~  0 0 2 0]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("bs:su").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4@3 7@2 9 4 2] [7@2 4 9 7@2 4 2] [4@2 9 7@2 4 2 0] [4@2 7 9 4 2@2 7] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2@2] [4@2 7 9@2 7 4 2] [7 9 4@2 2 0 4 7] [4@2 9 2 0@2 7 4] [9@2 2 4 7 0@2 2] [4 0 7@2 2 4 0 9] [4@2 7 9@2 7 4 2] [4@2 7 9@2 7 4 0] [4@2 7 9@2 7 2@2] [4@2 7 9@2 7 4 2]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 11 ~ 12  ~ 9 ~ 11] [~ 12 ~ 9  ~ 11 ~ 7] [~ 11 ~ 12  ~ 9 ~ 4] [~ 9 ~ 7  ~ 4 ~ 11] [11 ~ 12 9  ~ 11 12 9] [~ 11 ~ 12  9 ~ 11 7] [11 12 ~ 9  11 ~ 12 9] [11 12 9 11  12 9 11 7] [~ 12 ~ 9  ~ 7 ~ 4] [~ 11 ~ 7  ~ 4 ~ 0] [~ 9 ~ 4  ~ 7 ~ 2] [~ 7 ~ 4  ~ 2 ~ 0] [11 ~ 12 9  ~ 11 12 9] [~ 11 ~ 12  9 ~ 11 7] [11 12 ~ 9  11 ~ 12 9] [11 12 9 11  12 9 11 7]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("<[~ 0 ~ ~  ~ ~ ~ ~] [0 ~ ~ ~  ~ 4 ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  ~ ~ 0 ~] [0 ~ ~ ~  ~ ~ 4 ~] [~ ~ ~ 0  ~ ~ ~ ~] [~ 0 ~ 4  ~ ~ ~ ~] [4 ~ ~ ~  ~ 0 ~ ~]>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("vc:pa").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<Eb5:lydian F5:mixolydian D5:phrygian G5:minor Eb5:lydian F5:mixolydian D5:phrygian G5:minor G5:minor D5:phrygian F5:mixolydian Eb5:lydian Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ep:rs").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<Eb3:lydian F3:mixolydian D3:phrygian G3:minor Eb3:lydian F3:mixolydian D3:phrygian G3:minor G3:minor D3:phrygian F3:mixolydian Eb3:lydian Bb2:major A3:locrian G3:minor F3:mixolydian>")
  .s("pf:ga").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<Eb3:lydian F3:mixolydian D3:phrygian G3:minor Eb3:lydian F3:mixolydian D3:phrygian G3:minor G3:minor D3:phrygian F3:mixolydian Eb3:lydian Bb2:major A3:locrian G3:minor F3:mixolydian>")
  .s("ld:cr").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
