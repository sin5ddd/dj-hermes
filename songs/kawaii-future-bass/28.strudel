// @title kawaii-future-bass-28
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd ~ bd ~] [bd ~ ~ ~] [bd ~ bd ~] [bd ~ ~ bd]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh*8, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh*4]]>").gain(0.42)
// bass
$: note("<[0 4 0 0  ~ 0 4 0] [0 0 ~ 4  0 2 0 0] [0 0 4 0  2 ~ 0 4] [0 ~ 0 0  4 0 2 0] [0 0 0 ~  4 0 0 4] [0 4 ~ 0  0 2 ~ 0] [0 0 4 2  0 ~ 0 0] [0 2 0 4  ~ 0 0 2]>")
  .scale("<A4:major E5:mixolydian F#5:minor D5:lydian A4:major E5:mixolydian F#5:minor D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian D5:lydian F#5:minor E5:mixolydian A4:major>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[7@2 4@2 9 4@2 2] [4@2 7 2 9@2 4 7] [4 9@2 7@2 2 4 0] [7@2 4 9 2 0@2 4] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7] [4@2 9 7 11 4@2 2] [4 11@2 7 9 2 0@2] [7@2 11 4 2 0 4 7] [11 7 4 2@2 0 4 9] [4@4 7@2 9 7] [4@4 7@2 9 4] [4@4 7@2 2 7] [4@4 7@2 9 7]>")
  .scale("<A4:major E5:mixolydian F#5:minor D5:lydian A4:major E5:mixolydian F#5:minor D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian D5:lydian F#5:minor E5:mixolydian A4:major>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 9 12 ~  11 9 ~ 12] [9 ~ 11 12  7 ~ 9 11] [~ 12 7 9  11 4 12 ~] [11 9 ~ 7  12 4 ~ 11] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4] [9 ~ 4 12  ~ 7 0 9] [~ 11 7 0  4 ~ 9 2] [12 4 ~ 7  0 2 4 ~] [~ 7 0 4  2 9 4 0] [9 12 11 9  ~ 12 11 7] [11 9 12 ~  9 11 7 12] [12 11 ~ 9  12 7 11 9] [11 12 9 11  7 12 9 4]>")
  .scale("<A4:major E5:mixolydian F#5:minor D5:lydian A4:major E5:mixolydian F#5:minor D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian D5:lydian F#5:minor E5:mixolydian A4:major>")
  .s("plk:ch").gain(0.18).cut(1)
// arp
$: note("<[~ 0 ~ 4  ~ ~ ~ ~] [~ ~ ~ 0  ~ ~ ~ ~] [0 ~ ~ ~  ~ 4 ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 4 ~ ~  ~ ~ ~ ~] [0 ~ ~ ~  ~ ~ 0 ~] [~ ~ 4 ~  ~ 0 ~ ~] [~ 0 ~ ~  ~ ~ 4 ~]>")
  .scale("<A4:major E5:mixolydian F#5:minor D5:lydian A4:major E5:mixolydian F#5:minor D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian D5:lydian F#5:minor E5:mixolydian A4:major>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<A4:major E5:mixolydian F#5:minor D5:lydian A4:major E5:mixolydian F#5:minor D5:lydian A4:major Ab5:locrian F#5:minor E5:mixolydian D5:lydian F#5:minor E5:mixolydian A4:major>")
  .s("ep:pd").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<A2:major E3:mixolydian F#3:minor D3:lydian A2:major E3:mixolydian F#3:minor D3:lydian A2:major Ab3:locrian F#3:minor E3:mixolydian D3:lydian F#3:minor E3:mixolydian A2:major>")
  .s("ps:gb").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<A2:major E3:mixolydian F#3:minor D3:lydian A2:major E3:mixolydian F#3:minor D3:lydian A2:major Ab3:locrian F#3:minor E3:mixolydian D3:lydian F#3:minor E3:mixolydian A2:major>")
  .s("pf:ca").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
