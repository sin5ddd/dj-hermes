// @title kawaii-future-bass-19
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8d ~ [bd:8d ~] ~] [bd:8d ~ ~ ~] [bd:8d [~ bd:8d] ~ ~] [bd:8d ~ ~ bd:8d]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh:ch*8, <~ ~ ~ oh ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~>, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]]>").gain(0.42)
// bass
$: note("<[0 ~ 0 0  4 0 ~ 0] [0 0 4 0  0 ~ 4 0] [0 4 ~ 0  0 0 2 ~] [0 0 0 4  ~ 2 0 0] [0 4 0 ~  0 0 4 0] [0 0 ~ 4  2 0 0 ~] [0 ~ 4 0  0 4 0 2] [0 0 2 0  4 ~ 0 0]>")
  .scale("<G5:minor Eb5:lydian F5:mixolydian Bb4:major G5:minor Eb5:lydian F5:mixolydian Bb4:major Bb4:major F5:mixolydian Eb5:lydian G5:minor Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[9@3 4@2 7 9 2] [9@2 7 4@2 2 4 7] [7@2 9 4 2@2 7 4] [4@2 7 9@2 4 2 0] [4 7@2 9 7@2 4 2] [4 7@2 9 7@2 4 0] [4 7@2 9 7@2 2@2] [4 7@2 9 7@2 4 2] [9 7@2 4 2@2 0 4] [7@2 4 2 0 4@2 7] [4 2 0@2 7 4 2 0] [2@2 4 7 0 4@2 2] [4 7@2 9 7@2 4 2] [4 7@2 9 7@2 4 0] [4 7@2 9 7@2 2@2] [4 7@2 9 7@2 4 2]>")
  .scale("<G5:minor Eb5:lydian F5:mixolydian Bb4:major G5:minor Eb5:lydian F5:mixolydian Bb4:major Bb4:major F5:mixolydian Eb5:lydian G5:minor Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[11 ~ ~ 12  9 ~ 11 7] [~ 12 11 ~  9 12 ~ 4] [12 9 ~ 11  ~ 7 9 12] [~ 9 11 4  12 7 ~ 9] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12] [~ 12 4 ~  9 7 ~ 0] [12 7 ~ 4  ~ 0 11 7] [~ 4 9 0  7 ~ 2 11] [4 ~ 7 2  0 9 ~ 4] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12]>")
  .scale("<G5:minor Eb5:lydian F5:mixolydian Bb4:major G5:minor Eb5:lydian F5:mixolydian Bb4:major Bb4:major F5:mixolydian Eb5:lydian G5:minor Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("plk:ch").gain(0.18).cut(1)
// arp
$: note("<[~ ~ 0 ~  ~ ~ ~ ~] [~ 0 ~ ~  ~ ~ 4 ~] [0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 4 ~  ~ ~ 0 ~] [~ 0 ~ ~  ~ ~ ~ 4] [4 ~ ~ ~  ~ ~ 0 ~] [~ ~ ~ 0  ~ ~ ~ ~] [0 ~ 4 ~  ~ ~ ~ ~]>")
  .scale("<G5:minor Eb5:lydian F5:mixolydian Bb4:major G5:minor Eb5:lydian F5:mixolydian Bb4:major Bb4:major F5:mixolydian Eb5:lydian G5:minor Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<G5:minor Eb5:lydian F5:mixolydian Bb4:major G5:minor Eb5:lydian F5:mixolydian Bb4:major Bb4:major F5:mixolydian Eb5:lydian G5:minor Bb4:major A5:locrian G5:minor F5:mixolydian>")
  .s("ep:pd").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<G3:minor Eb3:lydian F3:mixolydian Bb2:major G3:minor Eb3:lydian F3:mixolydian Bb2:major Bb2:major F3:mixolydian Eb3:lydian G3:minor Bb2:major A3:locrian G3:minor F3:mixolydian>")
  .s("pf:ga").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<G3:minor Eb3:lydian F3:mixolydian Bb2:major G3:minor Eb3:lydian F3:mixolydian Bb2:major Bb2:major F3:mixolydian Eb3:lydian G3:minor Bb2:major A3:locrian G3:minor F3:mixolydian>")
  .s("pf:hl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
