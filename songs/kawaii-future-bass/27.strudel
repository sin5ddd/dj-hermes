// @title kawaii-future-bass-27
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd ~ [bd ~] ~] [bd ~ ~ ~] [bd [~ bd] ~ ~] [bd ~ ~ bd]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, hh*8, <~ ~ ~ oh ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~>, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh*4]]>").gain(0.42)
// bass
$: note("<[0 ~ 0 0  4 0 ~ 0] [0 0 4 0  0 ~ 4 0] [0 4 ~ 0  0 0 2 ~] [0 0 0 4  ~ 2 0 0] [0 4 0 ~  0 0 4 0] [0 0 ~ 4  2 0 0 ~] [0 ~ 4 0  0 4 0 2] [0 0 2 0  4 ~ 0 0]>")
  .scale("<Ab4:major Eb5:mixolydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian C#5:lydian F5:minor Eb5:mixolydian Ab4:major Ab4:major G5:locrian F5:minor Eb5:mixolydian>")
  .s("bs:su").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[~ 9 ~ 4  ~ 7 9 2] [9 ~ 7 4  ~ 2 4 7] [~ 7 9 4  2 ~ 7 4] [4 ~ 7 9  ~ 4 2 0] [4 7 ~ 9  7@2 4 2] [4 7 ~ 9  7@2 4 0] [4 7 ~ 9  7@2 2 ~] [4 7 ~ 9  7@2 4 2] [9 7 ~ 4  2 ~ 0 4] [~ 7 4 2  0 4 ~ 7] [4 2 0 ~  7 4 2 0] [~ 2 4 7  0 4 ~ 2] [4 7 ~ 9  7@2 4 2] [4 7 ~ 9  7@2 4 0] [4 7 ~ 9  7@2 2 ~] [4 7 ~ 9  7@2 4 2]>")
  .scale("<Ab4:major Eb5:mixolydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian C#5:lydian F5:minor Eb5:mixolydian Ab4:major Ab4:major G5:locrian F5:minor Eb5:mixolydian>")
  .s("ld:cy").gain(0.16).cut(1)
// hook
$: note("<[11 ~ ~ 12  9 ~ 11 7] [~ 12 11 ~  9 12 ~ 4] [12 9 ~ 11  ~ 7 9 12] [~ 9 11 4  12 7 ~ 9] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12] [~ 12 4 ~  9 7 ~ 0] [12 7 ~ 4  ~ 0 11 7] [~ 4 9 0  7 ~ 2 11] [4 ~ 7 2  0 9 ~ 4] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12]>")
  .scale("<Ab4:major Eb5:mixolydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian C#5:lydian F5:minor Eb5:mixolydian Ab4:major Ab4:major G5:locrian F5:minor Eb5:mixolydian>")
  .s("plk:ch").gain(0.18).cut(1)
// arp
$: note("<[4 0 ~ 7  ~ 9 4 0] [0 7 4 ~  12 ~ 4 7] [7 ~ 0 4  9 4 7 ~] [4 12 0 7  ~ 4 0 9] [0 4 9 ~  7 0 4 12] [~ 9 4 0  7 12 ~ 4] [4 7 0 9  ~ 0 4 7] [12 4 ~ 0  7 4 9 0]>")
  .scale("<Ab5:major Eb6:mixolydian F6:minor C#6:lydian Ab5:major Eb6:mixolydian F6:minor C#6:lydian C#6:lydian F6:minor Eb6:mixolydian Ab5:major Ab5:major G6:locrian F6:minor Eb6:mixolydian>")
  .s("plk:fg").gain(0.12).cut(1)
// chords
$: note("<[[0,4,8] [0,4,8] ~ ~  ~ [0,2,8] ~ [0,4,8]] [[0,2,8] ~ [0,4,8] [0,4,8]  ~ ~ [0,2,8] ~] [[0,4,8] ~ ~ [0,2,8]  [0,4,8] ~ ~ [0,4,8]] [[0,2,8] [0,4,8] ~ [0,4,8]  ~ [0,2,8] ~ ~]>")
  .scale("<Ab4:major Eb5:mixolydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian C#5:lydian F5:minor Eb5:mixolydian Ab4:major Ab4:major G5:locrian F5:minor Eb5:mixolydian>")
  .s("plk:sm").gain(0.2).orbit(2)
// pad
$: note("<0 ~ 0 ~ ~ ~ 0 ~ ~ 0 ~ ~ 0 ~ ~ ~>").scale("<Ab4:major Eb5:mixolydian F5:minor C#5:lydian Ab4:major Eb5:mixolydian F5:minor C#5:lydian C#5:lydian F5:minor Eb5:mixolydian Ab4:major Ab4:major G5:locrian F5:minor Eb5:mixolydian>")
