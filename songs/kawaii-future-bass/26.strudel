// @title kawaii-future-bass-26
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd ~ ~ ~] [bd ~ ~ ~] [bd [~ bd] ~ ~] [bd ~ ~ ~]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd ~, [~ hh]*4").gain(0.42)
// bass
$: note("<[0 0 0 4  0 ~ 0 0] [0 ~ 4 0  0 0 4 ~] [0 4 0 0  ~ 0 2 0] [0 0 ~ 0  4 0 0 2] [0 0 4 ~  0 0 0 4] [0 4 0 0  2 ~ 0 0] [0 ~ 0 4  0 4 ~ 0] [0 0 0 2  0 4 0 ~]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("bs:8s").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[4@3 7@2 9 7 4] [7@2 4 9 7@2 4 2] [4@2 9 7@2 4 2 0] [4@2 7 9 4 7@2 11] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4] [9@2 4 7@2 2 0 4] [7@2 9 2 4 0@2 7] [4@2 2 0@2 7 4 2] [2@2 0 4 7 4 9 0] [9@2 7 4@2 2 0 4] [9@2 7 4@2 2 0 2] [9@2 7 4@2 2@2 4] [9@2 7 4@2 2 0 4]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[~ 12 ~ 11  ~ 7 ~ 9] [12 ~ 9 11  ~ 4 ~ 12] [~ 11 9 12  ~ 7 4 9] [9 ~ 12 7  ~ 11 4 0] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4] [~ 9 ~ 12  ~ 4 ~ 7] [11 ~ 4 0  ~ 7 ~ 9] [~ 7 12 4  0 ~ 2 4] [9 4 ~ 0  2 7 ~ 4] [12 11 9 12  11 9 7 11] [~ 12 9 11  7 ~ 12 9] [11 ~ 12 7  9 12 11 9] [12 9 11 12  9 7 11 4]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("plk:mx").gain(0.18).cut(1)
// arp
$: note("<[0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ 4] [~ 0 ~ ~  ~ ~ ~ ~] [~ ~ ~ 4  ~ 0 ~ ~] [0 ~ ~ 4  ~ ~ ~ ~] [~ ~ 0 ~  ~ ~ ~ ~] [~ 4 ~ ~  0 ~ ~ ~] [~ ~ ~ 0  ~ 4 ~ ~]>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("vc:na").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<G4:major D5:mixolydian E5:minor C5:lydian G4:major D5:mixolydian E5:minor C5:lydian C5:lydian E5:minor D5:mixolydian G4:major G4:major F#5:locrian E5:minor D5:mixolydian>")
  .s("ep:ky").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<G2:major D3:mixolydian E3:minor C3:lydian G2:major D3:mixolydian E3:minor C3:lydian C3:lydian E3:minor D3:mixolydian G2:major G2:major F#3:locrian E3:minor D3:mixolydian>")
  .s("ps:mx").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<G2:major D3:mixolydian E3:minor C3:lydian G2:major D3:mixolydian E3:minor C3:lydian C3:lydian E3:minor D3:mixolydian G2:major G2:major F#3:locrian E3:minor D3:mixolydian>")
  .s("pf:wm").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
// vox
$: s("<~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [iv:moi iv:kai]>").gain(0.5).cut(1)
