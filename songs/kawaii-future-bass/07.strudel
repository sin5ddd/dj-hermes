// @title kawaii-future-bass-07
// @genre kawaii-future-bass
setcpm(140/4)
// kick
$: s("<[bd:8t ~ [bd:8t ~] ~] [bd:8t ~ ~ ~] [bd:8t [~ bd:8t] ~ ~] [bd:8t ~ ~ bd:8t]>").gain(0.85).duckorbit(2).duckattack(0.05).duckdepth(0.8)
// hats
$: s("~ ~ sd:tr ~, hh:ch*8, <~ ~ ~ oh ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~>, <~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]] ~ ~ ~ ~ ~ ~ ~ [~ ~ ~ ~ ~ ~ ~ [hh:ch*4]]>").gain(0.42)
// bass
$: note("<[0 0 0 0  4 ~ 0 4] [0 4 0 ~  0 0 2 0] [0 ~ 4 0  0 2 0 4] [0 0 2 4  0 ~ 0 0] [0 4 0 0  2 0 ~ 4] [0 0 ~ 2  0 4 0 0] [0 2 4 0  ~ 0 0 4] [0 0 4 2  0 0 ~ 0]>")
  .scale("<C#5:lydian Eb5:mixolydian C5:phrygian F5:minor C#5:lydian Eb5:mixolydian C5:phrygian F5:minor Ab4:major G5:locrian F5:minor Eb5:mixolydian F5:minor C5:phrygian Eb5:mixolydian C#5:lydian>")
  .s("bs:ht").gain(0.4).cut(1).orbit(2)
// lead
$: note("<[7@3 11@2 9 7 4] [11@2 7 4 9@2 4 2] [4@2 7 11 7 4@2 0] [7@2 9 4@2 2 7 4] [4 7@2 9 7@2 4 2] [4 7@2 9 7@2 4 0] [4 7@2 9 7@2 2@2] [4 7@2 9 7@2 4 2] [2 4 7 9@2 4 2 0] [9@2 4 2 7 0@2 4] [4 2@2 9 0 4 7 2] [0@2 4 2 7 9 4@2] [4 7@2 9 7@2 4 2] [4 7@2 9 7@2 4 0] [4 7@2 9 7@2 2@2] [4 7@2 9 7@2 4 2]>")
  .scale("<C#5:lydian Eb5:mixolydian C5:phrygian F5:minor C#5:lydian Eb5:mixolydian C5:phrygian F5:minor Ab4:major G5:locrian F5:minor Eb5:mixolydian F5:minor C5:phrygian Eb5:mixolydian C#5:lydian>")
  .s("ld:ss").adsr("0.01:0.3:0.7:0.2").cut(1).gain(0.16)
// hook
$: note("<[11 ~ ~ 12  9 ~ 11 7] [~ 12 11 ~  9 12 ~ 4] [12 9 ~ 11  ~ 7 9 12] [~ 9 11 4  12 7 ~ 9] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12] [~ 12 4 ~  9 7 ~ 0] [12 7 ~ 4  ~ 0 11 7] [~ 4 9 0  7 ~ 2 11] [4 ~ 7 2  0 9 ~ 4] [11 12 11 9  12 11 9 7] [12 ~ 11 12  9 7 11 9] [~ 11 12 9  11 12 7 12] [9 11 12 9  11 7 4 12]>")
  .scale("<C#5:lydian Eb5:mixolydian C5:phrygian F5:minor C#5:lydian Eb5:mixolydian C5:phrygian F5:minor Ab4:major G5:locrian F5:minor Eb5:mixolydian F5:minor C5:phrygian Eb5:mixolydian C#5:lydian>")
  .s("plk:mb").gain(0.18).cut(1)
// arp
$: note("<[~ ~ 0 ~  ~ ~ ~ ~] [~ 0 ~ ~  ~ ~ 4 ~] [0 ~ ~ ~  ~ ~ ~ ~] [~ ~ 4 ~  ~ ~ 0 ~] [~ 0 ~ ~  ~ ~ ~ 4] [4 ~ ~ ~  ~ ~ 0 ~] [~ ~ ~ 0  ~ ~ ~ ~] [0 ~ 4 ~  ~ ~ ~ ~]>")
  .scale("<C#5:lydian Eb5:mixolydian C5:phrygian F5:minor C#5:lydian Eb5:mixolydian C5:phrygian F5:minor Ab4:major G5:locrian F5:minor Eb5:mixolydian F5:minor C5:phrygian Eb5:mixolydian C#5:lydian>")
  .s("vc:ya").gain(0.14).cut(1)
// chords
$: note("<[0,4,8]@8 [0,2,8]@8 [0,4,8]@8 [0,4,8]@8>")
  .scale("<C#5:lydian Eb5:mixolydian C5:phrygian F5:minor C#5:lydian Eb5:mixolydian C5:phrygian F5:minor Ab4:major G5:locrian F5:minor Eb5:mixolydian F5:minor C5:phrygian Eb5:mixolydian C#5:lydian>")
  .s("ep:pd").adsr("0.02:0.3:0.6:0.4").gain(0.24).orbit(2)
// pad
$: note("0").scale("<C#3:lydian Eb3:mixolydian C3:phrygian F3:minor C#3:lydian Eb3:mixolydian C3:phrygian F3:minor Ab2:major G3:locrian F3:minor Eb3:mixolydian F3:minor C3:phrygian Eb3:mixolydian C#3:lydian>")
  .s("pf:ga").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.16).room(0.35).orbit(2)
// strings
$: note("<[~@2 0@6]>").scale("<C#3:lydian Eb3:mixolydian C3:phrygian F3:minor C#3:lydian Eb3:mixolydian C3:phrygian F3:minor Ab2:major G3:locrian F3:minor Eb3:mixolydian F3:minor C3:phrygian Eb3:mixolydian C#3:lydian>")
  .s("pf:hl").adsr("0.2:0.4:0.5:0.4").cut(1).gain(0.12).room(0.45).orbit(2)
// vox
$: s("<~ ~ ~ ~ [iv:hai iv:dou iv:zo] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~>").gain(0.5).cut(1)
