// @title electro-05
// @genre electro
// @details zap kick, live FM bass + plk:lp @ 126
setcpm(126/4)
// drums
$: s("bd:ez*4, [~ sd:pi]*2, hh:ch*8").gain(0.5)
// bass
$: note("0 0 3 0 2 5 0 4").scale("C2:minor").s("sine").fm(3).fmh(2).lpf(640).gain(0.42)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.04)
// lead
$: note("7 4 0 2").scale("C4:minor").s("plk:lp").gain(0.22).cut(1)
