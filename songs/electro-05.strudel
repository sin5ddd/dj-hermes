// @title electro-05
// @genre electro
// @details four-on-the-floor + C4 plk:lp hook @ 126
setcpm(126/4)
// drums
$: s("bd:hf*4, [~ sd:hd]*2, hh:hs*8").gain(0.56)
// bass
$: note("0 ~ 0 2").scale("C2:minor").s("square").lpf(520).gain(0.46)
  .attack(0.001).decay(0.08).sustain(0.18).release(0.04)
// pluck
$: note("4 ~ 7 4 2 0 ~ -1").scale("C4:minor").s("plk:lp").gain(0.28).cut(1)
