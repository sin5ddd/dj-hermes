// @title ambient-05
// @genre ambient
// @details thud kick + dark Reese + close organ pad
setcpm(70/4)
// drums
$: s("bd:tc ~ ~ ~, [~ hh]*2").gain(0.22)
// bass
$: note("0 ~ 3 ~").scale("C4:minor").s("bs:rd").gain(0.3)
// pad
$: note("<[0,2,4] [2,4,7]>/2").scale("C3:minor").s("wt_organ").lpf(1000).gain(0.32)
  .attack(0.25).decay(0.3).sustain(0.7).release(0.55).room(0.45).orbit(1)
