// @title dnb-06
// @genre drum and bass
// @details sparse drop, amen-sub + saw mid @ 174
setcpm(174/4)
// drums
$: s("[bd:dn ~ ~ sd:dn ~ ~ ~ sd:dn, [~ hh:dk]*2]*2").gain(0.66).lpf(3000)
// bass
$: note("0 ~ 0 ~").scale("C4:minor").s("bs:am").gain(0.46)
// lead
$: note("0 5 0 -1").scale("C2:minor").s("sawtooth").lpf(850).gain(0.32)
  .attack(0.01).decay(0.4).release(0.3)
