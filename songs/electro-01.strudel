// @title electro-01
// @genre electro
// @details zap kick, short square + saw stab @ 126
setcpm(126/4)
// drums
$: s("bd:ez*4, [~ sd:8s]*2, hh:tt*8").gain(0.54)
// bass
$: note("0 0 3 0 <2 5> 0 4 0").scale("C2:minor").s("square").lpf(700).gain(0.46)
  .attack(0.001).decay(0.08).sustain(0.2).release(0.04)
// lead
$: note("~ ~ 7 ~").scale("C4:minor").s("sawtooth").lpf(1800).gain(0.16)
