// @title pump-drop
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.92).duckorbit(2).duckattack(0.05).duckdepth(0.9)
// hats
$: s("[~ hh]*4").gain(0.42)
// bass
$: note("0 0 2 <4 7>").scale("C2:minor")
  .s("sine").fm(3.5).fmh(1).fmdec(0.22).fmsus(0.2).lpf(520).gain(0.55)
  .attack(0.004).decay(0.08).sustain(0.28).release(0.06)
  .orbit(2)
// pad
$: note("0 2 4 7").scale("C3:dorian")
  .s("sawtooth").lpf(1100).orbit(2).gain(0.34)
  .attack(0.04).decay(0.18).sustain(0.58).release(0.16)
