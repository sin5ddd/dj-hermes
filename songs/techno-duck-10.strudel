// @title floor-drop
// @genre techno-duck
setcpm(126/4)
// kick
$: s("bd:tc*4").gain(0.9).duckorbit(2).duckattack(0.035).duckdepth(0.9)
// hats
$: s("[~ hh]*4").gain(0.4)
// bass
$: note("0 0 2 7").scale("C2:minor")
  .s("sawtooth").fm(3.2).fmh(1).fmdec(0.22).fmsus(0.2).lpf(480).gain(0.48)
  .orbit(2)
// pad
$: note("0 2 4 0").scale("C3:minor")
  .s("sawtooth").lpf(1000).orbit(2).gain(0.28)
  .attack(0.04).sustain(0.58).release(0.16)
