// @title chill-04
// @genre chill
// @details bright major: open saw + spread plk:lp (no cut on chords)
setcpm(100/4)
// drums
$: s("bd ~ ~ ~, [~ hh]*4").gain(0.42)
// bass
$: note("0 ~ 4 ~").scale("C3:major").s("sawtooth").lpf(900).gain(0.4)
// chords
$: note("[0,4,9] ~ [0,4,9] ~").scale("C4:major").s("plk:lp").gain(0.28)
