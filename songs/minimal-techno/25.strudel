// @title minimal-techno-25
// @genre minimal-techno
setcpm(126/4)
// drums
$: s("bd:tc*4, <[~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 [~ oh]*4 ~ ~ ~ ~>, <~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp>").gain(0.7)
// bass
$: note("<~ ~ ~ ~ [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~]>").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("bs:ht").gain(0.4)
// lead
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] ~ ~ ~ ~>").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:pk").gain(0.1).cut(1)
// hook
$: note("<~ ~ ~ ~ [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] ~ ~ [~ 4 ~ ~] [~ 4 ~ ~]>").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:ac").gain(0.12).cut(1)
// arp
$: s("<~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ ~ ~ perc:st>").gain(0.12)
// chords
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] ~ ~>").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:sf").gain(0.14)
// pad
$: note("<~ ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("pf:pu").orbit(2).cut(1).gain(0.1).room(0.25)
// fx
$: s("<~ ~ ~ fx:nh ~ ~ fx:ry ~ fx:mc ~ ~ ~ fx:sd ~ ~ fx:dn>").gain(0.18).cut(1)
