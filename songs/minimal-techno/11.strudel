// @title minimal-techno-11
// @genre minimal-techno
setcpm(126/4)
// drums
$: s("bd*4, <[~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2 ~ ~ [~ oh:op ~ ~]*2 [~ oh:op ~ ~]*2>, <~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp>").gain(0.7)
// bass
$: note("<~ ~ ~ ~ [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~]>").scale("<C4:minor C4:minor C4:minor G4:phrygian>")
  .s("bs:ht").gain(0.4)
// lead
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] ~ ~ ~ ~>").scale("<C4:minor C4:minor C4:minor G4:phrygian>")
  .s("plk:pk").gain(0.1).cut(1)
// hook
$: note("<~ ~ ~ ~ [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] ~ ~ [~ 4 ~ ~] [~ 4 ~ ~]>").scale("<C4:minor C4:minor C4:minor G4:phrygian>")
  .s("plk:ac").gain(0.12).cut(1)
// arp
$: s("<~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ ~ ~ perc:st>").gain(0.12)
// chords
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] ~ ~>").scale("<C4:minor C4:minor C4:minor G4:phrygian>")
  .s("plk:sf").gain(0.14)
// pad
$: note("<~ ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<C4:minor C4:minor C4:minor G4:phrygian>")
  .s("pf:cs").orbit(2).cut(1).gain(0.1).room(0.25)
// fx
$: s("<~ ~ ~ fx:ck ~ ~ fx:rl ~ fx:ha ~ ~ ~ fx:sd ~ ~ fx:wh>").gain(0.18).cut(1)
