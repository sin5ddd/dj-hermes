// @title minimal-techno-23
// @genre minimal-techno
setcpm(126/4)
// drums
$: s("bd*4, <hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 hh:tt*8 ~ ~ ~ ~>, <~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp ~ ~ ~ cp>").gain(0.7)
// bass
$: note("<~ ~ ~ ~ [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~] [0 ~ 3 ~]>").scale("<Eb4:minor Eb4:minor Eb4:minor Bb4:phrygian>")
  .s("bs:ht").gain(0.4)
// lead
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] [~ ~ 7 ~] ~ ~ ~ ~>").scale("<Eb4:minor Eb4:minor Eb4:minor Bb4:phrygian>")
  .s("plk:pk").gain(0.1).cut(1)
// hook
$: note("<~ ~ ~ ~ [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] [~ 4 ~ ~] ~ ~ [~ 4 ~ ~] [~ 4 ~ ~]>").scale("<Eb4:minor Eb4:minor Eb4:minor Bb4:phrygian>")
  .s("plk:ac").gain(0.12).cut(1)
// arp
$: s("<~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ perc:st ~ perc:tk ~ ~ ~ perc:st>").gain(0.12)
// chords
$: note("<~ ~ ~ ~ ~ ~ ~ ~ [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] [~ [0,2,4] ~ ~] ~ ~>").scale("<Eb4:minor Eb4:minor Eb4:minor Bb4:phrygian>")
  .s("plk:sf").gain(0.14)
// pad
$: note("<~ ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~>").scale("<Eb4:minor Eb4:minor Eb4:minor Bb4:phrygian>")
  .s("pf:cs").orbit(2).cut(1).gain(0.1).room(0.25)
// fx
$: s("<~ ~ ~ fx:ck ~ ~ fx:rl ~ fx:ha ~ ~ ~ fx:sd ~ ~ fx:wh>").gain(0.18).cut(1)
