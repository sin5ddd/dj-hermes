// @title minimal-techno-15
// @genre minimal-techno
setcpm(126/4)
// drums
$: s("bd:tc*4, hh:tt*4, <~ ~ ~ cp>").gain(0.7)
// bass
$: note("0 ~ 3 ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("bs:ht").gain(0.4)
// lead
$: note("~ ~ 7 ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:pk").gain(0.1).cut(1)
// hook
$: note("~ 4 ~ ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:ac").gain(0.12).cut(1)
// arp
$: s("<~ perc:st ~ perc:tk>").gain(0.12)
// chords
$: note("~ [0,2,4] ~ ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:sf").gain(0.14)
// pad
$: note("0").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("pf:ff").orbit(2).gain(0.1).room(0.25)
