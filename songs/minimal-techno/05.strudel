// @title minimal-techno-05
// @genre minimal-techno
setcpm(126/4)
// drums
$: s("bd*4, hh*8, <~ ~ ~ cp>").gain(0.7)
// bass
$: note("0 ~ 3 ~").scale("<F2:minor F2:minor F2:minor C3:phrygian>")
  .s("sawtooth").lpf(320).gain(0.4)
// lead
$: note("~ ~ 7 ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("square").lpf(2000).gain(0.1)
// hook
$: note("~ 4 ~ ~").scale("<F4:minor F4:minor F4:minor C5:phrygian>")
  .s("plk:ac").gain(0.12).cut(1)
// arp
$: s("<~ perc:tk ~ perc:st>").gain(0.12)
// chords
$: note("~ [0,2,4] ~ ~").scale("<F3:minor F3:minor F3:minor C4:phrygian>")
  .s("triangle").lpf(1100).gain(0.14)
// pad
$: note("[0,4]").scale("<F3:minor F3:minor F3:minor C4:phrygian>")
  .s("sine").lpf(600).orbit(2).gain(0.1)
  .attack(0.12).release(0.4)
