// @title dubstep-07
// @genre dubstep
// @details riddim-sparse: late snare, square basement only @ 140
setcpm(140/4)
// drums
$: s("bd:8t ~ ~ ~, [~ ~ ~ sd:rm]").gain(0.6)
// sub
$: note("0 ~ ~ ~").scale("C2:minor").s("square").lpf(100).gain(0.48)
  .attack(0.01).decay(0.4).sustain(0.3).release(0.2)
// tick
$: s("[~ hh:tt]*2").gain(0.16).hpf(9000)
