// @title dust-hour
// @by strudel-rs
// @details dusty kick, crackle, marimba rests @ 96
setcpm(96/4)
// drums
$: s("bd:lf ~ ~ ~, perc:tk*8, [~ tom:md ~ ~]").gain(0.34)
// keys
$: note("[0,2,4] ~ ~ [2,4]").scale("C4:mixolydian").s("ep:wr").gain(0.16)
  .attack(0.008).decay(0.28).sustain(0.18).release(0.24).room(0.28).orbit(1)
// lead
$: note("~ 2 ~ 0  ~ 4 ~ <6 2>").scale("C4:mixolydian").s("plk:mm").gain(0.18).cut(1)
// fx
$: s("<fx:ck ~ ~ ~>").gain(0.16)
