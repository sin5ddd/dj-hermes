// @title strike-four
// @by strudel-rs
// @details tick+click grid, tom on 4, wurli stabs @ 96
setcpm(96/4)
// drums
$: s("bd:lf ~ ~ ~, [perc:tk perc:fk]*4, ~ ~ ~ tom:lo").gain(0.36)
// keys
$: note("[0,2,4] ~ [4,6] ~").scale("C4:mixolydian").s("ep:wr").gain(0.16)
  .attack(0.005).decay(0.2).sustain(0.15).release(0.2).room(0.2).orbit(1)
// lead
$: note("7 4 2 0  2 4 <6 7> 4").scale("C4:mixolydian").s("plk:mm").gain(0.18).cut(1)
// fx
$: s("<~ ~ ~ fx:ts>").gain(0.2)
