// @title mainspring
// @by strudel-rs
// @details industrial ticks, lo tom pulse, sparse marimba @ 96
setcpm(96/4)
// drums
$: s("bd:lf ~ ~ ~, perc:ti*8, tom:lo ~ ~ tom:lo").gain(0.36)
// keys
$: note("0 ~ [0,2,4] ~").scale("C4:mixolydian").s("ep:wr").gain(0.16)
  .attack(0.005).decay(0.3).sustain(0.18).release(0.25).room(0.22).orbit(1)
// lead
$: note("4 ~ ~ 2  ~ 0 <6 4> ~").scale("C4:mixolydian").s("plk:mm").gain(0.2).cut(1)
// fx
$: s("<~ fx:ts ~ ~>").gain(0.18)
