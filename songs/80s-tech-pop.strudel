// @title 80s-tech-pop
// @genre acid, techno, pop
// @details short live acid-pop loop @ 130 BPM (scalar scale only)
setcpm(130/4)

// drums
$: s("bd*4, [~ hh]*4, [~ sd]*2").gain(0.5)

// acid line — degrees; change .scale live for key color
$: note("0 <2 4> 3 4 2 3 0 [<-1 3> <2 -2>]")
  .scale("<A2:minor D:dorian G:mixolydian C:major>")
  .s("sawtooth").lpf(800).lpq(16).gain(0.5)
  .attack(0.001).decay(0.15).sustain(0.05).release(0.05)

// sparse stab
$: note("~ ~ 7@4 <5 -2> 3")
  .scale("<A2:minor D:dorian G:mixolydian C:major>")
  .s("square").lpf(1800).gain(0.12)
