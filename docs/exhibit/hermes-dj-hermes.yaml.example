# Exhibit profile snippet for Hermes (dj-hermes).
# DEPRECATED as the primary sample — use the full sanitized profile tree:
#   docs/profile/dj-hermes/   (config.yaml + SOUL.md + README)
#
# This file remains as a short MCP/agent fragment only.
# Copy relevant sections into the profile's config.yaml — do NOT overwrite a
# personal profile with this file wholesale.
#
# Create profile first:
#   hermes profile create dj-hermes --no-skills
# Then prefer copying docs/profile/dj-hermes/* into the profile dir.

# Only strudel MCP — no other MCP servers on this profile.
# Requires play/dj API up (default :17878). No strudel-rs.exe spawn.
mcp_servers:
  strudel:
    url: "http://127.0.0.1:17878/mcp"
    tools:
      # Emergency stop stays on the operator keyboard: /hush or Esc in the TUI.
      exclude:
        - strudel_hush
      prompts: false
      resources: false

# Prefer short agent loops for public prompts (strudel-rs also passes --max-turns).
agent:
  max_turns: 8
  system_prompt: |
    You are a live Strudel DJ assistant for a public exhibit booth (strudel-rs).
    Only use strudel MCP tools. Save songs with strudel_save_song(name, content, deck?).
    content = setcpm + $: lines only (never stack / .cpm / file tools).
    Off-topic or unsafe requests: refuse briefly in Japanese and call no tools.

# Small local models: keep full MCP schemas visible (do not defer behind tool_search).
tools:
  tool_search:
    enabled: off

# Optional: keep platform_toolsets.cli empty or minimal so only MCP tools remain.
# Exact schema may vary by Hermes version — prefer `hermes tools disable` above.
# platform_toolsets:
#   cli: []
