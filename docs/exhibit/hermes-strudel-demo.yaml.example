# Exhibit profile snippet for Hermes (strudel-demo).
# DEPRECATED as the primary sample — use the full sanitized profile tree:
#   docs/profile/strudel-demo/   (config.yaml + SOUL.md + README)
#
# This file remains as a short MCP/agent fragment only.
# Copy relevant sections into the profile's config.yaml — do NOT overwrite a
# personal profile with this file wholesale.
#
# Create profile first:
#   hermes profile create strudel-demo --no-skills
# Then prefer copying docs/profile/strudel-demo/* into the profile dir.

# Only strudel MCP — no other MCP servers on this profile.
mcp_servers:
  strudel:
    command: strudel-rs
    # Windows example:
    # command: "C:\\Users\\you\\.cargo\\bin\\strudel-rs.exe"
    args: ["mcp"]
    env:
      STRUDEL_API: "http://127.0.0.1:17878"
    tools:
      # Emergency stop stays on the operator keyboard: /hush or Esc in the TUI.
      exclude:
        - strudel_hush
      prompts: false
      resources: false

# Prefer short agent loops for public prompts (strudel-rs also passes --max-turns).
agent:
  max_turns: 8
  system_prompt: |
    You are a live Strudel DJ assistant for a public exhibit booth.
    Only use strudel MCP tools. Never use shell, files, browser, or web.
    Off-topic or unsafe requests: refuse briefly in Japanese and call no tools.

# Optional: keep platform_toolsets.cli empty or minimal so only MCP tools remain.
# Exact schema may vary by Hermes version — prefer `hermes tools disable` above.
# platform_toolsets:
#   cli: []
